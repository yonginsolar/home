                        depAmount: desired,
                        date: dateStr,
                        description: isInitialPost ? descBase : `${descBase} [정정재기표]`,
                        transId: postTransId,
                        project: asset.project || '본사',
                        operator: writer
                    });
                    if (isInitialPost) newCount += 1;
                    else correctionCount += 1;
                } else if (current !== 0) {
                    correctionCount += 1;
                }
            });

            if (entries.length === 0) {
                if (legacyUnmatchedCount > 0) {
                    return showAlert("알림", `변경 내역은 없지만 레거시 자산명 불일치 ${legacyUnmatchedCount}건이 있어 자동정정 대상에서 제외되었습니다.`);
                }
                return showAlert("알림", "변경된 감가상각 내역이 없습니다.");
            }

            const { error: insertError } = await _supabase.from('ac_journal').insert(entries);
            if (insertError) return showAlert("오류", "저장 중 문제가 발생했습니다: " + insertError.message);

            setLastAutoSyncUndo({
                type: 'depreciation',
                label: `${thisYear} 감가상각`,
                created_at: new Date().toISOString(),
                trans_ids: collectTransIds(entries),
                restores: []
            });

            const baseMsg = `신규 ${newCount}건, 정정 ${correctionCount}건 처리`;
            if (legacyUnmatchedCount > 0) {
                showAlert("완료", `${baseMsg}\n(레거시 자산명 불일치 ${legacyUnmatchedCount}건은 자동정정 제외)`);
            } else {
                showAlert("완료", baseMsg);
            }
            refreshDashboard();
            loadHistory();
            });
        })();
    }

    // (7) 자동연동 직전 취소
    else if (type === 'undo_sync_last') {
        const undoState = getLastAutoSyncUndo();
        if (!undoState) return showAlert("알림", "되돌릴 자동연동 기록이 없습니다.");

        const transIds = Array.isArray(undoState.trans_ids)
            ? Array.from(new Set(undoState.trans_ids.map((value) => String(value || '').trim()).filter(Boolean)))
            : [];
        const restores = Array.isArray(undoState.restores) ? undoState.restores : [];
        const label = String(undoState.label || undoState.type || '자동연동');

        showConfirm("자동연동 직전 취소", `${label} 내역을 되돌리시겠습니까?\n전표 ${transIds.length}건 + 상태복원 ${restores.length}건`, async () => {
            if (transIds.length > 0) {
                const { error: deleteError } = await _supabase
                    .from('ac_journal')
                    .delete()
                    .in('Trans_ID', transIds);
                if (deleteError) return showAlert("오류", "전표 되돌리기 실패: " + deleteError.message);
            }

            let restoreFail = 0;
            for (const restore of restores) {
                const table = String(restore?.table || '');
                const keyColumn = String(restore?.key_column || '');
                const keyValue = restore?.key_value;
                const values = (restore && typeof restore.values === 'object' && restore.values !== null) ? restore.values : {};
                if (!table || !keyColumn || keyValue === undefined || keyValue === null) {
                    restoreFail += 1;
                    continue;
                }
                const { error: restoreError } = await _supabase
                    .from(table)
                    .update(values)
                    .eq(keyColumn, keyValue);
                if (restoreError) restoreFail += 1;
            }

            clearLastAutoSyncUndo();
            if (restoreFail > 0) {
                showAlert("부분 완료", `전표는 취소했지만 상태복원 ${restoreFail}건에 실패했습니다.\n관리자에서 확인해주세요.`);
            } else {
                showAlert("완료", `${label} 직전 자동연동을 되돌렸습니다.`);
            }
            refreshDashboard();
            loadHistory();
        });
    }

    // (8) 연말결산 (손익마감) - 모달 입력 방식
    else if (type === 'closing') {
        openClosingModal();
    }

    // (9) 연말결산 취소 (되돌리기) - 연도 입력 모달
    else if (type === 'undo_closing') {
        const defaultYear = new Date().getFullYear() - 1;
        openYearModal("결산 취소", "취소할 결산 연도를 입력하세요.", defaultYear, async (targetYear) => {
            const relatedKey = `CLOSE-${targetYear}`;

            showConfirm("결산 취소", `⚠️ ${targetYear}년도 결산 내역을 삭제하시겠습니까?\n마감 분개가 모두 삭제되고 손익이 초기화됩니다.`, async () => {
                const { count } = await _supabase
                    .from('ac_journal')
                    .select('*', { count: 'exact', head: true })
                    .eq('Trans_ID', relatedKey);

                if (!count || count === 0) return showAlert("알림", `${targetYear}년도 결산 내역이 없습니다.`);

                const { error } = await _supabase
                    .from('ac_journal')
                    .delete()
                    .eq('Trans_ID', relatedKey);

                if (error) {
                    showAlert("오류", "취소 실패: " + error.message);
                } else {
                    showAlert("완료", `${targetYear}년도 결산이 취소되었습니다.\n수정 후 다시 결산을 진행하세요.`);
                    refreshDashboard();
                }
            });
        });
    }

}

