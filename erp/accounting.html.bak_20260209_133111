        if (String(row.Account || '') !== '감가상각비') return;
        const delta = Number(row.Debit || 0) - Number(row.Credit || 0);
        if (!Number.isFinite(delta) || delta === 0) return;
        map.set(assetCode, (map.get(assetCode) || 0) + delta);
    });
    return map;
}

