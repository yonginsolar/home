<!DOCTYPE html>
<!-- Version: v1.0.35 | Change: 2026-02-09 - Exclude legacy donation rows without DON linkage from correction count/action. -->
<html>
<head>
  <script>console.log('[Version] v1.0.35 | accounting.html');</script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>회계 관리</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  
  <style>
    body { background-color: #f8f9fa; padding: 20px; font-family: 'Segoe UI', 'Malgun Gothic', sans-serif; }
    .main-container { max-width: 650px; margin: 0 auto; background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); padding: 25px; }
    
    .stat-card { flex: 1; padding: 15px; border-radius: 12px; text-align: center; color: white; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
    .bg-rev { background: linear-gradient(135deg, #2ecc71, #27ae60); }
    .bg-exp { background: linear-gradient(135deg, #e74c3c, #c0392b); }
    .bg-ast { background: linear-gradient(135deg, #3498db, #2980b9); }
    
    .sub-card { flex: 1; padding: 10px; border-radius: 10px; text-align: center; border: 1px solid #eee; background-color: #fff; }
    .text-vat { color: #d63384; font-weight: bold; } 
    .text-cash { color: #0d6efd; font-weight: bold; }
    
    .btn-report { width: 100%; font-weight: bold; border-radius: 10px; }
	    .readonly-input { background-color: #f8f9fa; cursor: pointer; }
	    .history-mode .btn { min-width: 94px; }
    
    /* 리포트 스타일 */
    #reportContent { font-family: "Malgun Gothic", serif; font-size: 12px; }
    .rpt-title { text-align: center; font-size: 24px; font-weight: bold; margin-bottom: 20px; text-decoration: underline; }
    .rpt-header-tbl { width: 100%; border: 2px solid #000; margin-bottom: 20px; }
    .rpt-header-tbl th { background: #f1f3f5; padding: 5px; border: 1px solid #000; text-align: center; width: 15%; }
    .rpt-header-tbl td { padding: 5px; border: 1px solid #000; }
    
    .rpt-tbl { width: 100%; border-collapse: collapse; margin-bottom: 20px; border: 1px solid #000; }
    .rpt-tbl th, .rpt-tbl td { border: 1px solid #000; padding: 6px 8px; }
    .rpt-tbl th { background: #f8f9fa; text-align: center; font-weight: bold; }
    .rpt-amt { text-align: right; font-family: 'Consolas', monospace; }
    .rpt-indent { padding-left: 20px !important; }
    
    /* 인쇄 설정 */
    @media print {
        .page-break { page-break-before: always; }
        .no-print { display: none !important; }
        body { background: white; padding: 0; }
        .main-container { box-shadow: none; border: none; max-width: 100%; padding: 0; }
    }
    
    .search-list-item:hover { background-color: #e9ecef; cursor: pointer; }
    .acc-item-name { font-size: 1.1rem; font-weight: bold; color: #333; }
    .acc-item-std { font-size: 0.85rem; color: #888; }
    
    .hidden { display: none !important; }
    .ime-kr { ime-mode: active; }
  </style>
</head>
<body>

<div class="main-container">
  <div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <h4 class="fw-bold m-0">📒 회계 관리</h4>
    <div>
      <button class="btn btn-outline-secondary btn-sm me-1" onclick="openInfoModal()">ℹ️ 정보</button>
      <button class="btn btn-outline-secondary btn-sm" onclick="location.href='index.html'">🏠 메뉴로</button>
    </div>
  </div>

  <div class="d-flex gap-2 mb-2 no-print">
    <div class="stat-card bg-rev"><div>매출</div><div class="fw-bold" id="valRev">0</div></div>
    <div class="stat-card bg-exp"><div>비용</div><div class="fw-bold" id="valExp">0</div></div>
    <div class="stat-card bg-ast"><div>자산</div><div class="fw-bold" id="valAst">0</div></div>
  </div>
  <div class="d-flex gap-2 mb-4 no-print">
    <div class="sub-card">
        <div>💰 통장 잔고 (보통예금)</div>
        <div class="text-cash fs-5" id="valCash">0</div>
    </div>
    <div class="sub-card">
        <div>🧾 부가세 납부예상</div>
        <div class="text-vat fs-5" id="valVat">0</div>
    </div>
  </div>

  <div class="input-group mb-4 no-print shadow-sm">
      <select class="form-select" id="reportYearSelect" style="max-width: 120px; font-weight:bold;">
          </select>
      <button class="btn btn-outline-dark btn-report flex-fill" type="button" onclick="printReport()">
          🖨️ 결산 보고서 생성
      </button>
  </div>

  <ul class="nav nav-tabs mb-4 no-print" id="accTab" role="tablist">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabForm">📝 전표입력</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabPrepay">💳 선급·미수 관리</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabSync">🔄 자동연동</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabHistory" onclick="loadHistory()">🕒 최근전표</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabGuide">ℹ️ 설명</button></li>
  </ul>

  <div class="tab-content no-print">
    
    <div class="tab-pane fade show active" id="tabForm">
      <form id="erpForm" onsubmit="handleFormSubmit(event)">
        
        <div class="row mb-3">
          <div class="col-6">
            <label class="small text-muted">날짜</label>
            <input type="date" class="form-control" id="dateField" required>
          </div>
          <div class="col-6">
            <label class="small text-muted">프로젝트</label>
            <select class="form-select" id="projectSelect" required></select>
          </div>
        </div>

        <div class="mb-3 p-3 border rounded bg-light">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <label class="small text-muted fw-bold">1. 거래 구분</label>
            <span class="badge bg-secondary" id="modeBadge">일반</span>
          </div>
          <div class="d-flex gap-2 mb-2">
             <input type="radio" class="btn-check" name="settleMode" id="smNorm" value="" checked onchange="toggleSettleMode()">
             <label class="btn btn-sm btn-outline-secondary flex-fill" for="smNorm">일반거래</label>
      <!-- 
              <input type="radio" class="btn-check" name="settleMode" id="smPre" value="pre_expense" onchange="toggleSettleMode()">
              <label class="btn btn-sm btn-outline-primary flex-fill" for="smPre">설립전/개인</label>
              <input type="radio" class="btn-check" name="settleMode" id="smReim" value="reimburse" onchange="toggleSettleMode()">
              <label class="btn btn-sm btn-outline-danger flex-fill" for="smReim">정산지급</label>
      -->        
          </div>
          <div id="payerInputDiv" class="hidden">
            <div class="input-group input-group-sm">
              <span class="input-group-text fw-bold" id="payerLabel">이름</span>
              <input type="text" class="form-control ime-kr" id="payerName" placeholder="지출자 또는 받는 분">
            </div>
          </div>

          <hr class="my-2" style="border-top: 1px dashed #ccc;">

<div class="d-flex justify-content-between align-items-center mb-2">
  <label class="small text-muted fw-bold">2. 계정 유형</label>
  <div class="form-check form-switch m-0">
    <input class="form-check-input" type="checkbox" id="advModeToggle" onchange="toggleAdvancedMode()">
    <label class="form-check-label small" for="advModeToggle">고급모드</label>
  </div>
</div>
<div class="btn-group w-100" role="group">
    <input type="radio" class="btn-check" name="inputType" id="t1" value="매출" onchange="resetAccountInput()">
    <label class="btn btn-outline-success" for="t1">매출</label>
    
    <input type="radio" class="btn-check" name="inputType" id="t_etc_rev" value="영업외수익" onchange="resetAccountInput()">
    <label class="btn btn-outline-info" for="t_etc_rev">영업외</label>

    <input type="radio" class="btn-check" name="inputType" id="t2" value="비용" checked onchange="resetAccountInput()">
    <label class="btn btn-outline-danger" for="t2">비용</label>
    
    <input type="radio" class="btn-check" name="inputType" id="t3" value="자산" onchange="resetAccountInput()">
    <label class="btn btn-outline-primary" for="t3">자산</label>

    <input type="radio" class="btn-check adv-only hidden" name="inputType" id="t4" value="부채" onchange="resetAccountInput()">
    <label class="btn btn-outline-warning adv-only hidden" for="t4">부채</label>

    <input type="radio" class="btn-check adv-only hidden" name="inputType" id="t5" value="자본" onchange="resetAccountInput()">
    <label class="btn btn-outline-dark adv-only hidden" for="t5">자본</label>
</div>
        </div>

        <div class="mb-3">
          <label class="small text-muted">계정과목</label>
          <div class="input-group">
            <input type="text" class="form-control readonly-input ime-kr" id="displayAccount" placeholder="선택하세요 (유형에 맞는 항목만 표시됨)" readonly onclick="openSelModal()">
            <button class="btn btn-secondary" type="button" onclick="openSelModal()">🔍</button>
            <button class="btn btn-outline-secondary" type="button" onclick="openAddModal()">➕</button>
          </div>
          
          <input type="hidden" id="hiddenItem">
          <input type="hidden" id="hiddenStandard">
          <input type="hidden" id="hiddenCode">
          <input type="hidden" id="isTaxFree">
          <input type="hidden" id="specialMode">
          <input type="hidden" id="hiddenSpecialRaw">
          <input type="hidden" id="hiddenCounterAccount">
          <input type="hidden" id="hiddenCounterType">
        </div>

        <div id="dynamicArea" class="mb-3"></div>

        <div class="mb-3"><label class="small text-muted">적요</label><input type="text" class="form-control ime-kr" id="inputDesc" required></div>
        <div class="mb-2"><label class="small text-muted">금액 (합계)</label><input type="number" class="form-control form-control-lg" id="inputAmount" placeholder="0" required min="0"></div>
        
        <div class="d-flex justify-content-between align-items-center mt-3">
           <div class="d-flex align-items-center" id="cardOptionDiv">
               <div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="payMethod" onchange="toggleCard()"><label class="form-check-label small" for="payMethod">💳 카드결제</label></div>
               <select class="form-select form-select-sm hidden ms-2" id="cardSelect" style="width: 120px;"><option value="">카드선택</option></select>
           </div>
           <div class="ms-auto"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="vatCheck" checked><label class="form-check-label small" for="vatCheck">부가세포함</label></div></div>
        </div>
        
        <button type="submit" class="btn btn-primary w-100 btn-lg shadow-sm mt-4" id="submitBtn">저장하기</button>
      </form>
    </div>
    <div class="tab-pane fade" id="tabPrepay">
      <div class="card p-3 border-start border-5 border-primary bg-light mb-3">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6 class="fw-bold mb-1">선급·미수 관리</h6>
            <small class="text-muted">선급금과 미수금을 한 곳에서 입력/정산합니다.</small>
          </div>
          <button class="btn btn-outline-secondary btn-sm" onclick="refreshPrepayTab()">새로고침</button>
        </div>
      </div>

      <div class="mb-3">
        <ul class="nav nav-pills small" id="advanceMainTab" role="tablist">
          <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#prepayMainPane">선급금</button>
          </li>
          <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#receivableMainPane">미수금</button>
          </li>
        </ul>
      </div>

      <div class="tab-content">
        <div class="tab-pane fade show active" id="prepayMainPane">
          <div class="mb-2">
            <label class="small text-muted">거래처(선급금)</label>
            <select class="form-select" id="prepayVendorSelect" onchange="onPrepayVendorChange()"></select>
            <input type="text" class="form-control mt-2 hidden" id="prepayVendorInput" placeholder="거래처명 직접 입력" oninput="onPrepayVendorChange()">
            <div class="small text-muted mt-1" id="prepayBalanceText">잔액 조회 중...</div>
            <div class="small text-muted">팁: 선급금 입력 시 적요에 `[선급금-업체명]` 태그를 넣으면 자동 매칭이 더 정확합니다.</div>
          </div>

          <div class="mb-3">
            <ul class="nav nav-pills small" id="prepayModeTab" role="tablist">
              <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#prepayInPane">선급금 입력</button>
              </li>
              <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#prepayOutPane">선급금 차감</button>
              </li>
            </ul>
          </div>

          <div class="tab-content">
            <div class="tab-pane fade show active" id="prepayInPane">
              <div class="border rounded p-3 bg-white mb-3">
                <div class="fw-bold mb-2">선급금 입력</div>
                <div class="row g-2 mb-2">
                  <div class="col-6">
                    <label class="small text-muted">전표일자</label>
                    <input type="date" class="form-control" id="prepayInDate">
                  </div>
                  <div class="col-6">
                    <label class="small text-muted">입력 금액</label>
                    <input type="number" class="form-control" id="prepayInAmount" min="0">
                  </div>
                </div>
                <div class="row g-2 mb-2">
                  <div class="col-6">
                    <label class="small text-muted">출금 계정</label>
                    <input type="text" class="form-control bg-light" id="prepayInAccount" value="보통예금" readonly>
                  </div>
                  <div class="col-6">
                    <label class="small text-muted">적요</label>
                    <input type="text" class="form-control ime-kr" id="prepayInDesc" placeholder="예: 알리고 선급금 충전">
                  </div>
                </div>
                <button class="btn btn-outline-primary w-100" onclick="submitPrepayInput()">선급금 입력</button>
              </div>
            </div>

            <div class="tab-pane fade" id="prepayOutPane">
              <div class="border rounded p-3 bg-white">
                <div class="fw-bold mb-2">선급금 차감</div>
                <div class="row g-2 mb-2">
                  <div class="col-6">
                    <label class="small text-muted">사용월</label>
                    <input type="month" class="form-control" id="prepayUseMonth">
                  </div>
                  <div class="col-6">
                    <label class="small text-muted">전표일자</label>
                    <input type="date" class="form-control" id="prepayDate">
                  </div>
                </div>

                <div class="row g-2 mb-2">
                  <div class="col-6">
                    <label class="small text-muted">공급가액</label>
                    <input type="number" class="form-control" id="prepaySupply" min="0" oninput="onPrepaySupplyChange()">
                  </div>
                  <div class="col-6">
                    <label class="small text-muted">부가세</label>
                    <input type="number" class="form-control" id="prepayVat" min="0" oninput="onPrepayVatChange()">
                  </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="prepayVatToggle" checked onchange="togglePrepayVat()">
                    <label class="form-check-label small" for="prepayVatToggle">부가세 포함</label>
                  </div>
                  <div class="fw-bold">합계: <span id="prepayTotal">0</span>원</div>
                </div>

                <div class="mb-2">
                  <label class="small text-muted">비용 계정</label>
                  <div class="input-group">
                    <input type="text" class="form-control readonly-input ime-kr" id="prepayExpenseDisplay" placeholder="선택하세요" readonly onclick="openPrepayExpenseModal()">
                    <button class="btn btn-secondary" type="button" onclick="openPrepayExpenseModal()">🔍</button>
                    <button class="btn btn-outline-secondary" type="button" onclick="openPrepayExpenseAddModal()">➕</button>
                  </div>
                  <input type="hidden" id="prepayExpenseAccount">
                </div>

                <div class="mb-3">
                  <label class="small text-muted">적요</label>
                  <input type="text" class="form-control ime-kr" id="prepayDesc" placeholder="예: 알리고 2026-02 사용분">
                </div>

                <button class="btn btn-primary w-100" onclick="submitPrepayDeduction()">선급금 차감 처리</button>
              </div>
            </div>
          </div>
        </div>

        <div class="tab-pane fade" id="receivableMainPane">
          <div class="mb-2">
            <label class="small text-muted">거래처(미수금)</label>
            <select class="form-select" id="receivableVendorSelect" onchange="onReceivableVendorChange()"></select>
            <input type="text" class="form-control mt-2 hidden" id="receivableVendorInput" placeholder="거래처명 직접 입력" oninput="onReceivableVendorChange()">
            <div class="small text-muted mt-1" id="receivableBalanceText">잔액 조회 중...</div>
            <div class="small text-muted" id="receivableVatInfo">선택 거래처 세액: 0원</div>
            <div class="small text-muted">팁: 미수금 발생 시 적요에 `[미수금-거래처]` 태그를 자동 저장합니다.</div>
          </div>

          <div class="mb-3">
            <ul class="nav nav-pills small" id="receivableModeTab" role="tablist">
              <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#receivableInPane">미수금 발생</button>
              </li>
              <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#receivableOutPane">미수금 회수</button>
              </li>
            </ul>
          </div>

          <div class="tab-content">
            <div class="tab-pane fade show active" id="receivableInPane">
              <div class="border rounded p-3 bg-white mb-3">
                <div class="fw-bold mb-2">미수금 발생</div>
                <div class="row g-2 mb-2">
                  <div class="col-6">
                    <label class="small text-muted">전표일자</label>
                    <input type="date" class="form-control" id="receivableInDate">
                  </div>
                  <div class="col-6">
                    <label class="small text-muted">해당월</label>
                    <input type="month" class="form-control" id="receivableUseMonth">
                  </div>
                </div>

                <div class="row g-2 mb-2">
                  <div class="col-6">
                    <label class="small text-muted">공급가(미수금)</label>
                    <input type="number" class="form-control" id="receivableSupply" min="0" oninput="onReceivableSupplyChange()">
                  </div>
                  <div class="col-6">
                    <label class="small text-muted">세액(부가세예수금)</label>
                    <input type="number" class="form-control" id="receivableVat" min="0" oninput="onReceivableVatChange()">
                  </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="receivableVatToggle" checked onchange="toggleReceivableVat()">
                    <label class="form-check-label small" for="receivableVatToggle">부가세 포함</label>
                  </div>
                  <div class="fw-bold">청구합계: <span id="receivableTotal">0</span>원</div>
                </div>

                <div class="mb-2">
                  <label class="small text-muted">수익 유형</label>
                  <select class="form-select" id="receivableIncomeType" onchange="onReceivableIncomeTypeChange()">
                    <option value="매출">매출</option>
                    <option value="영업외수익">영업외수익</option>
                  </select>
                </div>

                <div class="mb-2">
                  <label class="small text-muted">수익 계정</label>
                  <div class="input-group">
                    <input type="text" class="form-control readonly-input ime-kr" id="receivableIncomeDisplay" placeholder="선택하세요" readonly onclick="openReceivableIncomeModal()">
                    <button class="btn btn-secondary" type="button" onclick="openReceivableIncomeModal()">🔍</button>
                    <button class="btn btn-outline-secondary" type="button" onclick="openReceivableIncomeAddModal()">➕</button>
                  </div>
                  <input type="hidden" id="receivableIncomeAccount">
                </div>

                <div class="mb-3">
                  <label class="small text-muted">적요</label>
                  <input type="text" class="form-control ime-kr" id="receivableInDesc" placeholder="예: 2월 조합원 분담금 미수분">
                </div>

                <button class="btn btn-outline-primary w-100" onclick="submitReceivableInput()">미수금 발생 처리</button>
              </div>
            </div>

            <div class="tab-pane fade" id="receivableOutPane">
              <div class="border rounded p-3 bg-white">
                <div class="fw-bold mb-2">미수금 회수</div>
                <div class="row g-2 mb-2">
