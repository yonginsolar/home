function getDateGuardMessage(dateStr) {
    if (!dateStr) return "";
    const target = new Date(dateStr);
    if (Number.isNaN(target.getTime())) return "";
    const today = new Date();
    const dayMs = 24 * 60 * 60 * 1000;
    const diffDays = Math.round((target - today) / dayMs);
    const absDays = Math.abs(diffDays);
    const yearDiff = Math.abs(target.getFullYear() - today.getFullYear());

    const reasons = [];
    if (yearDiff >= 2) reasons.push(`연도가 현재(${today.getFullYear()}년)와 크게 다릅니다.`);
    if (absDays > 120) reasons.push(`현재 기준 약 ${absDays}일 ${diffDays < 0 ? '이전' : '이후'} 날짜입니다.`);

    if (reasons.length === 0) return "";
    return `입력 날짜: ${dateStr}\n${reasons.join('\n')}\n계속 진행할까요?`;
}

function normalizeSpecialCode(raw) {
    if (!raw) return "";
    const rawStr = String(raw);
    const tokens = rawStr.split(/[,\s]+/).map(t => t.trim()).filter(Boolean);
    const normalized = tokens.map(t => t.toLowerCase().replace(/[^a-z0-9_.가-힣%]/g, ""));

    const has = (matcher) => normalized.some(v => matcher.test(v));

    if (has(/insurance|4대보험|4대/)) return "insurance";
    if (has(/loan|대출/)) return "loan_pay";
    if (has(/labor|인적|용역|3\.3|8\.8/)) return "labor";
    if (has(/salary|급여/)) return "salary";
    if (has(/retirement|퇴직/)) return "retirement_pension";
    if (has(/interest|이자/)) return "interest_inc";
    return "";
}

