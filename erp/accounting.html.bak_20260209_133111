async function buildClosingContext(targetYear) {
    const startDate = `${targetYear}-01-01`;
    const endDate = `${targetYear}-12-31`;

    const { data: journals } = await _supabase.from('ac_journal').select('*')
        .gte('Date', startDate).lte('Date', endDate)
        .in('Type', ['매출', '비용', '영업외수익']);

    let balances = {};
    if (journals) {
        journals.forEach(j => {
            const acc = j.Account;
            if (!balances[acc]) balances[acc] = { type: j.Type, amount: 0 };
            balances[acc].amount += (Number(j.Debit||0) - Number(j.Credit||0));
        });
    }

    let netIncome = 0;
    Object.values(balances).forEach(info => {
        if (info.amount === 0) return;
        if (info.type === '비용') netIncome -= info.amount;
        else netIncome += Math.abs(info.amount);
    });

    const { data: capRows } = await _supabase.from('ac_journal').select('*').eq('Account','출자금').lte('Date', endDate);
    const { data: legalRows } = await _supabase.from('ac_journal').select('*').eq('Account','법정적립금').lte('Date', endDate);
    let capitalTotal = 0;
    let legalBalance = 0;
    if (capRows) capRows.forEach(r => { capitalTotal += (Number(r.Credit||0) - Number(r.Debit||0)); });
    if (legalRows) legalRows.forEach(r => { legalBalance += (Number(r.Credit||0) - Number(r.Debit||0)); });
    if (capitalTotal < 0) capitalTotal = 0;

    const thresholdMet = legalBalance >= (capitalTotal * 3);
    const minLegal = (netIncome > 0 && !thresholdMet) ? Math.ceil(netIncome * 0.1) : 0;
    const autoLegal = (netIncome > 0 && !thresholdMet) ? minLegal : 0;

    return {
        year: targetYear,
        startDate,
        endDate,
        balances,
        netIncome,
        capitalTotal,
        legalBalance,
        thresholdMet,
        minLegal,
        autoLegal
    };
}

async function refreshClosingContext() {
    const yearVal = Number(document.getElementById("closingYearInput").value);
    if (!yearVal) return showAlert("알림", "결산 연도를 입력하세요.");

    closingContext = await buildClosingContext(yearVal);
    const ctx = closingContext;

    const legalInput = document.getElementById("closingLegalInput");
    const volInput = document.getElementById("closingVoluntaryInput");
    const warn = document.getElementById("closingLegalWarn");
    const hint = document.getElementById("closingLegalHint");

    document.getElementById("closingNetIncome").value = ctx.netIncome.toLocaleString();
    document.getElementById("closingCapitalInfo").innerText = `출자금 누적: ${ctx.capitalTotal.toLocaleString()}원 · 법정적립금 누적: ${ctx.legalBalance.toLocaleString()}원 · 3배 기준 ${ctx.thresholdMet ? '충족' : '미충족'}`;

    if (ctx.netIncome <= 0) {
        legalInput.value = 0;
        volInput.value = 0;
        legalInput.disabled = true;
        volInput.disabled = true;
        hint.innerText = "당기순이익이 0 이하이므로 적립금 입력이 비활성화됩니다.";
    } else {
        legalInput.disabled = false;
        volInput.disabled = false;
        legalInput.min = ctx.minLegal;
        legalInput.max = ctx.netIncome;
        volInput.min = 0;
        volInput.max = ctx.netIncome;
        legalInput.value = ctx.autoLegal;
        volInput.value = 0;
        if (ctx.thresholdMet) {
            hint.innerText = "출자금 3배 기준을 충족하여 법정적립금 0 입력이 가능합니다.";
        } else {
            hint.innerText = `법정적립금 최소액: ${ctx.minLegal.toLocaleString()}원 (순이익의 10%)`;
        }
    }

    warn.classList.add("hidden");
    handleClosingLegalInputChange();
}

function handleClosingLegalInputChange() {
    const warn = document.getElementById("closingLegalWarn");
    if (!closingContext) { warn.classList.add("hidden"); return; }
    const current = Number(document.getElementById("closingLegalInput").value || 0);
    const autoVal = Number(closingContext.autoLegal || 0);
    if (current !== autoVal) warn.classList.remove("hidden");
    else warn.classList.add("hidden");
}

async function runClosingFromModal() {
    if (!closingContext) await refreshClosingContext();
    if (!closingContext) return;

    const ctx = closingContext;
    const legal = Number(document.getElementById("closingLegalInput").value || 0);
    const vol = Number(document.getElementById("closingVoluntaryInput").value || 0);

    if (ctx.netIncome <= 0) {
        if (legal > 0 || vol > 0) return showAlert("오류", "순이익이 0 이하일 때는 적립금을 0으로 입력하세요.");
    } else {
        if (!ctx.thresholdMet && legal < ctx.minLegal) return showAlert("오류", `법정적립금은 최소 ${ctx.minLegal.toLocaleString()}원 이상 입력해야 합니다.`);
        if (legal > ctx.netIncome) return showAlert("오류", "법정적립금은 당기순이익을 초과할 수 없습니다.");
        if (vol > ctx.netIncome) return showAlert("오류", "임의적립금은 당기순이익을 초과할 수 없습니다.");
        if ((legal + vol) > ctx.netIncome) return showAlert("오류", "법정적립금 + 임의적립금이 당기순이익을 초과할 수 없습니다.");
    }

    showConfirm("연말결산 실행", `${ctx.year}년 결산을 진행합니다.\n당기순이익: ${ctx.netIncome.toLocaleString()}원\n법정적립: ${legal.toLocaleString()}원\n임의적립: ${vol.toLocaleString()}원`, async () => {
        await executeClosing(ctx, legal, vol);
        closingModal.hide();
    });
}

async function executeClosing(ctx, legal, vol) {
    const relatedKey = `CLOSE-${ctx.year}`;
    const writer = myInfo ? myInfo.emp_name : "System";

    const { data: dup } = await _supabase.from('ac_journal').select('id').eq('Trans_ID', relatedKey).limit(1);
    if (dup && dup.length > 0) return showAlert("중복", `이미 ${ctx.year}년도 결산이 완료되었습니다.`);

    let entries = [];
    for (const [acc, info] of Object.entries(ctx.balances)) {
        if(info.amount === 0) continue;
        if(info.type === '비용') { // 비용(차변) -> 대변 기입
            entries.push({ Date: ctx.endDate, Type: '자본', Account: '이월이익잉여금', Description: `[손익마감] ${acc}`, Debit: info.amount, Credit: 0, Trans_ID: relatedKey, Evidence_Type: '내부기표', Project: '본사', Operator: writer });
            entries.push({ Date: ctx.endDate, Type: '비용', Account: acc, Description: `[손익마감]`, Debit: 0, Credit: info.amount, Trans_ID: relatedKey, Evidence_Type: '내부기표', Project: '본사', Operator: writer });
        } else { // 수익(대변) -> 차변 기입
            const abs = Math.abs(info.amount);
            entries.push({ Date: ctx.endDate, Type: info.type, Account: acc, Description: `[손익마감]`, Debit: abs, Credit: 0, Trans_ID: relatedKey, Evidence_Type: '내부기표', Project: '본사', Operator: writer });
            entries.push({ Date: ctx.endDate, Type: '자본', Account: '이월이익잉여금', Description: `[손익마감] ${acc}`, Debit: 0, Credit: abs, Trans_ID: relatedKey, Evidence_Type: '내부기표', Project: '본사', Operator: writer });
        }
    }

    if(ctx.netIncome > 0) {
        if(legal > 0) {
            entries.push({ Date: ctx.endDate, Type: '자본', Account: '이월이익잉여금', Description: `[이익처분] 법정적립`, Debit: legal, Credit: 0, Trans_ID: relatedKey, Evidence_Type: '내부기표', Project: '본사', Operator: writer });
            entries.push({ Date: ctx.endDate, Type: '자본', Account: '법정적립금', Description: `[이익처분] 법정적립`, Debit: 0, Credit: legal, Trans_ID: relatedKey, Evidence_Type: '내부기표', Project: '본사', Operator: writer });
        }
        if(vol > 0) {
            entries.push({ Date: ctx.endDate, Type: '자본', Account: '이월이익잉여금', Description: `[이익처분] 임의적립`, Debit: vol, Credit: 0, Trans_ID: relatedKey, Evidence_Type: '내부기표', Project: '본사', Operator: writer });
            entries.push({ Date: ctx.endDate, Type: '자본', Account: '임의적립금', Description: `[이익처분] 임의적립`, Debit: 0, Credit: vol, Trans_ID: relatedKey, Evidence_Type: '내부기표', Project: '본사', Operator: writer });
        }
    }

    if(entries.length > 0) {
        applyTransId(entries);
        const { error } = await _supabase.from('ac_journal').insert(entries);
        if(error) showAlert("오류", error.message);
        else {
            showAlert("완료", `결산 및 이익처분이 완료되었습니다.\n당기순손익: ${ctx.netIncome.toLocaleString()}원`);
            refreshDashboard();
        }
    } else {
        showAlert("알림", "마감할 내역이 없습니다.");
    }
}

// 6. 자동 연동 기능
function confirmSync(type) {
    if (!canPerform('accounting.edit')) return showAlert("수정 권한이 없습니다.");
    const today = new Date().toISOString().slice(0,10);
    const writer = myInfo ? myInfo.emp_name : "System";

// (1) 급여 연동 (말일 발생주의 + 정정 시 취소 후 재기표)
     if(type === 'salary') {
        const ym = document.getElementById("salaryMonth").value;
        if(!ym) return showAlert("알림", "년-월을 선택하세요.");

        const [year, month] = ym.split('-').map(Number);
        const lastDateObj = new Date(year, month, 0);
        const fDate = lastDateObj.toISOString().slice(0, 10);

        (async () => {
            const { data: previewSalaries, error: previewSalaryError } = await _supabase
                .from('hr_salary')
                .select('id,pay_total,ded_total,net_pay,co_total,is_accounted')
                .eq('year_month', ym);
            if (previewSalaryError) return showAlert("오류", "미리보기 조회 실패: " + previewSalaryError.message);
            if (!previewSalaries || previewSalaries.length === 0) return showAlert("알림", "급여 데이터가 없습니다.");

            const previewDesired = previewSalaries.reduce((acc, row) => {
                acc.pay += Math.max(0, Number(row.pay_total || 0));
                acc.ded += Math.max(0, Number(row.ded_total || 0));
                acc.net += Math.max(0, Number(row.net_pay || 0));
                acc.co += Math.max(0, Number(row.co_total || 0));
                return acc;
            }, { pay: 0, ded: 0, net: 0, co: 0 });

            const { data: previewSalRows, error: previewSalRowsError } = await _supabase
                .from('ac_journal')
                .select('Trans_ID')
                .like('Trans_ID', `SAL-${ym}%`);
            if (previewSalRowsError) return showAlert("오류", "미리보기 전표 조회 실패: " + previewSalRowsError.message);
            const hasPosted = (previewSalRows || []).length > 0;

            const previewMsg = [
                `${ym}월 급여 연동 미리보기`,
                `- 대상 인원: ${previewSalaries.length}명`,
                `- 급여총액: ${previewDesired.pay.toLocaleString()}원`,
                `- 공제총액: ${previewDesired.ded.toLocaleString()}원`,
                `- 실지급액: ${previewDesired.net.toLocaleString()}원`,
                `- 회사부담분: ${previewDesired.co.toLocaleString()}원`,
                `- 처리 방식: ${hasPosted ? '기존 SAL 전표 정정(취소 후 재기표)' : '신규 SAL 전표 생성'}`
            ].join('\n');

            showConfirm("급여 연동", previewMsg, async () => {
            const { error: calcError } = await _supabase.rpc('calc_company_share', { target_ym: ym });
            if(calcError) return showAlert("오류", "회사부담분 계산 실패: " + calcError.message);

            const { data: salaries, error: fetchError } = await _supabase
                .from('hr_salary')
                .select('*')
                .eq('year_month', ym);
            if(fetchError) return showAlert("오류", "급여 데이터 조회 실패: " + fetchError.message);
            if(!salaries || salaries.length === 0) return showAlert("알림", "급여 데이터가 없습니다.");

            const desired = {
                pay: 0,
                ded: 0,
                net: 0,
                co: 0
            };
            const salaryStateBefore = new Map();
            salaries.forEach((row) => {
                desired.pay += Math.max(0, Number(row.pay_total || 0));
                desired.ded += Math.max(0, Number(row.ded_total || 0));
                desired.net += Math.max(0, Number(row.net_pay || 0));
                desired.co += Math.max(0, Number(row.co_total || 0));
                salaryStateBefore.set(String(row.id), row.is_accounted === true);
            });

            const { data: salRows, error: salError } = await _supabase
                .from('ac_journal')
                .select('Trans_ID,Account,Debit,Credit')
                .like('Trans_ID', `SAL-${ym}%`);
            if (salError) return showAlert("오류", "기존 전표 확인 실패: " + salError.message);

            const current = {
                pay: sumAccountSideAmount(salRows || [], '급여', 'Debit'),
                ded: sumAccountSideAmount(salRows || [], '예수금', 'Credit'),
                net: sumAccountSideAmount(salRows || [], '미지급금', 'Credit'),
                coExpense: sumAccountSideAmount(salRows || [], '세금과공과', 'Debit'),
                coLiability: sumAccountSideAmount(salRows || [], '미지급비용', 'Credit')
            };
            const hasCurrentEntries = (salRows || []).length > 0;
            const hasLegacyFinalOnly = !hasCurrentEntries && salaries.some((row) => row.is_accounted === true);

            if (hasLegacyFinalOnly) {
                return showAlert("알림", `${ym}월은 전표완료 표시만 있고 SAL- 전표 연결이 없어 자동 정정을 건너뜁니다.\n기존 전표를 확인 후 수동 조정하세요.`);
            }

            const isSame =
                current.pay === desired.pay &&
                current.ded === desired.ded &&
                current.net === desired.net &&
                current.coExpense === desired.co &&
                current.coLiability === desired.co;

            if (isSame) {
                const updateTargets = salaries.filter((row) => row.is_accounted !== true).map((row) => row.id);
                if (updateTargets.length > 0) {
                    const { error: markError } = await _supabase
                        .from('hr_salary')
                        .update({ is_accounted: true })
                        .in('id', updateTargets);
                    if (markError) return showAlert("부분 완료", "전표는 최신이나 처리상태 갱신에 실패했습니다: " + markError.message);

                    const restores = updateTargets.map((id) => ({
                        table: 'hr_salary',
                        key_column: 'id',
                        key_value: String(id),
                        values: { is_accounted: salaryStateBefore.get(String(id)) === true }
                    }));
                    setLastAutoSyncUndo({
                        type: 'salary',
                        label: `급여 연동 ${ym}`,
                        created_at: new Date().toISOString(),
                        trans_ids: [],
                        restores
                    });
                    return showAlert("완료", `${ym}월 급여 전표는 최신이며, 처리상태만 보정했습니다.`);
                }
                return showAlert("알림", "변경된 내역이 없어 처리할 항목이 없습니다.");
            }

            let entries = [];
            const descBase = `[급여] ${ym}월분`;

            if (current.pay > 0 || current.ded > 0 || current.net > 0 || current.coExpense > 0 || current.coLiability > 0) {
                const revTransId = createRevisionTransId('SAL', ym, 'REV');
                appendSalaryAccrualReversalEntries(entries, {
                    date: fDate,
                    description: `${descBase} [정정취소]`,
                    transId: revTransId,
                    project: '본사',
                    operator: writer,
                    pay: current.pay,
                    ded: current.ded,
                    net: current.net,
                    co: Math.max(current.coExpense, current.coLiability)
                });
            }

            const desiredHasValue = desired.pay > 0 || desired.ded > 0 || desired.net > 0 || desired.co > 0;
            if (desiredHasValue) {
                const postTransId = !hasCurrentEntries ? `SAL-${ym}` : createRevisionTransId('SAL', ym, 'POST');
                appendSalaryAccrualEntries(entries, {
                    date: fDate,
                    description: !hasCurrentEntries ? descBase : `${descBase} [정정재기표]`,
                    transId: postTransId,
                    project: '본사',
                    operator: writer,
                    pay: desired.pay,
                    ded: desired.ded,
                    net: desired.net,
                    co: desired.co
                });
            }

            if (entries.length === 0) {
                return showAlert("알림", "생성할 전표가 없습니다.");
            }

            const { error: insertError } = await _supabase.from('ac_journal').insert(entries);
            if(insertError) return showAlert("오류", "전표 저장 실패: " + insertError.message);

            const { error: stateError } = await _supabase
                .from('hr_salary')
                .update({ is_accounted: true })
                .eq('year_month', ym);
            if (stateError) return showAlert("부분 완료", "전표는 저장되었으나 처리상태 갱신에 실패했습니다: " + stateError.message);

            const restores = Array.from(salaryStateBefore.entries()).map(([id, wasAccounted]) => ({
                table: 'hr_salary',
                key_column: 'id',
                key_value: id,
                values: { is_accounted: wasAccounted === true }
            }));
            setLastAutoSyncUndo({
                type: 'salary',
                label: `급여 연동 ${ym}`,
                created_at: new Date().toISOString(),
                trans_ids: collectTransIds(entries),
                restores
            });

            const isCorrection = hasCurrentEntries;
            showAlert("완료", isCorrection ? `${ym}월 급여 정정을 반영했습니다.` : `${ym}월 급여를 전표 반영했습니다.`);
            refreshDashboard();
            loadHistory();
            });
        })();
    }
      
    // (2) 전자결재 연동
    else if (type === 'approval') {
        (async () => {
            const { data: approvals, error: previewError } = await _supabase
                .from('ref_approval')
                .select('id,doc_type,status,amount,title,content,drafter_name,created_at')
                .eq('status', '완료')
                .ilike('doc_type', '%지출%');
            if (previewError) return showAlert("오류", "미리보기 조회 실패: " + previewError.message);
            if (!approvals || approvals.length === 0) return showAlert("알림", "불러올 결재 건이 없습니다.");

            const { data: existing, error: existingError } = await _supabase
                .from('ac_journal')
                .select('Trans_ID')
                .like('Trans_ID', 'APR-%');
            if (existingError) return showAlert("오류", "미리보기 전표 조회 실패: " + existingError.message);
            const existingSet = new Set(existing ? existing.map((entry) => entry.Trans_ID) : []);
            const targetDocs = approvals.filter((doc) => !existingSet.has(`APR-${doc.id}`));
            if (targetDocs.length === 0) return showAlert("알림", "이미 모두 연동되었습니다.");

            const salaryLikeCount = targetDocs.filter((doc) => isSalaryLikeApproval(doc)).length;
            const accrualCount = targetDocs.length - salaryLikeCount;
            const totalAmount = targetDocs.reduce((sum, doc) => sum + Math.max(0, Number(doc.amount || 0)), 0);

            const previewMsg = [
                '전자결재 연동 미리보기',
                `- 대상 건수: ${targetDocs.length}건`,
                `- 예상 금액: ${totalAmount.toLocaleString()}원`,
                `- 급여/인건비 집행전표: ${salaryLikeCount}건 (차)미지급금/(대)보통예금`,
                `- 일반 지출 발생전표: ${accrualCount}건 (차)미분류비용/(대)미지급금`
            ].join('\n');

            showConfirm("전자결재 연동", previewMsg, async () => {
                const { data: runApprovals, error: runFetchError } = await _supabase
                    .from('ref_approval')
                    .select('id,doc_type,status,amount,title,content,drafter_name,created_at')
                    .eq('status', '완료')
                    .ilike('doc_type', '%지출%');
                if (runFetchError) return showAlert("오류", "데이터 조회 실패: " + runFetchError.message);
                if (!runApprovals || runApprovals.length === 0) return showAlert("알림", "불러올 결재 건이 없습니다.");

                const { data: runExisting, error: runExistingError } = await _supabase
                    .from('ac_journal')
                    .select('Trans_ID')
                    .like('Trans_ID', 'APR-%');
                if (runExistingError) return showAlert("오류", "기존 전표 확인 실패: " + runExistingError.message);
                const runExistingSet = new Set(runExisting ? runExisting.map((entry) => entry.Trans_ID) : []);
                const runTargetDocs = runApprovals.filter((doc) => !runExistingSet.has(`APR-${doc.id}`));
                if (runTargetDocs.length === 0) return showAlert("알림", "이미 모두 연동되었습니다.");

                let entries = [];
                let runSalaryLikeCount = 0;
                let runAccrualCount = 0;

                runTargetDocs.forEach((doc) => {
                    const amount = Math.max(0, Number(doc.amount || 0));
                    if (!(amount > 0)) return;
                    const transId = `APR-${doc.id}`;
                    const descBase = doc.title || doc.doc_type || '지출결의';

                    if (isSalaryLikeApproval(doc)) {
                        runSalaryLikeCount += 1;
                        appendApprovalPaymentEntries(entries, {
                            amount,
                            date: today,
                            description: `[전자결재-지급] ${descBase}`,
                            transId,
                            project: '본사',
                            operator: doc.drafter_name || writer
                        });
                    } else {
                        runAccrualCount += 1;
                        appendApprovalAccrualEntries(entries, {
                            amount,
                            date: today,
                            description: `[전자결재-발생] ${descBase}`,
                            transId,
                            project: '본사',
                            operator: doc.drafter_name || writer
                        });
                    }
                });

                if (entries.length === 0) return showAlert("알림", "연동 대상 금액이 없어 생성할 전표가 없습니다.");

                const { error: insertError } = await _supabase.from('ac_journal').insert(entries);
                if (insertError) return showAlert("오류", "전표 저장 실패: " + insertError.message);

                setLastAutoSyncUndo({
                    type: 'approval',
                    label: '전자결재 연동',
                    created_at: new Date().toISOString(),
                    trans_ids: collectTransIds(entries),
                    restores: []
                });
                showAlert("완료", `${runTargetDocs.length}건 연동 성공\n- 급여/인건비 집행전표 ${runSalaryLikeCount}건\n- 일반 발생전표 ${runAccrualCount}건`);
                refreshDashboard();
                loadHistory();
            });
        })();
    }
// (3) 출자금 연동
    else if (type === 'capital') {
        (async () => {
            const { data: previewMembers, error: previewMemberError } = await _supabase
                .from('ref_members')
                .select('id,amount,status')
                .in('status', ['완료', '전표완료']);
            if (previewMemberError) return showAlert("오류", "미리보기 조회 실패: " + previewMemberError.message);
            if (!previewMembers || previewMembers.length === 0) return showAlert("알림", "처리할 출자금 내역이 없습니다.");

            const { data: previewCapRows, error: previewCapError } = await _supabase
                .from('ac_journal')
                .select('Trans_ID,Account,Debit,Credit')
                .like('Trans_ID', 'CAP-%');
            if (previewCapError) return showAlert("오류", "미리보기 전표 조회 실패: " + previewCapError.message);

            const previewCashNetMap = buildCashNetMap(previewCapRows || [], 'CAP');
            let previewNew = 0;
            let previewCorrection = 0;
            let previewLegacySkip = 0;

            previewMembers.forEach((member) => {
                const sourceId = String(member.id || '').trim();
                if (!sourceId) return;
                const desired = Math.max(0, Number(member.amount || 0));
                const current = Number(previewCashNetMap.get(sourceId) || 0);
                const isFinal = String(member.status || '') === '전표완료';
                if (isFinal && current === 0) { previewLegacySkip += 1; return; }
                if (current === desired) return;
                if (!isFinal && current === 0 && desired > 0) previewNew += 1;
                else previewCorrection += 1;
            });

            const previewMsg = [
                '출자금 연동 미리보기',
                `- 대상 건수: ${previewMembers.length}건`,
                `- 신규 전표: ${previewNew}건`,
                `- 정정(취소+재기표): ${previewCorrection}건`,
                `- 레거시 연결불가: ${previewLegacySkip}건`
            ].join('\n');

            showConfirm("출자금 연동", previewMsg, async () => {
            const { data: members, error: fetchError } = await _supabase
                .from('ref_members')
                .select('*')
                .in('status', ['완료', '전표완료']);

            if (fetchError) return showAlert("오류", "데이터 조회 실패: " + fetchError.message);
            if (!members || members.length === 0) return showAlert("알림", "처리할 출자금 내역이 없습니다.");
            const memberStatusBefore = new Map(
                members.map((member) => [String(member.id), String(member.status || '')])
            );

            const { data: capRows, error: capError } = await _supabase
                .from('ac_journal')
                .select('Trans_ID,Account,Debit,Credit')
                .like('Trans_ID', 'CAP-%');
            if (capError) return showAlert("오류", "기존 전표 확인 실패: " + capError.message);

            const cashNetMap = buildCashNetMap(capRows || [], 'CAP');
            let entries = [];
            let markIds = [];
            let newCount = 0;
            let correctionCount = 0;
            let legacySkipCount = 0;

            members.forEach((m) => {
                const sourceId = String(m.id || '').trim();
                if (!sourceId) return;

                const desired = Math.max(0, Number(m.amount || 0));
                const currentNet = Number(cashNetMap.get(sourceId) || 0);
                const isFinal = String(m.status || '') === '전표완료';
                const txDate = m.deposit_date || today;
                const descBase = `[출자] ${m.depositor || m.member_id || sourceId}`;

                if (isFinal && currentNet === 0) {
                    // 과거 랜덤 Trans_ID 전표는 소스 연결이 없어 자동 정정을 건너뜀
                    legacySkipCount += 1;
                    return;
                }

                if (currentNet === desired) {
                    if (!isFinal && desired > 0) markIds.push(sourceId);
                    return;
                }

                if (currentNet !== 0) {
                    const revTransId = createRevisionTransId('CAP', sourceId, 'REV');
                    appendCapitalCashDeltaEntries(entries, {
                        cashDelta: -currentNet,
                        date: txDate,
                        description: `${descBase} [정정취소]`,
                        transId: revTransId,
                        project: '본사',
                        operator: writer
                    });
                }

                if (desired > 0) {
                    const isInitialPost = !isFinal && currentNet === 0;
                    const postTransId = isInitialPost
                        ? `CAP-${sourceId}`
                        : createRevisionTransId('CAP', sourceId, 'POST');
                    appendCapitalCashDeltaEntries(entries, {
                        cashDelta: desired,
                        date: txDate,
                        description: isInitialPost ? descBase : `${descBase} [정정재기표]`,
                        transId: postTransId,
                        project: '본사',
                        operator: writer
                    });
                    if (isInitialPost) newCount += 1;
                    else correctionCount += 1;
                    markIds.push(sourceId);
                } else if (currentNet !== 0) {
                    correctionCount += 1;
                }
            });

            if (entries.length > 0) {
                const { error: insertError } = await _supabase.from('ac_journal').insert(entries);
                if (insertError) {
                    console.error("전표 저장 실패:", insertError);
                    return showAlert("오류", "전표 저장 실패: " + insertError.message);
                }
            }

            const uniqueMarkIds = Array.from(new Set(markIds));
            if (uniqueMarkIds.length > 0) {
                const { error: updateError } = await _supabase
                    .from('ref_members')
                    .update({ status: '전표완료' })
                    .in('id', uniqueMarkIds);
                if (updateError) {
