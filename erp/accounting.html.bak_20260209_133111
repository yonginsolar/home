// [수정] 계정과목 검색 필터 (Usage 연동)
// [수정] 프로젝트(Usage) 필터링이 추가된 계정과목 검색 함수
function filterAccounts() {
    const k = document.getElementById("accountSearchInput").value.trim();
    const forcedType = selectContext && selectContext.forcedType;
    const type = forcedType || document.querySelector('input[name="inputType"]:checked').value;
    
    // [추가] 현재 선택된 프로젝트 값을 가져옵니다. (본사 vs 발전소 구분용)
    const currentProject = document.getElementById("projectSelect").value; 
    const list = document.getElementById("accountList");
    
    list.innerHTML = "";
    
    const filtered = mData.filter(m => {
        const mType = m.Type || m.type;
        const mItem = m.Item || m.item;
        const mStandard = m.Standard || m.standard;
        const mUsage = m.Usage || m.usage || "전체"; // Usage 값이 없으면 '전체'로 간주

        // 1. 계정 유형(매출/비용/자산) 및 키워드 매칭
        const typeMatch = (mType === type);
        const keywordMatch = (mItem.includes(k) || mStandard.includes(k));

        // 2. [핵심] 프로젝트별 Usage 필터링 논리
        let usageMatch = false;
        if (currentProject === "본사") {
            // 본사 선택 시: Usage가 '전체' 또는 '본사'인 것만
            usageMatch = (mUsage === "전체" || mUsage === "본사");
        } else {
            // 본사가 아닌(발전소 등) 선택 시: Usage가 '전체' 또는 '발전소'인 것만
            usageMatch = (mUsage === "전체" || mUsage === "발전소");
        }

        return typeMatch && keywordMatch && usageMatch;
    });
    
    if(filtered.length === 0) { 
        list.innerHTML = "<div class='p-3 text-center text-muted'>검색 결과가 없습니다.</div>"; 
        return; 
    }

    // 화면에 리스트 그리기
    filtered.forEach(acc => {
        const d = document.createElement("div");
        d.className = "list-group-item list-group-item-action p-2 ps-3 border-0 border-bottom search-list-item";
        
        const isTaxFree = acc.tax_free; 
        const specialRaw = acc.special_code || "";
        const specialType = normalizeSpecialCode(specialRaw);
        
        const badge = (isTaxFree === true || isTaxFree === 'TRUE' || isTaxFree === '면세') ? '<span class="badge bg-secondary ms-2" style="font-size:0.7em;">면세</span>' : '';
        const spBadge = (specialRaw) ? `<span class="badge bg-info text-dark ms-1" style="font-size:0.7em;">${specialRaw}</span>` : '';

        d.innerHTML = `<div class="d-flex justify-content-between align-items-center"><div><span class="acc-item-name">${acc.Item}</span><span class="acc-item-std ms-1">(${acc.Standard})</span></div><div>${spBadge}${badge}</div></div>`;
        
        d.onclick = () => {
            if (selectContext && selectContext.mode === 'prepayExpense') {
                setPrepayExpenseAccount(acc.Item);
                selectContext = null;
                selectModal.hide();
                return;
            }
            if (selectContext && selectContext.mode === 'receivableIncome') {
                setReceivableIncomeAccount(acc.Item);
                selectContext = null;
                selectModal.hide();
                return;
            }
            document.getElementById("displayAccount").value = acc.Item;
            document.getElementById("hiddenItem").value = acc.Item;
            document.getElementById("hiddenStandard").value = acc.Standard;
            document.getElementById("hiddenCode").value = acc.Code || acc.code || ""; 
            document.getElementById("isTaxFree").value = isTaxFree; 
            document.getElementById("specialMode").value = specialType || ""; 
            document.getElementById("hiddenSpecialRaw").value = specialRaw || "";
            
            // 특수 UI 업데이트 함수 호출
            updateDynamicUI(acc.Item, acc.Type, specialType, isTaxFree, specialRaw);
            selectModal.hide();
        };
        list.appendChild(d);
    });
}

