function parseSourceIdFromTransId(transId, prefix) {
    const raw = String(transId || '').trim();
    const start = `${prefix}-`;
    if (!raw.startsWith(start)) return null;
    const rest = raw.slice(start.length);
    if (!rest) return null;

    let cut = rest.length;
    const tags = ['-REV-', '-POST-'];
    tags.forEach((tag) => {
        const idx = rest.indexOf(tag);
        if (idx >= 0 && idx < cut) cut = idx;
    });
    return rest.slice(0, cut) || null;
}

function buildCashNetMap(rows, prefix) {
    const map = new Map();
    (rows || []).forEach((row) => {
        const sourceId = parseSourceIdFromTransId(row.Trans_ID, prefix);
        if (!sourceId) return;
        if (!isCashLikeAccount(row.Account)) return;
        const delta = Number(row.Debit || 0) - Number(row.Credit || 0);
        if (!Number.isFinite(delta) || delta === 0) return;
        map.set(sourceId, (map.get(sourceId) || 0) + delta);
    });
    return map;
}

