function buildCounterOptionsHtml() {
    if (!mData || mData.length === 0) return '<option value="">상대계정 선택</option>';
    const groups = {};
    mData.forEach(m => {
        const mType = m.Type || m.type;
        const mItem = m.Item || m.item;
        if (!mType || !mItem) return;
        if (!groups[mType]) groups[mType] = [];
        groups[mType].push(mItem);
    });

    const typeOrder = ['자산','부채','자본','매출','영업외수익','비용'];
    const typeKeys = Array.from(new Set([...typeOrder, ...Object.keys(groups)]));
    let html = '<option value="">상대계정 선택</option>';
    typeKeys.forEach(t => {
        const items = groups[t];
        if (!items || items.length === 0) return;
        const unique = Array.from(new Set(items)).sort();
        html += `<optgroup label="${t}">`;
        unique.forEach(name => {
            html += `<option value="${encodeCounterValue(t, name)}">${name}</option>`;
        });
        html += `</optgroup>`;
    });
    return html;
}

