  // [신규] 4대보험 납부 시 장부상 부채(직원분+회사분) 조회 함수
async function fetchLiabilitySum() {
    const ym = document.getElementById("payTargetMonth").value;
    if(!ym) return showAlert("알림", "귀속월을 선택하세요.");

    // hr_salary에서 해당 월의 [직원공제총액]과 [회사부담총액] 조회
    const { data, error } = await _supabase.from('hr_salary')
        .select('ded_total, co_total')
        .eq('year_month', ym);
    
    if(error) return showAlert("오류", "조회 실패: " + error.message);
    if(!data || data.length === 0) return showAlert("알림", `${ym}월 급여대장 데이터가 없습니다. 급여 연동을 먼저 진행했는지 확인하세요.`);

    let totalYesu = 0;      // 예수금 (직원부담분)
    let totalMigigeub = 0;  // 미지급비용 (회사부담분)

    data.forEach(row => {
        totalYesu += Number(row.ded_total || 0);
        totalMigigeub += Number(row.co_total || 0);
    });

    const totalBook = totalYesu + totalMigigeub;

    if (totalBook === 0) return showAlert("알림", "조회된 미납 내역이 0원입니다.");

    // 화면 표시
    document.getElementById("txtBookVal").innerText = totalBook.toLocaleString() + "원";
    document.getElementById("txtDetailVal").innerText = `(예수금: ${totalYesu.toLocaleString()} + 미지급비용: ${totalMigigeub.toLocaleString()})`;
    
    // 숨겨진 필드에 값 저장 (저장 시 사용)
    document.getElementById("hiddenBookVal").value = totalBook;
    document.getElementById("hiddenYesu").value = totalYesu;
    document.getElementById("hiddenMigigeub").value = totalMigigeub;

    // 편의상 입력창에 장부금액을 넣어줌 (사용자가 고지서 금액으로 수정 가능)
    document.getElementById("inputAmount").value = totalBook;

    showAlert("조회 성공", "장부상 금액을 불러왔습니다.\n실제 고지서 금액과 다르다면 '금액' 란을 수정하세요.");
}
</script>
