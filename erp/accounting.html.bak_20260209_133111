function extractReceivableVendor(desc) {
    const tagged = extractTagValue(desc, '미수금-');
    if (tagged) return normalizeVendorName(tagged);

    let cleaned = String(desc || '').replace(/\[[^\]]+\]/g, '');
    cleaned = cleaned.replace(/미수금|회수|수금|외상|발생/gi, '').trim();
    if (!cleaned) return '미지정';
    return normalizeVendorName(cleaned);
}

function buildReceivableCache(data) {
    const balances = {};
    const incomeMap = {};
    const transVendor = {};
    let totalBalance = 0;
    let totalVat = 0;
    const rows = Array.isArray(data) ? data : [];

    rows.forEach(r => {
        const db = Number(r.Debit || 0);
        const cr = Number(r.Credit || 0);
        const desc = r.Description || '';
        const accountCompact = String(r.Account || '').replace(/\s+/g, '');
        const typeCompact = String(r.Type || '').replace(/\s+/g, '');
        const transId = String(r.Trans_ID || '').trim();

        if ((accountCompact === '미수금' || accountCompact === '매출채권') && typeCompact === '자산') {
            const vendor = extractReceivableVendor(desc);
            if (!balances[vendor]) balances[vendor] = { debit: 0, credit: 0, balance: 0, vat: 0 };
            balances[vendor].debit += db;
            balances[vendor].credit += cr;
            totalBalance += (db - cr);
            if (transId) transVendor[transId] = vendor;
        }

        if (typeCompact === '매출' || typeCompact === '영업외수익') {
            const vendorTag = extractTagValue(desc, '미수금-');
            const incomeTag = extractTagValue(desc, '수익-');
            if (vendorTag && incomeTag) {
                incomeMap[normalizeVendorName(vendorTag)] = {
                    account: normalizeVendorName(incomeTag.replace(/\s+/g, '')),
                    type: typeCompact
                };
            }
        }
    });

    rows.forEach(r => {
        const db = Number(r.Debit || 0);
        const cr = Number(r.Credit || 0);
        const desc = r.Description || '';
        const accountCompact = String(r.Account || '').replace(/\s+/g, '');
        const transId = String(r.Trans_ID || '').trim();

        if (accountCompact === '부가세예수금' || accountCompact === '매출세액') {
            const taggedVendor = normalizeVendorName(extractTagValue(desc, '미수금-'));
            const transMatchedVendor = normalizeVendorName(transVendor[transId] || '');
            const fallbackVendor = normalizeVendorName(extractReceivableVendor(desc));
            const vendor = taggedVendor || transMatchedVendor || fallbackVendor;

            if (vendor) {
                if (!balances[vendor]) balances[vendor] = { debit: 0, credit: 0, balance: 0, vat: 0 };
                balances[vendor].vat += (cr - db);
            }
            totalVat += (cr - db);
        }
    });

    Object.keys(balances).forEach(v => {
        balances[v].balance = balances[v].debit - balances[v].credit;
    });

    receivableCache = {
        vendors: Object.keys(balances).sort((a, b) => a.localeCompare(b)),
        balances,
        incomeMap,
        summary: { balance: totalBalance, vat: totalVat }
    };
}

function renderReceivableVendorSelect() {
    const sel = document.getElementById('receivableVendorSelect');
    if (!sel) return;
    const current = sel.value;
    const vendors = receivableCache.vendors || [];
    sel.innerHTML = '';

    if (vendors.length === 0) {
        const sumBal = receivableCache.summary?.balance || 0;
        const sumVat = receivableCache.summary?.vat || 0;
        if (sumBal !== 0 || sumVat !== 0) {
            sel.add(new Option(`전체 미수 (청구 ${sumBal.toLocaleString()}원 / 세액 ${sumVat.toLocaleString()}원)`, '__all__'));
        } else {
            sel.add(new Option('미수금 내역 없음', ''));
        }
    } else {
        sel.add(new Option('선택하세요', ''));
        vendors.forEach(v => {
            const row = receivableCache.balances[v] || { balance: 0, vat: 0 };
            const bal = row.balance || 0;
            const vat = row.vat || 0;
            const label = `${v} (청구 ${bal.toLocaleString()}원 / 세액 ${vat.toLocaleString()}원)`;
            sel.add(new Option(label, v));
        });
    }
    sel.add(new Option('직접 입력', '__custom__'));

    if (current && Array.from(sel.options).some(o => o.value === current)) {
        sel.value = current;
    }
    onReceivableVendorChange();
}

