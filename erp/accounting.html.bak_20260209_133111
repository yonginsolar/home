function extractTagValue(desc, prefix) {
    if (!desc) return "";
    const re = new RegExp(`\\[${prefix}([^\\]]+)\\]`);
    const match = String(desc).match(re);
    return match ? match[1].trim() : "";
}

function normalizeVendorName(name) {
    return String(name || "").trim();
}

function extractVendorName(desc) {
    const tagged = extractTagValue(desc, '선급금-');
    if (tagged) return normalizeVendorName(tagged);

    let cleaned = String(desc || "").replace(/\[[^\]]+\]/g, '');
    cleaned = cleaned.replace(/선급금|충전|결제|사용분|사용/gi, '').trim();
    if (!cleaned) return "미지정";
    return normalizeVendorName(cleaned);
}

function buildPrepayCache(data) {
    const balances = {};
    const costMap = {};
    if (!Array.isArray(data)) data = [];

    data.forEach(r => {
        const db = Number(r.Debit || 0);
        const cr = Number(r.Credit || 0);
        const desc = r.Description || "";

        if (r.Account === '선급금' && r.Type === '자산') {
            const vendor = extractVendorName(desc);
            if (!balances[vendor]) balances[vendor] = { debit: 0, credit: 0, balance: 0 };
            balances[vendor].debit += db;
            balances[vendor].credit += cr;
        }

        if (r.Type === '비용') {
            const vendorTag = extractTagValue(desc, '선급금-');
            const costTag = extractTagValue(desc, '비용-');
            if (vendorTag && costTag) {
                costMap[normalizeVendorName(vendorTag)] = normalizeVendorName(costTag);
            }
        }
    });

    Object.keys(balances).forEach(v => {
        balances[v].balance = balances[v].debit - balances[v].credit;
    });

    prepayCache = {
        vendors: Object.keys(balances).sort((a,b) => a.localeCompare(b)),
        balances,
        costMap
    };
}

function renderPrepayVendorSelect() {
    const sel = document.getElementById("prepayVendorSelect");
    if (!sel) return;
    const current = sel.value;
    const vendors = prepayCache.vendors || [];
    sel.innerHTML = "";

    if (vendors.length === 0) {
        sel.add(new Option("선급금 내역 없음", ""));
    } else {
        sel.add(new Option("선택하세요", ""));
        vendors.forEach(v => {
            const bal = prepayCache.balances[v]?.balance || 0;
            const label = `${v} (잔액 ${bal.toLocaleString()}원)`;
            sel.add(new Option(label, v));
