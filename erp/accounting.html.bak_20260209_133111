function onPrepayVendorChange() {
    const sel = document.getElementById("prepayVendorSelect");
    const input = document.getElementById("prepayVendorInput");
    const balanceEl = document.getElementById("prepayBalanceText");

    const value = sel.value;
    const isCustom = value === "__custom__";
    input.classList.toggle("hidden", !isCustom);

    const vendor = isCustom ? normalizeVendorName(input.value) : normalizeVendorName(value);
    const bal = vendor ? (prepayCache.balances[vendor]?.balance ?? 0) : 0;
