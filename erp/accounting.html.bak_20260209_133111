    const settleMode = document.querySelector('input[name="settleMode"]:checked').value;
    const desc = document.getElementById("inputDesc").value;
    const totalAmt = Number(document.getElementById("inputAmount").value);
    const useVAT = document.getElementById("vatCheck").checked;
    const evidenceType = document.getElementById("evidenceType")?.value || "기타(영수증)";
    const specialCode = document.getElementById("specialMode").value;
    const isCard = (settleMode === "") && document.getElementById("payMethod").checked;
    const cardName = isCard ? document.getElementById("cardSelect").value : "";
    const payerName = document.getElementById("payerName").value || "지출자";

    const ctx = { item, fDate, project, type, settleMode, desc, totalAmt, useVAT, evidenceType, specialCode, isCard, cardName, payerName };
    const dateWarning = getDateGuardMessage(fDate);
    if (dateWarning) {
        showConfirm("날짜 확인", dateWarning, async () => { await submitAccounting(ctx); });
        return;
    }
    await submitAccounting(ctx);
} 

async function submitAccounting(ctx) {
    const { item, fDate, project, type, settleMode, desc, totalAmt, useVAT, evidenceType, specialCode, isCard, cardName, payerName } = ctx;

    let finalDesc = desc;
    if(isCard) finalDesc = `[${cardName}] ${desc}`;
    if(settleMode === 'pre_expense') finalDesc = `[설립전] ${desc} (${payerName})`;
    if(settleMode === 'reimburse') finalDesc = `[정산] ${desc} (${payerName})`;

    // 부가세 계산
    let netAmount = totalAmt, vatAmount = 0;
    if (useVAT && type !== '자산' && settleMode !== 'reimburse' && !document.getElementById("vatCheck").disabled) {
        netAmount = Math.round(totalAmt / 1.1);
        vatAmount = totalAmt - netAmount;
    }

    let entries = [];
    const writer = myInfo ? myInfo.emp_name : "WebUser";
    const advancedEnabled = document.getElementById("advModeToggle")?.checked;
    const isAdvancedEntry = advancedEnabled && (type === "자산" || type === "부채" || type === "자본") && !specialCode && settleMode === "";

    const hasSpecialHandler = ['insurance', 'loan_pay', 'labor', 'interest_inc'].includes(specialCode);

    // ==========================================
    // [1] 특수 분개 모드인지 확인 (Special Mode)
    // ==========================================
    if (hasSpecialHandler) {
        if (specialCode === 'insurance') { // 4대보험 납부
            const bookYesu = Number(document.getElementById("hiddenYesu").value);
            const bookMigigeub = Number(document.getElementById("hiddenMigigeub").value);
            const bookTotal = bookYesu + bookMigigeub;
            
            if (bookTotal === 0 && totalAmt > 0) return showAlert("오류", "먼저 [장부 조회] 버튼을 눌러 부채 내역을 불러오세요.");
            
            const diff = totalAmt - bookTotal; 

            if (bookYesu > 0) entries.push({ Date: fDate, Type: '부채', Account: '예수금', Description: `${finalDesc} (직원분 상환)`, Debit: bookYesu, Credit: 0, Project: project, Operator: writer, Evidence_Type: '금융거래' });
            if (bookMigigeub > 0) entries.push({ Date: fDate, Type: '부채', Account: '미지급비용', Description: `${finalDesc} (회사분 상환)`, Debit: bookMigigeub, Credit: 0, Project: project, Operator: writer, Evidence_Type: '금융거래' });
            
            if (diff > 0) entries.push({ Date: fDate, Type: '비용', Account: '잡손실', Description: `[4대보험] 납부차액(절사)`, Debit: diff, Credit: 0, Project: project, Operator: writer, Evidence_Type: '내부기표' });
            else if (diff < 0) entries.push({ Date: fDate, Type: '매출', Account: '잡이익', Description: `[4대보험] 납부차액(절사)`, Debit: 0, Credit: Math.abs(diff), Project: project, Operator: writer, Evidence_Type: '내부기표' });

            entries.push({ Date: fDate, Type: '자산', Account: '보통예금', Description: finalDesc, Debit: 0, Credit: totalAmt, Project: project, Operator: writer, Evidence_Type: '금융거래' });
        }
        else if (specialCode === 'loan_pay') { // 대출상환
            const interest = Number(document.getElementById("loanInterest")?.value || 0);
            const principal = totalAmt - interest;
            entries.push({ Date: fDate, Type: '자산', Account: '보통예금', Description: finalDesc, Debit: 0, Credit: totalAmt, Project: project, Operator: writer, Evidence_Type: '금융거래' });
            if(interest > 0) entries.push({ Date: fDate, Type: '비용', Account: '이자비용', Description: `[${item}] 이자`, Debit: interest, Credit: 0, Project: project, Operator: writer, Evidence_Type: '금융거래' });
            if(principal > 0) entries.push({ Date: fDate, Type: '부채', Account: item, Description: `[${item}] 원금상환`, Debit: principal, Credit: 0, Project: project, Operator: writer, Evidence_Type: '금융거래' });
        }
        else if (specialCode === 'labor') { // 인적용역
            const taxRate = Number(document.querySelector('input[name="laborTaxRate"]:checked').value);
            const taxAmt = Math.floor(totalAmt * taxRate / 10) * 10;
            const realPay = totalAmt - taxAmt;
            entries.push({ Date: fDate, Type: '비용', Account: item, Description: finalDesc, Debit: totalAmt, Credit: 0, Project: project, Operator: writer, Evidence_Type: '원천징수' });
            entries.push({ Date: fDate, Type: '부채', Account: '예수금', Description: `[${item}] 원천징수(${taxRate*100}%)`, Debit: 0, Credit: taxAmt, Project: project, Operator: writer, Evidence_Type: '내부기표' });
            entries.push({ Date: fDate, Type: '자산', Account: '보통예금', Description: finalDesc, Debit: 0, Credit: realPay, Project: project, Operator: writer, Evidence_Type: '금융거래' });
        }
        else if (specialCode === 'interest_inc') { // 이자수익
            const taxAmt = Math.floor(totalAmt * 0.154 / 10) * 10;
            const realIn = totalAmt - taxAmt;
            entries.push({ Date: fDate, Type: '매출', Account: item, Description: finalDesc, Debit: 0, Credit: totalAmt, Project: project, Operator: writer, Evidence_Type: '금융거래' });
            entries.push({ Date: fDate, Type: '자산', Account: '선납세금', Description: `[${item}] 원천징수`, Debit: taxAmt, Credit: 0, Project: project, Operator: writer, Evidence_Type: '원천징수' });
            entries.push({ Date: fDate, Type: '자산', Account: '보통예금', Description: finalDesc, Debit: realIn, Credit: 0, Project: project, Operator: writer, Evidence_Type: '금융거래' });
        }
    } 
    // ==========================================
    // [2] 고급 분개 모드 (Advanced Mode)
    // ==========================================
    else if (isAdvancedEntry) {
        const direction = document.querySelector('input[name="advDirection"]:checked')?.value || "inc";
        const counterValue = document.getElementById("advCounterSelect")?.value || "";
        if (!counterValue) return showAlert("오류", "상대계정을 선택하세요.");
        const counter = parseCounterValue(counterValue);
        if (!counter.type || !counter.account) return showAlert("오류", "상대계정 선택이 올바르지 않습니다.");

        const isIncrease = direction === "inc";
        let db = 0, cr = 0;
        if (type === "자산") {
            db = isIncrease ? totalAmt : 0;
            cr = isIncrease ? 0 : totalAmt;
        } else if (type === "부채" || type === "자본") {
            db = isIncrease ? 0 : totalAmt;
            cr = isIncrease ? totalAmt : 0;
        }

        const mainEvid = (type === "자산" && (item === "보통예금" || item === "현금")) ? "금융거래" : evidenceType;
        const counterEvid = (counter.type === "자산" && (counter.account === "보통예금" || counter.account === "현금")) ? "금융거래" : evidenceType;

        entries.push({ Date: fDate, Type: type, Account: item, Description: finalDesc, Debit: db, Credit: cr, Project: project, Operator: writer, Evidence_Type: mainEvid });
        entries.push({ Date: fDate, Type: counter.type, Account: counter.account, Description: finalDesc, Debit: cr, Credit: db, Project: project, Operator: writer, Evidence_Type: counterEvid });
    }
    // ==========================================
    // [3] 일반 분개 모드 (Normal Mode)
    // ==========================================
    else { 
        if (settleMode === 'pre_expense') { // 설립전 비용
            entries.push({ Date: fDate, Type: type, Account: item, Description: finalDesc, Debit: netAmount, Credit: 0, Project: project, Operator: writer, Evidence_Type: evidenceType });
            if(vatAmount > 0) entries.push({ Date: fDate, Type: '자산', Account: '부가세대급금', Description: `[${item}] 부가세`, Debit: vatAmount, Credit: 0, Project: project, Operator: writer, Evidence_Type: "세금계산서" });
            entries.push({ Date: fDate, Type: '부채', Account: '미지급금', Description: finalDesc, Debit: 0, Credit: totalAmt, Project: project, Operator: writer, Evidence_Type: evidenceType });
        } 
        else if (settleMode === 'reimburse') { // 정산 지급
            entries.push({ Date: fDate, Type: '부채', Account: '미지급금', Description: finalDesc, Debit: totalAmt, Credit: 0, Project: project, Operator: writer, Evidence_Type: evidenceType });
            entries.push({ Date: fDate, Type: '자산', Account: '보통예금', Description: finalDesc, Debit: 0, Credit: totalAmt, Project: project, Operator: writer, Evidence_Type: "금융거래" });
        } 
        else { // 일반 거래
            if (type === '매출' || type === '영업외수익') {
                entries.push({ Date: fDate, Type: type, Account: item, Description: finalDesc, Debit: 0, Credit: netAmount, Project: project, Operator: writer, Evidence_Type: evidenceType });
                if(vatAmount > 0) entries.push({ Date: fDate, Type: '부채', Account: '부가세예수금', Description: `[${item}] 부가세`, Debit: 0, Credit: vatAmount, Project: project, Operator: writer, Evidence_Type: "세금계산서" });
                entries.push({ Date: fDate, Type: '자산', Account: '보통예금', Description: finalDesc, Debit: totalAmt, Credit: 0, Project: project, Operator: writer, Evidence_Type: "금융거래" });
            } else if (type === '비용') {
                const creditAcc = isCard ? '미지급금' : '보통예금';
                const creditType = isCard ? '부채' : '자산';
                const credEvid = isCard ? evidenceType : "금융거래";
                entries.push({ Date: fDate, Type: '비용', Account: item, Description: finalDesc, Debit: netAmount, Credit: 0, Project: project, Operator: writer, Evidence_Type: evidenceType });
                if(vatAmount > 0) entries.push({ Date: fDate, Type: '자산', Account: '부가세대급금', Description: `[${item}] 부가세`, Debit: vatAmount, Credit: 0, Project: project, Operator: writer, Evidence_Type: "세금계산서" });
                entries.push({ Date: fDate, Type: creditType, Account: creditAcc, Description: finalDesc, Debit: 0, Credit: totalAmt, Project: project, Operator: writer, Evidence_Type: credEvid });
            } else { 
                const isDebit = (type === "자산" || type === "자본반환" || type === "부채감소");
                const db = isDebit ? totalAmt : 0;
                const cr = isDebit ? 0 : totalAmt;
                let saveType = type === "자본반환" ? "자본" : type;
                entries.push({ Date: fDate, Type: saveType, Account: item, Description: finalDesc, Debit: db, Credit: cr, Project: project, Operator: writer, Evidence_Type: evidenceType });
                entries.push({ Date: fDate, Type: '자산', Account: '보통예금', Description: finalDesc, Debit: cr, Credit: db, Project: project, Operator: writer, Evidence_Type: "금융거래" });
            }
        }
    }

    if (!entries.length) return showAlert("알림", "전표 항목이 없습니다.");

    applyTransId(entries);
    const { error } = await _supabase.from('ac_journal').insert(entries);
    if(error) showAlert("오류", "저장 실패: " + error.message);
    else {
        await logAudit('accounting.submit', null, '전표 저장', { total: totalAmt, type, project, entries: entries.length });
        showAlert("완료", "저장되었습니다.");
        const wasAdvanced = document.getElementById("advModeToggle").checked;
        document.getElementById("erpForm").reset();
        document.getElementById("advModeToggle").checked = wasAdvanced;
        toggleAdvancedMode();
        document.getElementById("smNorm").checked = true;
        document.getElementById("dynamicArea").innerHTML = "";
        document.getElementById("specialMode").value = "";
        toggleSettleMode();
        refreshDashboard();
    }
}
