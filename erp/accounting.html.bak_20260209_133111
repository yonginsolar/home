function calcYearDepAmount(asset, targetYear) {
    const cost = Number(asset.acquisition_cost || 0);
    const life = Number(asset.useful_life || 0);
    if (!(cost > 0) || !(life > 0)) return 0;

    const buyDate = new Date(asset.acquisition_date);
    if (Number.isNaN(buyDate.getTime())) return 0;
    const buyYear = buyDate.getFullYear();
    if (buyYear > targetYear) return 0;
    if ((buyYear + life) <= targetYear) return 0;

    let yearDep = Math.floor(cost / life);
    if (buyYear === targetYear) {
        const monthsUsed = 12 - buyDate.getMonth();
        yearDep = Math.floor(yearDep * (monthsUsed / 12));
    }
    yearDep = Math.floor(yearDep / 10) * 10;
    return Math.max(0, yearDep);
}

function parseDepAssetCodeFromTransId(transId, year) {
    const raw = String(transId || '').trim();
    if (!raw) return null;

    const p1 = `DEP-${year}-`;
    if (raw.startsWith(p1)) return raw.slice(p1.length) || null;

    const p2 = `DEP${year}-`;
    if (raw.startsWith(p2)) {
        const rest = raw.slice(p2.length);
        const revIdx = rest.indexOf('-REV-');
        const postIdx = rest.indexOf('-POST-');
        let cut = rest.length;
        if (revIdx >= 0 && revIdx < cut) cut = revIdx;
        if (postIdx >= 0 && postIdx < cut) cut = postIdx;
        return rest.slice(0, cut) || null;
    }
    return null;
}

function buildDepAmountMapForYear(rows, year) {
