function isCashLikeAccount(accountName) {
    const name = String(accountName || '');
    if (!name) return false;
    const keys = ['보통예금', '현금', '당좌예금', '예금'];
    return keys.some((keyword) => name.includes(keyword));
}

function cleanTagPrefix(text) {
    return String(text || '')
        .replace(/\[[^\]]+\]\s*/g, '')
        .trim();
}

function inferCashbookLabel(description, flow) {
    const raw = String(description || '').trim();
    if (!raw) {
        return flow === '입금' ? '입금' : (flow === '지출' ? '지출' : '대체');
    }
    if (raw.includes('[기부금]')) return '기부금 입금';
    if (raw.includes('[출자]')) return '출자금 입금';
    if (raw.includes('[배당]')) return '배당금 지급';
    if (raw.includes('[전자결재]')) return flow === '지출' ? '전자결재 지출' : '전자결재';
    if (raw.includes('[손익마감]') || raw.includes('[이익처분]')) return '결산 대체';
    if (raw.includes('감가상각')) return '감가상각 반영';
    const cleaned = cleanTagPrefix(raw);
    if (cleaned) return cleaned;
    return flow === '입금' ? '입금' : (flow === '지출' ? '지출' : '대체');
}

function buildSingleEntryHistory(rows) {
    const grouped = new Map();
    rows.forEach((row, index) => {
        const transId = row && row.Trans_ID ? String(row.Trans_ID).trim() : '';
        const key = transId ? `T:${transId}` : `I:${row.id || index}`;
        if (!grouped.has(key)) {
            grouped.set(key, {
                id: row.id || '',
                transId,
                rows: [],
                sortIndex: index
            });
        }
        grouped.get(key).rows.push(row);
    });

    const list = [];
    grouped.forEach((group) => {
        let debitTotal = 0;
        let creditTotal = 0;
        let cashDelta = 0;
        let date = '';
        let desc = '';
        let operator = '';

        group.rows.forEach((entry) => {
            const debit = Number(entry.Debit || 0);
            const credit = Number(entry.Credit || 0);
            const account = String(entry.Account || '').trim();
            if (!date && entry.Date) date = String(entry.Date);
            if (!desc && entry.Description) desc = String(entry.Description);
            if (!operator && entry.Operator) operator = String(entry.Operator);

            debitTotal += debit;
            creditTotal += credit;

            if (isCashLikeAccount(account)) {
                cashDelta += (debit - credit);
            }
        });

        // 용돈기입장형 단식 보기: 현금성 계정 변동이 없는 전표는 제외
        if (cashDelta === 0) return;

        let flow = '대체';
        if (cashDelta > 0) flow = '입금';
        else if (cashDelta < 0) flow = '지출';

        const amount = Math.abs(cashDelta) > 0 ? Math.abs(cashDelta) : Math.max(debitTotal, creditTotal);
        const inAmount = cashDelta > 0 ? cashDelta : 0;
        const outAmount = cashDelta < 0 ? Math.abs(cashDelta) : 0;
        const label = inferCashbookLabel(desc, flow);
        list.push({
            id: group.id,
            transId: group.transId,
            date,
            desc: desc || '',
            label,
            operator: operator || '작성자 미상',
            flow,
            amount,
            inAmount,
            outAmount,
            sortIndex: group.sortIndex
        });
    });

    list.sort((a, b) => {
        const ad = a.date || '';
        const bd = b.date || '';
        if (ad === bd) return a.sortIndex - b.sortIndex;
        return ad < bd ? 1 : -1;
    });
    return list;
}

