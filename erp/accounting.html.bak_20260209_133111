async function printReport() {
    const selYear = Number(document.getElementById("reportYearSelect").value);
    const currYear = new Date().getFullYear();
    const todayStr = new Date().toISOString().slice(0, 10);
    const startDate = `${selYear}-01-01`;
    const endDate = (selYear === currYear) ? todayStr : `${selYear}-12-31`;
    let rangeText = (selYear === currYear) ? `${startDate} ~ ${endDate} (가결산)` : `${startDate} ~ ${endDate} (확정)`;

    const { data: periodData } = await _supabase.from('ac_journal').select('*').gte('Date', startDate).lte('Date', endDate);
    const { data: closingData } = await _supabase.from('ac_journal').select('*').lte('Date', endDate);
    const { data: infoData } = await _supabase.from('ref_company_info').select('*');
    const { data: masterData } = await _supabase.from('ac_master').select('Type, Standard, Item, Code');
    const info = {}; if(infoData) infoData.forEach(i=>info[i.key]=i.value);
    const { count } = await _supabase.from('ref_members').select('*', { count: 'exact', head: true });
    const memberCount = count || 0;

    // 집계 변수
    let asset={}, liab={}, equity={}, rev={}, exp={}, otherRev={};
    let tAsset=0, tLiab=0, tEquity=0, tRev=0, tExp=0, tOtherRev=0;
    let capital = 0; 
    
    // 법인세 조정용
    let taxAdjust = { fines: 0, noProof: 0, donations: 0, entertain: 0 };
    
    // [신규] 잉여금 처분 집계용
    let surplus = { legal: 0, voluntary: 0, dividend: 0 }; 
    const accountAliasByCompact = {
        '부가세대급금': '부가세대급금',
        '부가세예수금': '부가세예수금',
        '잡이익': '잡이익',
        '잡손실': '잡손실'
    };

    function normalizeAccountName(name) {
        const raw = String(name || '').trim();
        if (!raw) return '';
        const compact = raw.replace(/\s+/g, '');
        return accountAliasByCompact[compact] || raw;
    }

    function normalizeTypeByAccount(type, account) {
        if (account === '부가세대급금' || account === '보통예금' || account === '현금' || account === '선급금' || account === '미수금') return '자산';
        if (account === '부가세예수금') return '부채';
        if (account === '잡이익') return '매출';
        if (account === '잡손실') return '비용';
        return type || '';
    }

    if (closingData) closingData.forEach(r => {
        const db = Number(r.Debit || 0), cr = Number(r.Credit || 0);
        const valDr = db - cr;
        const valCr = cr - db;
        const account = normalizeAccountName(r.Account);
        const type = normalizeTypeByAccount(r.Type, account);

        if(type === '자산') { asset[account] = (asset[account] || 0) + valDr; tAsset += valDr; }
        else if(type === '부채') { liab[account] = (liab[account] || 0) + valCr; tLiab += valCr; }
        else if(type === '자본') {
            equity[account] = (equity[account] || 0) + valCr;
            tEquity += valCr;
            if(account === '출자금') capital += valCr;
        }
    });

    if (periodData) periodData.forEach(r => {
        const db = Number(r.Debit || 0), cr = Number(r.Credit || 0);
        const valDr = db - cr;
        const valCr = cr - db;
        const account = normalizeAccountName(r.Account);
        const type = normalizeTypeByAccount(r.Type, account);

        if(type === '매출') { rev[account] = (rev[account] || 0) + valCr; tRev += valCr; }
        else if(type === '비용') { exp[account] = (exp[account] || 0) + valDr; tExp += valDr; }
        else if(type === '영업외수익') { otherRev[account] = (otherRev[account] || 0) + valCr; tOtherRev += valCr; }
        else if(type === '자본') {
            if(account === '법정적립금') surplus.legal += cr;
            if(account === '임의적립금') surplus.voluntary += cr;
        }

        if(type === '비용') {
            if(account === '세금과공과' && r.Description && (r.Description.includes('과태료') || r.Description.includes('벌금'))) taxAdjust.fines += db;
            if(account === '접대비') taxAdjust.entertain += db;
            if(account === '기부금') taxAdjust.donations += db;
            if(db > 30000 && r.Evidence_Type === '기타(영수증)') taxAdjust.noProof += db;
        }
    });

    const operatingIncome = tRev - tExp;
    const netIncome = operatingIncome + tOtherRev; 
    const totalLiabEquity = tLiab + tEquity + netIncome;
    
    // 법인세 예상액
    const taxBase = netIncome + taxAdjust.fines;
    const estTax = Math.floor(taxBase * 0.09);

    // 잉여금 처분 계산
    // (처분 전 잉여금 = 당기순이익 + 전기이월) *지금은 전기이월 0 가정
    const totalSurplus = netIncome; 
    const totalAppropriation = surplus.legal + surplus.voluntary;
    const carriedForward = totalSurplus - totalAppropriation;
    const vatReceivable = asset['부가세대급금'] || 0;
    const vatPayable = liab['부가세예수금'] || 0;
    const vatNet = vatPayable - vatReceivable;

    const masterList = masterData || [];
    const codeMap = {};
    const typedCodeMap = {};
    masterList.forEach(m => {
        const type = m.Type || m.type || "";
        const item = m.Item || m.item || "";
        const standard = m.Standard || m.standard || "";
        const code = m.Code || m.code || m.Standard || "-";

        const itemCompact = item.replace(/\s+/g, '');
        const standardCompact = standard.replace(/\s+/g, '');

        if (item && !codeMap[item]) codeMap[item] = code;
        if (itemCompact && !codeMap[itemCompact]) codeMap[itemCompact] = code;
        if (standard && !codeMap[standard]) codeMap[standard] = code;
        if (standardCompact && !codeMap[standardCompact]) codeMap[standardCompact] = code;
        if (type && item && !typedCodeMap[`${type}::${item}`]) typedCodeMap[`${type}::${item}`] = code;
        if (type && standard && !typedCodeMap[`${type}::${standard}`]) typedCodeMap[`${type}::${standard}`] = code;
        if (type && itemCompact && !typedCodeMap[`${type}::${itemCompact}`]) typedCodeMap[`${type}::${itemCompact}`] = code;
        if (type && standardCompact && !typedCodeMap[`${type}::${standardCompact}`]) typedCodeMap[`${type}::${standardCompact}`] = code;
    });

    if (!codeMap['잡이익']) codeMap['잡이익'] = codeMap['기타수익'] || '910';
    if (!codeMap['잡손실']) codeMap['잡손실'] = codeMap['기타비용'] || '960';
    if (!codeMap['부가세대급금']) codeMap['부가세대급금'] = codeMap['매입세액'] || '136';
    if (!codeMap['부가세예수금']) codeMap['부가세예수금'] = codeMap['매출세액'] || '255';

    const toStandard = (m) => (m.Standard || m.standard || "");
    const toCode = (m) => (m.Code || m.code || m.Standard || "");

    function compareMaster(a, b) {
        const aStd = String(a.standard || "");
        const bStd = String(b.standard || "");
        const aNum = Number(aStd.replace(/[^0-9]/g, ""));
        const bNum = Number(bStd.replace(/[^0-9]/g, ""));
        const aHasNum = !Number.isNaN(aNum) && /[0-9]/.test(aStd);
        const bHasNum = !Number.isNaN(bNum) && /[0-9]/.test(bStd);

        if (aHasNum && bHasNum && aNum !== bNum) return aNum - bNum;
        if (aStd !== bStd) return aStd.localeCompare(bStd);
        return a.name.localeCompare(b.name);
    }

    function buildOrdered(type, amounts) {
        const list = [];
        const seen = new Set();
        masterList.filter(m => (m.Type || m.type) === type).forEach(m => {
            const name = m.Item || m.item;
            if (!name || seen.has(name)) return;
            list.push({ name, standard: toStandard(m), code: toCode(m) });
            seen.add(name);
        });
        Object.keys(amounts).forEach(name => {
            if (!seen.has(name)) {
                const compactName = String(name || '').replace(/\s+/g, '');
                const fallbackCode = typedCodeMap[`${type}::${name}`] || typedCodeMap[`${type}::${compactName}`] || codeMap[name] || codeMap[compactName] || "-";
                list.push({ name, standard: "", code: fallbackCode });
                seen.add(name);
            }
        });
        return list.sort(compareMaster);
    }

    const assetList = buildOrdered('자산', asset);
    const liabList = buildOrdered('부채', liab);
    const equityList = buildOrdered('자본', equity);
    const revList = buildOrdered('매출', rev);
    const expList = buildOrdered('비용', exp);
    const otherRevList = buildOrdered('영업외수익', otherRev);

    const e = escapeHtml;
    const renderLines = (list, amounts) => list.map(row => {
        const val = (amounts[row.name] ?? 0);
        return `<div class="d-flex justify-content-between"><span>${e(row.name)}</span><span>${Number(val).toLocaleString()}</span></div>`;
    }).join('');

    const renderPLRows = (list, amounts) => list.map(row => {
        const val = (amounts[row.name] ?? 0);
        const compactName = String(row.name || '').replace(/\s+/g, '');
        const code = codeMap[row.name] || codeMap[compactName] || row.code || "-";
        return `<tr><td class="rpt-indent">${e(row.name)}</td><td class="text-center text-muted text-small">${e(String(code))}</td><td class="rpt-amt">${Number(val).toLocaleString()}</td></tr>`;
    }).join('');

    const headerHtml = `<table class="rpt-header-tbl"><tr><th>회사명</th><td>${e(info.orgName||'')}</td><th>사업자번호</th><td>${e(info.bizNum||'')}</td></tr><tr><th>회계기간</th><td>${e(rangeText)}</td><th>대표자</th><td>${e(info.ceoName||'')}</td></tr><tr><th>출자금</th><td>${capital.toLocaleString()}원</td><th>조합원수</th><td>${memberCount}명</td></tr></table>`;

    const bsHtml = `
