        purpose: purpose, 
        today: new Date().toLocaleDateString('ko-KR', { timeZone: KST_TZ_ADMIN_EMP, year: 'numeric', month: 'long', day: 'numeric' }), 
        chairman: ceoName, 
        compName: compName, 
        compAddr: cleanAddr, 
        contact: companyInfo.company_contact, 
        seal: companyInfo.seal_url 
    };
    
    // 6. 인쇄 서비스 호출
    PrintService.printCert(certData);
}

