    // 2. 생년월일 조회 (기존 로직 유지)
    const { data: birthDate } = await _supabase.rpc('get_emp_birthdate', { p_emp_id: currentEmpId });
    const birthStr = birthDate || "미등록";

    // [핵심 변경] 클라이언트 카운팅 삭제 -> DB RPC 함수 호출로 대체
    // 관리자가 발급하더라도 DB가 순번을 매겨야 안전합니다.
