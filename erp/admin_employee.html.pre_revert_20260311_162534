async function reqDeletePermanent() {
    showConfirm("⚠️ 영구 삭제 경고", `${currentEmpName} 데이터를 모두 삭제하시겠습니까?`, async function() {
        if (reqDeletePermanent._inFlight) return;
        reqDeletePermanent._inFlight = true;
        try {
            detailModal.hide();
            const filePath = document.getElementById("hiddenContractUrl").value;
            if (filePath && !filePath.startsWith('http')) {
                const { error: fileRemoveError } = await _supabase.storage.from('contracts').remove([filePath]);
                if (fileRemoveError) console.warn('계약서 파일 삭제 실패:', fileRemoveError.message);
            }

            const deletions = ['hr_salary', 'hr_leave_adj', 'hr_salary_contracts', 'log_cert', 'ref_employees'];
            for (const tableName of deletions) {
                const { error } = await _supabase.from(tableName).delete().eq('emp_id', currentEmpId);
                if (error) throw new Error(`${tableName} 삭제 실패: ${error.message}`);
            }

            await logHrAudit('hr.employee.delete_permanent', `${currentEmpName} 영구 삭제`, {
                emp_id: currentEmpId,
                contract_removed: !!filePath
            });
            showAlert("삭제되었습니다.");
            loadList();
        } catch (e) {
            showAlert("삭제 실패: " + e.message);
        } finally {
            reqDeletePermanent._inFlight = false;
        }
    });
}
