async function runInvite() {
    if (runInvite._inFlight) {
        showAlert("이미 등록 처리 중입니다. 잠시만 기다려주세요.");
        return;
    }

    const name = document.getElementById("newName").value.trim();
    const email = document.getElementById("newEmail").value.trim();
    if (!name || !email) {
        showAlert("이름/이메일 입력 필요");
        return;
    }

    const submitBtn = document.querySelector('#inviteModal .btn.btn-primary.w-100');
    if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerText = '등록 중...';
    }

    runInvite._inFlight = true;
    try {
        const year = new Date().getFullYear();
        let savedEmpId = null;

        for (let attempt = 1; attempt <= 5; attempt += 1) {
            const { data: latestRows, error: latestErr } = await _supabase
                .from('ref_employees')
                .select('emp_id')
                .like('emp_id', `${year}%`)
                .order('emp_id', { ascending: false })
                .limit(1);
            if (latestErr) throw latestErr;

            let nextSeq = 1;
            if (Array.isArray(latestRows) && latestRows.length > 0 && latestRows[0]?.emp_id) {
                const matched = String(latestRows[0].emp_id).match(new RegExp(`^${year}(\\d{3})$`));
                if (matched) nextSeq = Number(matched[1]) + 1;
            }
            const empId = `${year}${String(nextSeq).padStart(3, '0')}`;

            const { error } = await _supabase.from('ref_employees').insert({
                emp_id: empId,
                emp_name: name,
                email: email,
                position: document.getElementById("newRank").value,
                role: document.getElementById("newRole").value,
                department: document.getElementById("newDept").value,
                hire_date: formatAdminEmployeeKstDate(new Date())
            });

            if (!error) {
                savedEmpId = empId;
                break;
            }

            const code = String(error.code || '');
            const message = String(error.message || '').toLowerCase();
            const details = String(error.details || '').toLowerCase();
            const isEmpIdConflict = code === '23505' && (message.includes('emp_id') || details.includes('emp_id'));
            if (!isEmpIdConflict || attempt === 5) throw error;
        }

        showAlert(`등록됨: ${savedEmpId}`);
        inviteModal.hide();
        loadList();
    } catch (err) {
        showAlert("오류: " + err.message);
    } finally {
        runInvite._inFlight = false;
        if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerText = '등록하기';
        }
    }
}
