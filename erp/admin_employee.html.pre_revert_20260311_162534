function recalcSalaryComponents() {
    const payIds = ['payBasic', 'payMeal', 'payCar', 'payPosition', 'payService', 'payOvertime', 'payChild', 'payBonus'];
    const dedIds = ['dedPension', 'dedHealth', 'dedCare', 'dedEmploy', 'dedIncome', 'dedLocal', 'dedAdvance', 'dedCapital'];
    const payTotal = payIds.reduce((sum, id) => sum + (Number(document.getElementById(id)?.value) || 0), 0);
    const dedTotal = dedIds.reduce((sum, id) => sum + (Number(document.getElementById(id)?.value) || 0), 0);
    document.getElementById("payTotalFixed").value = payTotal;
    document.getElementById("dedTotalDisplay").value = dedTotal;
    document.getElementById("netPayDisplay").value = payTotal - dedTotal;
}

async function saveSalary() {
    const month = document.getElementById("salaryMonth").value; 
    if (!month) return showAlert("귀속월을 선택해주세요.");
    if (!currentEmpId) return showAlert("직원 정보가 없어 저장할 수 없습니다.");

    const payload = {
        coop_id: myInfo?.coop_id || null,
        emp_id: currentEmpId,
        emp_name: currentEmpName,
        year_month: month,
        pay_basic: Number(document.getElementById("payBasic").value) || 0,
        pay_meal: Number(document.getElementById("payMeal").value) || 0,
        pay_car: Number(document.getElementById("payCar").value) || 0,
        pay_position: Number(document.getElementById("payPosition").value) || 0,
        pay_service: Number(document.getElementById("payService").value) || 0,
        pay_overtime: Number(document.getElementById("payOvertime").value) || 0,
        pay_child: Number(document.getElementById("payChild").value) || 0,
        pay_bonus: Number(document.getElementById("payBonus").value) || 0,
        ded_pension: Number(document.getElementById("dedPension").value) || 0,
        ded_health: Number(document.getElementById("dedHealth").value) || 0,
        ded_care: Number(document.getElementById("dedCare").value) || 0,
        ded_employ: Number(document.getElementById("dedEmploy").value) || 0,
        ded_income: Number(document.getElementById("dedIncome").value) || 0,
        ded_local: Number(document.getElementById("dedLocal").value) || 0,
        ded_advance: Number(document.getElementById("dedAdvance").value) || 0,
        ded_capital: Number(document.getElementById("dedCapital").value) || 0
    };

    payload.pay_total =
        payload.pay_basic +
        payload.pay_meal +
        payload.pay_car +
        payload.pay_position +
        payload.pay_service +
        payload.pay_overtime +
        payload.pay_child +
        payload.pay_bonus;
    payload.ded_total =
        payload.ded_pension +
        payload.ded_health +
        payload.ded_care +
        payload.ded_employ +
        payload.ded_income +
        payload.ded_local +
        payload.ded_advance +
        payload.ded_capital;
    payload.net_pay = payload.pay_total - payload.ded_total;

    const { data: existing } = await _supabase
        .from('hr_salary')
        .select('id')
        .eq('emp_id', currentEmpId)
        .eq('year_month', month)
        .maybeSingle();

    const { error } = existing
        ? await _supabase.from('hr_salary').update(payload).eq('id', existing.id)
        : await _supabase.from('hr_salary').insert(payload);

    if (error) {
        showAlert("실패: " + error.message);
        return;
    }

    currentSalaryDataForPrint = { ...payload };
    showAlert(`${month} 급여 저장이 완료되었습니다.`);
    await loadSalaryData();
}

// [수정] 관리자용 연차 조회 (특정 직원 + 결재완료 예정 차감 반영)
async function loadLeave() { 
    try {
        if (window.LeaveLedger && typeof window.LeaveLedger.getLeaveSnapshot === 'function') {
            const snapshot = await window.LeaveLedger.getLeaveSnapshot(_supabase, currentEmpId, {
                reservedStatuses: ['완료', '가승인', '증빙확인중', '실물결재대기', '실물결재완료'],
                includeToday: true,
                unknownAsReserved: false
            });
            const remain = Number(snapshot?.effectiveRemainDays || 0);
            const reserved = Number(snapshot?.reservedDays || 0);
            document.getElementById("displayLeaveRemain").innerText = remain + "일";
            const reservedEl = document.getElementById("displayLeaveReserved");
            if (reservedEl) reservedEl.innerText = `결재 반영 예정 ${reserved}일`;
            return;
        }
    } catch (error) {
        console.error(error);
    }

    // 공통 모듈 미사용/오류 시 기존 RPC로 폴백
