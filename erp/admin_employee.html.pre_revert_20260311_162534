    btnSave.innerText = "💾 급여 저장";
    btnSave.classList.remove("btn-warning");
    btnSave.classList.add("btn-success");
    
    if (!month || !currentEmpId) {
        ['payBasic','payMeal','payCar','payPosition','payService','payOvertime','payChild','payBonus','dedPension','dedHealth','dedCare','dedEmploy','dedIncome','dedLocal','dedAdvance','dedCapital','payTotalFixed','dedTotalDisplay','netPayDisplay'].forEach((id) => {
