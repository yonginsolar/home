        document.getElementById("dedIncome").value = saved.ded_income || 0;
        document.getElementById("dedLocal").value = saved.ded_local || 0;
        document.getElementById("dedAdvance").value = saved.ded_advance || 0;
        document.getElementById("dedCapital").value = saved.ded_capital || 0;
        
        badge.innerText = "저장됨";
        badge.className = "badge bg-primary";
        btnDelete.classList.remove("d-none");
        btnSave.innerText = "💾 수정 저장";
