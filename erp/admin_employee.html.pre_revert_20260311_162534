// ---------------------------------------------------------
// [분석 1] 결재 효율성 (소요시간)
// ---------------------------------------------------------
function renderEfficiencyStats(list) {
    // 1) 데이터 가공
    let monthlyData = {}; // 월별 {총시간, 건수}
    let approverStats = {}; // 결재자별 {총시간, 건수}

    list.forEach(doc => {
        if(doc.status !== '완료') return; // 완료된 건만 분석
        
        // JSON 파싱: approval_line 확인
        if(!doc.approval_line || !Array.isArray(doc.approval_line)) return;

        // 최종 승인자 찾기 (status가 '승인'인 마지막 사람)
        // filter를 쓰는 이유: 중간에 '참조'나 '대기'가 섞일 수 있으므로 확실한 승인자만 추출
        const approvers = doc.approval_line.filter(l => l.status === '승인' && l.processed_at);
        if(approvers.length === 0) return;

        const lastApprover = approvers[approvers.length - 1];
        
        const start = new Date(doc.created_at);
        const end = new Date(lastApprover.processed_at);
        const diffHours = (end - start) / (1000 * 60 * 60); // 시간 단위 변환

        // 월별 집계
        const monthKey = doc.created_at.slice(0, 7); // YYYY-MM
        if(!monthlyData[monthKey]) monthlyData[monthKey] = { sum: 0, count: 0 };
        monthlyData[monthKey].sum += diffHours;
        monthlyData[monthKey].count++;

        // 결재자별 집계 (개인별 평균 시간)
        approvers.forEach(who => {
            if(!who.processed_at) return;
            // 결재자가 받은 시점부터 처리한 시점까지 알기는 어려우므로(도착시간 데이터 부재),
            // 여기서는 '전체 리드타임'에 대한 기여도로 단순화하지 않고
            // "최종 승인자" 기준이 아닌, 모든 승인자의 이력을 카운트합니다.
            // *정확도 향상: 본인이 승인한 건수 카운트
            if(!approverStats[who.name]) approverStats[who.name] = { sum: 0, count: 0 };
            // 여기선 단순히 본인이 포함된 문서의 전체 리드타임을 넣기보다, 처리 건수 위주로 봅니다.
            // 하지만 '병목'을 찾으려면 processed_at이 중요하므로, 
            // 여기서는 심플하게 '내가 결재한 문서들의 처리시간'을 일단 누적합니다.
            // (더 정밀한 분석은 '도착일시' 칼럼이 필요함)
            approverStats[who.name].sum += diffHours; 
            approverStats[who.name].count++;
        });
    });

    // 2) 차트 데이터 준비
    const labels = Object.keys(monthlyData).sort();
    const values = labels.map(m => (monthlyData[m].sum / monthlyData[m].count).toFixed(1));

    // 이번 달 평균 표시
    const thisMonth = formatAdminEmployeeKstMonth();
    const currData = monthlyData[thisMonth];
    document.getElementById("valAvgTime").innerText = currData ? (currData.sum / currData.count).toFixed(1) + "시간" : "-";

    // 3) 차트 그리기
    drawChart('chartTime', 'line', {
        labels: labels,
        datasets: [{
            label: '평균 소요시간 (시간)',
            data: values,
            borderColor: '#0d6efd',
            backgroundColor: 'rgba(13, 110, 253, 0.1)',
            tension: 0.3,
            fill: true
        }]
    });

    // 4) 백데이터 테이블 (결재가 늦은 순위 - 평균값이 높은 순)
    // *정확한 병목 분석을 위해선 '도착->승인' 갭이 필요하지만, 현재 데이터로는 '전체 리드타임' 평균으로 대체
    const rank = Object.keys(approverStats).map(name => ({
        name: name,
        avg: (approverStats[name].sum / approverStats[name].count).toFixed(1),
        count: approverStats[name].count
    })).sort((a, b) => b.avg - a.avg).slice(0, 5); // Top 5

    document.getElementById("tblSlowApprover").innerHTML = rank.map((r, i) => 
        `<tr><td>${i+1}</td><td class="fw-bold">${r.name}</td><td>${r.avg}시간</td><td>${r.count}건</td></tr>`
    ).join("");
}

// ---------------------------------------------------------
// [분석 2] 반려 현황 (사유 분석)
// ---------------------------------------------------------
function renderRejectionStats(list) {
    let rejectReasons = {};
    let rejectors = {};

    list.forEach(doc => {
        if(doc.status !== '반려') return;

        // JSON 파싱
        if(!doc.approval_line || !Array.isArray(doc.approval_line)) return;
        
        // 누가 반려했는지 찾기
        const rejecterObj = doc.approval_line.find(l => l.status === '반려');
        if(rejecterObj) {
            // 반려자 카운트
            rejectors[rejecterObj.name] = (rejectors[rejecterObj.name] || 0) + 1;

            // 사유 키워드 추출 (간단한 공백 분리)
            const comment = rejecterObj.comment || "사유없음";
            // 간단하게 전체 문장을 카운트하거나, 핵심 단어만 추출
            // 여기서는 '사유 내용' 자체를 그룹화합니다. (너무 길면 앞 10글자만)
            const key = comment.length > 10 ? comment.slice(0, 10) + "..." : comment;
            rejectReasons[key] = (rejectReasons[key] || 0) + 1;
        }
    });

    // 1) 반려 사유 차트 (도넛)
    const reasonLabels = Object.keys(rejectReasons).sort((a, b) => rejectReasons[b] - rejectReasons[a]).slice(0, 5);
    const reasonValues = reasonLabels.map(k => rejectReasons[k]);

    drawChart('chartRejectReason', 'doughnut', {
        labels: reasonLabels,
        datasets: [{
            data: reasonValues,
            backgroundColor: ['#ff6384', '#36a2eb', '#ffce56', '#4bc0c0', '#9966ff']
        }]
    });

    // 2) 반려자 랭킹 테이블
    const sortedRejectors = Object.keys(rejectors).map(name => ({ name, count: rejectors[name] }))
        .sort((a, b) => b.count - a.count).slice(0, 5);

    document.getElementById("tblRejectKing").innerHTML = sortedRejectors.map(r => 
        `<tr><td class="fw-bold">${r.name}</td><td>${r.count}건</td><td><div class="progress" style="height: 6px;"><div class="progress-bar bg-danger" style="width: ${Math.min(r.count*10, 100)}%"></div></div></td></tr>`
    ).join("");
}

// ---------------------------------------------------------
// [분석 3] 자금 흐름 (인건비 vs 지출결의)
// ---------------------------------------------------------
function renderFinanceStats(appList, salaryList) {
    let financeData = {}; // Key: YYYY-MM, Value: { labor: 0, expense: 0 }

    // 1) 인건비 집계 (hr_salary)
    salaryList.forEach(s => {
        const ym = s.year_month; // YYYY-MM
        if(!financeData[ym]) financeData[ym] = { labor: 0, expense: 0 };
        financeData[ym].labor += Number(s.pay_total); // 지급 총액 기준
    });

    // 2) 일반지출 집계 (ref_approval)
    appList.forEach(doc => {
        if(doc.status !== '완료') return;
        // doc_type에 '지출'이 포함된 것만 (휴가 등 제외)
        if(doc.doc_type && doc.doc_type.includes('지출')) {
            const ym = doc.created_at.slice(0, 7);
            if(!financeData[ym]) financeData[ym] = { labor: 0, expense: 0 };
            financeData[ym].expense += Number(doc.amount);
        }
    });

    // 정렬 (최근 6개월)
    const keys = Object.keys(financeData).sort().slice(-6); 
    const laborArr = keys.map(k => financeData[k].labor);
    const expArr = keys.map(k => financeData[k].expense);

    // 3) 차트 그리기 (스택 막대)
    drawChart('chartFinance', 'bar', {
        labels: keys,
        datasets: [
            { label: '인건비', data: laborArr, backgroundColor: '#4bc0c0', stack: 'Stack 0' },
            { label: '일반지출', data: expArr, backgroundColor: '#ff9f40', stack: 'Stack 0' }
        ]
    });

    // 4) 백데이터 테이블
    document.getElementById("tblFinanceBack").innerHTML = keys.map(k => {
        const l = financeData[k].labor;
        const e = financeData[k].expense;
        const total = l + e;
        const ratio = total > 0 ? ((l / total) * 100).toFixed(1) : 0;
        return `<tr><td>${k}</td><td>${l.toLocaleString()}</td><td>${e.toLocaleString()}</td><td class="fw-bold">${total.toLocaleString()}</td><td class="text-primary">${ratio}%</td></tr>`;
    }).join("");
}

// [공통] 차트 그리기 헬퍼 함수
function drawChart(canvasId, type, dataConfig) {
    const ctx = document.getElementById(canvasId).getContext('2d');
    
    // 기존 차트가 있으면 삭제 (중복 겹침 방지)
    if(charts[canvasId]) {
        charts[canvasId].destroy();
    }

    charts[canvasId] = new Chart(ctx, {
        type: type,
        data: dataConfig,
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom' }
            },
            scales: type === 'bar' || type === 'line' ? {
                y: { beginAtZero: true }
            } : {}
        }
    });
}
  // [공통] 조합원 번호 입력 시 자동 하이픈 (2025-24-0002)
function autoHyphenMemberId(target) {
    let val = target.value.replace(/[^0-9]/g, ''); // 숫자 외 제거
    if (val.length > 10) val = val.substring(0, 10); // 최대 10자리 제한

    if (val.length > 6) {
        val = val.replace(/(\d{4})(\d{2})(\d{1,4})/, '$1-$2-$3');
    } else if (val.length > 4) {
        val = val.replace(/(\d{4})(\d{1,2})/, '$1-$2');
    }
    target.value = val;
}
