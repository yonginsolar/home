    let tenureStr = "-";
    if(hireDate && hireDate !== '-') {
        const join = new Date(hireDate); 
        const now = new Date(); 
        const diff = now - join; 
        const y = Math.floor(diff / (1000*60*60*24*365)); 
        const m = Math.floor((diff % (1000*60*60*24*365)) / (1000*60*60*24*30)); 
        tenureStr = `${hireDate}~현재 (${y}년 ${m}개월)`;
    }
    
    // 4. 회사 정보 준비
