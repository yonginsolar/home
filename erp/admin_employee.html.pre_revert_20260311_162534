        document.getElementById("dedPension").value = 0;
        document.getElementById("dedHealth").value = 0;
        document.getElementById("dedCare").value = 0;
        document.getElementById("dedEmploy").value = 0;
        document.getElementById("dedIncome").value = 0;
        document.getElementById("dedLocal").value = 0;
