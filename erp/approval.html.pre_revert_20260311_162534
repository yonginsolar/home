}

function applyApprovalVisualFormat(beforeTag) {
    const visual = getApprovalVisualEditor();
    if (!visual) return false;
    visual.focus();
    ensureApprovalVisualSelection(visual);

    if (beforeTag === '<h3>') document.execCommand('formatBlock', false, 'h3');
    else if (beforeTag === '<p>') document.execCommand('formatBlock', false, 'p');
    else if (beforeTag === '<strong>') document.execCommand('bold', false, null);
    else if (beforeTag === '<ul><li>') document.execCommand('insertUnorderedList', false, null);
    else if (beforeTag === '<ol><li>') document.execCommand('insertOrderedList', false, null);
    else if (beforeTag === '<br>') document.execCommand('insertHTML', false, '<br>');
    else if (beforeTag === '<table>') document.execCommand('insertHTML', false, buildDefaultTableHtml());
    else return false;

    syncApprovalSourceFromVisual();
    return true;
}

window.insertApprovalTag = (before, after = '') => {
