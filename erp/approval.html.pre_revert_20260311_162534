function escapeHtml(value) {
    if (value === null || value === undefined) return '';
    return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}
function sanitizeOrKeyword(value) {
    return String(value ?? '')
        .replace(/[,%()]/g, ' ')
        .replace(/["'`]/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();
}

const APPROVAL_NOTICE_MEMO_START = '[[APPROVAL_NOTE]]';
const APPROVAL_NOTICE_MEMO_END = '[[/APPROVAL_NOTE]]';

function splitNoticeApprovalContent(rawContent) {
    const raw = String(rawContent || '');
    const startIdx = raw.indexOf(APPROVAL_NOTICE_MEMO_START);
    const endIdx = startIdx >= 0 ? raw.indexOf(APPROVAL_NOTICE_MEMO_END, startIdx + APPROVAL_NOTICE_MEMO_START.length) : -1;

    if (startIdx < 0 || endIdx < 0 || endIdx < startIdx) {
        return {
            approvalMemo: '',
            publicBody: raw.trim()
        };
    }

    const memoRaw = raw.slice(startIdx + APPROVAL_NOTICE_MEMO_START.length, endIdx);
    const head = raw.slice(0, startIdx).trim();
    const tail = raw.slice(endIdx + APPROVAL_NOTICE_MEMO_END.length).trim();
    const publicBody = [head, tail].filter(Boolean).join('\n\n').trim();

    return {
        approvalMemo: memoRaw.trim(),
        publicBody
    };
}

function composeNoticeApprovalContent(publicBody, approvalMemo) {
    const body = String(publicBody || '').trim();
    const memo = String(approvalMemo || '').trim();
    if (!memo) return body;
    if (!body) {
        return `${APPROVAL_NOTICE_MEMO_START}\n${memo}\n${APPROVAL_NOTICE_MEMO_END}`;
    }
    return `${APPROVAL_NOTICE_MEMO_START}\n${memo}\n${APPROVAL_NOTICE_MEMO_END}\n\n${body}`;
}

function hasHtmlTag(value) {
    return /<\s*\/?\s*[a-zA-Z][^>]*>/.test(String(value || ''));
}

function sanitizeApprovalStyle(rawStyle) {
    const style = String(rawStyle || '');
    if (!style.trim()) return '';
    const blockedValue = /(expression\s*\(|javascript:|vbscript:|data:text\/html|@import|behavior:|-moz-binding)/i;
    const safeRules = [];
    style.split(';').forEach(rule => {
        const idx = rule.indexOf(':');
        if (idx <= 0) return;
        const prop = rule.slice(0, idx).trim().toLowerCase();
        const value = rule.slice(idx + 1).trim();
        if (!prop || !value) return;
        if (!/^[a-z-]+$/.test(prop)) return;
        if (blockedValue.test(value)) return;
        safeRules.push(`${prop}: ${value}`);
    });
    return safeRules.join('; ');
}

function sanitizeApprovalUrl(rawUrl) {
    const input = String(rawUrl || '').trim();
    if (!input) return '';
    if (input.startsWith('#')) return '#';
    if (/^data:image\/[a-zA-Z0-9.+-]+;base64,[a-zA-Z0-9+/=\s]+$/i.test(input)) return input;
    try {
        const parsed = new URL(input, window.location.origin);
        if (['http:', 'https:', 'mailto:', 'tel:'].includes(parsed.protocol)) return parsed.href;
    } catch (_) {
        return '';
    }
    return '';
}

function sanitizeApprovalHtml(rawHtml) {
    const source = String(rawHtml || '');
    if (!source.trim()) return '';

    const parser = new DOMParser();
    const doc = parser.parseFromString(`<div>${source}</div>`, 'text/html');
    const root = doc.body.firstElementChild || doc.body;
    const blockedTags = new Set(['SCRIPT', 'STYLE', 'IFRAME', 'OBJECT', 'EMBED', 'META', 'LINK']);

    Array.from(root.querySelectorAll('*')).forEach(node => {
        const tag = node.tagName.toUpperCase();
        if (blockedTags.has(tag)) {
            node.remove();
            return;
        }

        Array.from(node.attributes).forEach(attr => {
            const name = String(attr.name || '').toLowerCase();
            if (name.startsWith('on') || name === 'srcdoc') {
                node.removeAttribute(attr.name);
                return;
            }
            if (name === 'style') {
                const safeStyle = sanitizeApprovalStyle(attr.value);
                if (safeStyle) node.setAttribute('style', safeStyle);
                else node.removeAttribute(attr.name);
                return;
            }
            if (name === 'href' || name === 'src' || name === 'xlink:href' || name === 'formaction') {
                const safeUrl = sanitizeApprovalUrl(attr.value);
                if (safeUrl) node.setAttribute(attr.name, safeUrl);
                else node.removeAttribute(attr.name);
                }
        });

        if (tag === 'A' && node.getAttribute('target') === '_blank') {
            node.setAttribute('rel', 'noopener noreferrer');
        }
    });

    return root.innerHTML;
}

function renderApprovalContent(rawValue, allowHtml = false) {
    const raw = String(rawValue || '');
    const trimmed = raw.trim();
    if (!trimmed) return '';
    if (allowHtml && hasHtmlTag(trimmed)) return sanitizeApprovalHtml(trimmed);
    return escapeHtml(trimmed).replace(/\n/g, '<br>');
}

function mergeSystemAppendContent(baseContent, appendContent, allowHtml = false) {
    const base = String(baseContent || '');
    const extra = String(appendContent || '');
    if (!extra) return base;
    if (allowHtml && hasHtmlTag(base)) {
        const noteHtml = escapeHtml(extra.trim()).replace(/\n/g, '<br>');
        return `${base}\n<p>${noteHtml}</p>`;
    }
    return `${base}${extra}`;
}

