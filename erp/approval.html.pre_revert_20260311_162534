function toKoreanWonText(value) {
    const number = Math.floor(Math.abs(Number(value || 0)));
    if (!Number.isFinite(number) || number === 0) return '영원';

    const digits = ['', '일', '이', '삼', '사', '오', '육', '칠', '팔', '구'];
    const smallUnits = ['', '십', '백', '천'];
    const largeUnits = ['', '만', '억', '조'];

    const convertChunk = (chunk) => {
        let out = '';
        for (let i = 0; i < 4; i += 1) {
            const div = Math.pow(10, 3 - i);
            const digit = Math.floor(chunk / div) % 10;
            if (!digit) continue;
            if (!(digit === 1 && div !== 1)) out += digits[digit];
            out += smallUnits[3 - i];
        }
        return out;
    };

    let remain = number;
    let unitIdx = 0;
    let textOut = '';
    while (remain > 0 && unitIdx < largeUnits.length) {
        const chunk = remain % 10000;
        if (chunk) textOut = `${convertChunk(chunk)}${largeUnits[unitIdx]}${textOut}`;
        remain = Math.floor(remain / 10000);
        unitIdx += 1;
    }

    return `${textOut}원`;
}

