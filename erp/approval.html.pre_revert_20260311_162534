<!DOCTYPE html>
<!-- Version: v1.1.31 | Change: 2026-03-10 - 완료 문서 제목 클릭 시 결재 내용을 모달로 조회하도록 개선. -->
<html lang="ko">
<head>
  <script>console.log('[Version] v1.1.31 | approval.html');</script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>전자결재 (Final)</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="erp_runtime_guard.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/html2pdf.js@0.10.1/dist/html2pdf.bundle.min.js"></script>
  <script src="payroll_durunuri_module.js"></script>
  <script src="salary_ledger_module.js"></script>
  <script src="leave_ledger.js"></script>
  
  <style>
    body { background-color: #f8f9fa; padding: 20px; font-family: 'Segoe UI', 'Malgun Gothic', sans-serif; }
    .main-container { max-width: 900px; margin: 0 auto; background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); padding: 30px; }
    .hidden { display: none !important; }
    
    /* 결재선 스타일 */
    .line-step { display: inline-block; background: #e3f2fd; color: #0d47a1; padding: 5px 12px; border-radius: 20px; margin-right: 5px; margin-bottom: 5px; font-size: 0.9rem; border: 1px solid #bbdefb; }
    .line-arrow { margin-right: 5px; color: #999; font-weight: bold; }
    .ref-step { display: inline-block; background: #f1f3f5; color: #495057; padding: 5px 10px; border-radius: 5px; margin-right: 5px; margin-bottom: 5px; font-size: 0.85rem; border: 1px solid #dee2e6; }
    
    .user-select-item { cursor: pointer; transition: 0.2s; }
    .user-select-item:hover { background-color: #f8f9fa; }
    .user-select-item.active { background-color: #e8f0fe; border-color: #4285f4; }
    .large-textarea { min-height: 500px; resize: vertical; line-height: 1.6; } /* 요청하신 대로 20줄 이상 확보 */
    
    .file-item { font-size: 0.9rem; background: #f8f9fa; padding: 8px 12px; border-radius: 6px; margin-bottom: 4px; border: 1px solid #eee; }
    .file-size { font-size: 0.8rem; color: #888; float: right; }
    .html-preview-box {
      min-height: 280px;
      max-height: 65vh;
      overflow-y: auto;
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      padding: 14px;
      background: #fff;
      line-height: 1.7;
    }
    .html-preview-box h1, .html-preview-box h2, .html-preview-box h3, .html-preview-box h4 { margin-top: 0.8rem; margin-bottom: 0.5rem; }
    .html-preview-box p { margin-bottom: 0.6rem; }
    .html-preview-box ul, .html-preview-box ol { margin-bottom: 0.8rem; padding-left: 1.25rem; }
    .approval-editor-toolbar { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0; }
    .approval-editor-tabs { display: flex; gap: 8px; margin: 6px 0 10px; }
    .approval-editor-panel { display: none; }
    .approval-editor-panel.active { display: block; }
    .approval-visual-editor {
      min-height: 500px;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      padding: 12px;
      line-height: 1.65;
      background: #fff;
      overflow: auto;
      color: #1f2937;
    }
    .approval-visual-editor:focus {
      outline: none;
      border-color: #93c5fd;
      box-shadow: 0 0 0 3px rgba(147, 197, 253, 0.35);
    }
    .approval-visual-editor:empty::before {
      content: attr(data-placeholder);
      color: #94a3b8;
      pointer-events: none;
    }
    .history-filter-btn.active {
      background: #0d6efd;
      color: #fff;
      border-color: #0d6efd;
    }
    .history-filter-select {
      min-width: 140px;
    }
    .delegate-banner {
      border: 1px solid #dbeafe;
      background: #eff6ff;
      border-radius: 10px;
      padding: 10px 12px;
      margin-bottom: 12px;
    }
  </style>
</head>
<body>

<div class="main-container">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold m-0">⚡ 전자결재 시스템</h4> 
    <div class="d-flex gap-2">
      <button class="btn btn-outline-primary btn-sm" onclick="openDelegationModal()">🧭 결재 위임</button>
      <button class="btn btn-outline-secondary btn-sm" onclick="location.href='index.html'">🏠 메뉴로</button>
    </div>
  </div>

  <ul class="nav nav-pills nav-fill mb-4">
    <li class="nav-item"><button class="nav-link active" id="tab1" onclick="switchTab('draft')">✍️ 기안 작성</button></li>
    <li class="nav-item"><button class="nav-link" id="tab2" onclick="switchTab('todo')">📬 결재 대기함</button></li>
    <li class="nav-item"><button class="nav-link" id="tab3" onclick="switchTab('history')">🗂️ 문서 보관함</button></li>
  </ul>

  <div id="delegateBanner" class="delegate-banner hidden"></div>

  <div id="view-draft">
    <form id="draftForm" onsubmit="handleDraftSubmit(event)">
      
      <div class="d-flex justify-content-end mb-2">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="chkProxy" onchange="toggleProxyMode()">
            <label class="form-check-label small fw-bold text-primary" for="chkProxy">🔄 대리 상신 모드</label>
        </div>
      </div>

      <div class="mb-3 hidden" id="divProxyTarget">
        <label class="small text-muted fw-bold">기안 대상자 (하급자)</label>
        <select class="form-select" id="proxyTargetSelect" onchange="calculateLeave(); updateJeongyeolUi();">
            </select>
      </div>

      <div class="mb-3 hidden" id="secretaryMonthlyReportPanel">
        <label class="small text-muted fw-bold">전결 월간보고 (사무국장 전용)</label>
        <div class="card p-3 border-0 bg-light">
          <div class="row g-2 align-items-end">
            <div class="col-md-5">
              <label class="small text-muted fw-bold mb-1">보고월</label>
              <input type="month" class="form-control form-control-sm" id="jeongyeolReportMonth">
            </div>
            <div class="col-md-7">
              <button type="button" class="btn btn-outline-primary btn-sm w-100" id="btnBuildJeongyeolMonthlyDraft" onclick="buildJeongyeolMonthlyDraft()">
                📘 전결 월간보고 초안 만들기
              </button>
            </div>
          </div>
          <div class="small text-muted mt-2">초안 생성 후 결재선을 확인하고 상신하세요. 동일 월 보고서는 1건만 생성됩니다.</div>
        </div>
      </div>

      <div class="row mb-3">
        <div class="col-12 mb-3">
          <label class="small text-muted fw-bold">결재 구분</label>
          <select class="form-select" id="appCategory" onchange="handleCategoryChange()">
            <optgroup label="회계/지출">
                <option value="일반품의">📄 일반품의서</option>
                <option value="지출결의">💰 지출결의서</option>
            </optgroup>
            <optgroup label="인사/근태">
                <option value="휴가">🏖️ 휴가 신청</option>
            </optgroup>
            <optgroup label="대외/공지">
                <option value="공문">📢 공문</option>
            </optgroup>
          </select>
        </div>

        <div class="col-12 hidden mb-3" id="divLeaveType">
            <label class="small text-muted fw-bold">휴가 종류</label>
            <select class="form-select" id="leaveTypeSelect" onchange="handleCategoryChange()">
                <option value="연차">🟢 연차 (잔여 연차 차감)</option>
                <option value="반차">🌗 반차 (0.5일 차감)</option>
                <option value="생일반차">🎂 생일반차 (차감 X)</option>
                <option value="생리휴가">🌸 생리휴가 (무급, 차감 X)</option>
                <option value="경조사">💍 경조사 (증빙필수, 차감 X)</option>
                <option value="병가">🏥 병가 (증빙필수, 차감 X)</option>
                <option value="예비군">🪖 예비군/민방위 (차감 X)</option>
            </select>
        </div>

        <div class="col-12 mb-3 hidden" id="divRelDoc">
          <label class="small text-muted fw-bold">관련 근거 (품의서)</label>
          <div class="card p-3 border-0 bg-light">
             <div class="d-flex align-items-center justify-content-between">
                 <span id="relDocName" class="text-muted small">선택된 관련 문서가 없습니다.</span>
                 <button type="button" class="btn btn-sm btn-outline-dark" onclick="openRelSearch()">🔍 문서 찾기</button>
             </div>
             <input type="hidden" id="relDocId">
          </div>
        </div>
        <div class="col-12 mb-3 hidden" id="divSalaryExpense">
          <label class="small text-muted fw-bold">지출 상세</label>
          <div class="card p-3 border-0 bg-light">
            <div class="row g-2">
              <div class="col-sm-4">
                <select class="form-select form-select-sm" id="expenseSubType" onchange="handleExpenseSubTypeChange()">
                  <option value="일반">일반 지출</option>
                  <option value="급여">급여 (급여대장 연동)</option>
                </select>
              </div>
              <div class="col-sm-4 hidden" id="divPayrollMonth">
                <input type="month" class="form-control form-control-sm" id="payrollMonth" onchange="handlePayrollMonthChange()">
              </div>
              <div class="col-sm-4 hidden" id="divPayrollLoad">
                <button type="button" class="btn btn-sm btn-outline-primary w-100" id="btnLoadPayroll" onclick="loadSalaryLedgerForExpense()">📊 급여대장 불러오기</button>
              </div>
              <div class="col-12">
                <div id="payrollSummary" class="small text-muted">급여 연동을 선택하면 선택한 월의 실지급 합계가 자동 반영됩니다.</div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-12 hidden mb-3" id="divNoticeReceiver">
          <label class="small text-muted fw-bold">수신</label>
          <input type="text" class="form-control" id="noticeReceiver" placeholder="예: 조합원 전체">
        </div>
        <div class="col-12 hidden mb-3" id="divNoticeVia">
          <label class="small text-muted fw-bold">경유</label>
          <input type="text" class="form-control" id="noticeVia" placeholder="-">
        </div>
        <div class="col-12 hidden mb-3" id="divNoticeSubject">
          <label class="small text-muted fw-bold">제목</label>
          <input type="text" class="form-control" id="noticeSubject" placeholder="예: 공문 제목">
        </div>
        <div class="col-12 hidden mb-3" id="divNoticeApprovalMemo">
          <label class="small text-muted fw-bold">결재 요청 메모 (내부용)</label>
          <textarea class="form-control" id="noticeApprovalMemo" rows="3" placeholder="예: 아래 내용으로 공문 발송 결재를 요청드립니다."></textarea>
          <div class="small text-muted mt-1">이 메모는 전자결재 내부에서만 사용되며 문서함 공개 본문에는 포함되지 않습니다.</div>
        </div>
        <div class="col-12 hidden mb-3" id="divProposalSubject">
          <label class="small text-muted fw-bold">품의 제목</label>
          <input type="text" class="form-control" id="proposalSubject" placeholder="예: 2026년 2월 사무국 운영비 집행 건">
        </div>
        <div class="col-12" id="divAmount">
          <label class="small text-muted" id="amountLabel">금액 (원)</label>
          <input type="number" class="form-control" id="appAmount" placeholder="0">
        </div>

        <div class="col-12 hidden" id="divLeaveSection">
          <div class="p-3 bg-light border rounded">
            <div id="dateRangeArea">
                <div class="d-flex justify-content-between mb-2">
                  <span class="fw-bold">📅 기간 선택</span>
                  <span class="badge bg-primary">잔여 연차: <span id="remainDaysBadge">조회중...</span>일</span>
                </div>
                <div class="input-group mb-2">
                  <input type="date" class="form-control" id="leaveStart" onchange="calcLeaveDays()">
                  <span class="input-group-text">~</span>
                  <input type="date" class="form-control" id="leaveEnd" onchange="calcLeaveDays()">
                </div>
            </div>

            <div id="halfDayArea" class="hidden">
                <div class="d-flex justify-content-between mb-2">
                    <span class="fw-bold">📅 반차 날짜</span>
                    <span class="badge bg-primary">잔여 연차: <span id="remainDaysBadgeHalf">0</span>일</span>
                </div>
                <div class="input-group mb-2">
                    <input type="date" class="form-control" id="halfDate" onchange="calcLeaveDays()">
                    <div class="input-group-text bg-white">
                        <input type="radio" class="btn-check" name="ampm" id="am" value="오전" checked>
                        <label class="btn btn-sm btn-outline-secondary mb-0" for="am">오전</label>
                        <input type="radio" class="btn-check" name="ampm" id="pm" value="오후" class="ms-1">
                        <label class="btn btn-sm btn-outline-secondary mb-0 ms-1" for="pm">오후</label>
                    </div>
                </div>
            </div>

            <div class="text-end small text-muted">
              신청 일수: <span id="leaveDaysBadge" class="fw-bold text-dark">0일</span>
              <input type="hidden" id="leaveDaysCalc" value="0">
            </div>
            <div class="small text-muted mt-1">
              결재 반영 예정: <span id="reservedLeaveDaysBadge" class="fw-bold">0</span>일
            </div>
            <div class="text-danger small mt-1 hidden" id="leaveOverMsg">⛔ 잔여 연차가 부족합니다!</div>
          </div>
        </div>
      </div>

      <div class="mb-3" id="jeongyeolSettingPanel">
        <label class="small text-muted fw-bold">전결 설정</label>
        <div class="card p-3 border-0 bg-light mb-2">
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="chkSecretaryJeongyeol" onchange="handleJeongyeolToggleChanged()">
            <label class="form-check-label fw-bold" for="chkSecretaryJeongyeol">사무국장 전결 사용</label>
          </div>
          <div class="small text-muted mt-2" id="jeongyeolHint">자동 전결 규정(30만원 이하 지출결의/근태)을 우선 적용합니다.</div>
        </div>
      </div>

      <div class="mb-3">
        <label class="small text-muted fw-bold">결재선 (필수)</label>
        <div class="card p-3 border-0 bg-light mb-2">
          <div id="linePreview" class="mb-2 text-muted small">결재자를 추가해주세요.</div>
          <div>
            <button type="button" class="btn btn-sm btn-outline-primary" id="btnSelectApprover" onclick="openUserModal('approver')">➕ 결재자 선택</button>
            <button type="button" class="btn btn-sm btn-outline-danger ms-1" id="btnResetApprover" onclick="resetLine('approver')">↺ 초기화</button>
          </div>
        </div>
      </div>

      <div class="mb-3">
        <label class="small text-muted">참조자 (선택)</label>
        <div class="card p-3 border-0 bg-light">
          <div id="refPreview" class="mb-2 text-muted small">참조자가 없습니다.</div>
          <div>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="openUserModal('referrer')">➕ 참조자 선택</button>
            <button type="button" class="btn btn-sm btn-outline-danger ms-1" onclick="resetLine('referrer')">↺ 초기화</button>
          </div>
        </div>
      </div>

      <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center mb-1">
          <label class="small text-muted fw-bold m-0">내용</label>
          <div class="d-flex gap-2">
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="openApprovalTemplatePicker()">📂 지난 양식 불러오기</button>
            <button type="button" class="btn btn-sm btn-outline-secondary hidden" id="btnAppDescPreview" onclick="openAppDescPreview()">👁️ HTML 미리보기</button>
          </div>
        </div>
        <div id="appDescEditorControls" class="hidden">
          <div class="approval-editor-toolbar">
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertApprovalTag('<h3>','</h3>')">제목</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertApprovalTag('<p>','</p>')">문단</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertApprovalTag('<strong>','</strong>')">굵게</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertApprovalTag('<ul><li>','</li></ul>')">목록</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertApprovalTag('<ol><li>','</li></ol>')">번호목록</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertApprovalTag('<table>','</table>')">테이블</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertApprovalTag('<br>','')">줄바꿈</button>
          </div>
          <div class="approval-editor-tabs">
            <button type="button" id="app-desc-tab-visual" class="btn btn-sm btn-primary" onclick="switchApprovalEditorTab('visual')">미리보기 편집</button>
            <button type="button" id="app-desc-tab-html" class="btn btn-sm btn-outline-primary" onclick="switchApprovalEditorTab('html')">HTML 편집</button>
          </div>
        </div>
        <div id="app-desc-panel-visual" class="approval-editor-panel">
          <div id="appDescVisual" class="approval-visual-editor" contenteditable="true" data-placeholder="여기에 내용을 입력하세요."></div>
        </div>
        <div id="app-desc-panel-html" class="approval-editor-panel active">
          <textarea class="form-control large-textarea" id="appDesc" placeholder="내용을 상세히 입력하세요." rows="20"></textarea>
        </div>
        <div class="small text-muted mt-2 hidden" id="appDescHtmlHelp">일반품의/공문은 테이블 포함 HTML 본문을 작성할 수 있습니다. 미리보기 편집 또는 HTML 편집 탭으로 작성하고 제출 전 미리보기로 확인하세요.</div>
      </div>

      <div class="mb-4">
        <label class="small text-muted">증빙 첨부 <span id="fileHelp" class="text-danger small hidden">(가족관계증명서 필수)</span></label>
        <input type="file" class="form-control" id="attachFile" multiple onchange="updateFileList()">
        <div id="fileListArea" class="mt-2"></div>
      </div>

      <button type="submit" class="btn btn-primary w-100 py-3 fw-bold btn-lg" id="btnSubmit">상신하기</button>
    </form>
  </div>

  <div id="view-todo" class="hidden"><div id="todoList" class="list-group"></div></div>
  <div id="view-history" class="hidden">
    <div class="input-group mb-3">
      <input type="text" class="form-control" id="searchKeyword" placeholder="검색" onkeyup="filterHistory()">
      <button class="btn btn-outline-secondary">🔍</button>
      <button class="btn btn-outline-success" onclick="exportHistoryCsv()">⬇ CSV</button>
    </div>
    <div class="d-flex flex-wrap gap-2 mb-3" id="historyStatusFilterBar">
      <button type="button" class="btn btn-sm btn-outline-secondary history-filter-btn active" data-history-filter="ALL" onclick="setHistoryStatusFilter('ALL')">전체 <span class="badge text-bg-light ms-1" id="historyCountAll">0</span></button>
      <button type="button" class="btn btn-sm btn-outline-secondary history-filter-btn" data-history-filter="PENDING" onclick="setHistoryStatusFilter('PENDING')">대기 <span class="badge text-bg-light ms-1" id="historyCountPending">0</span></button>
      <button type="button" class="btn btn-sm btn-outline-secondary history-filter-btn" data-history-filter="DONE" onclick="setHistoryStatusFilter('DONE')">완료 <span class="badge text-bg-light ms-1" id="historyCountDone">0</span></button>
      <button type="button" class="btn btn-sm btn-outline-secondary history-filter-btn" data-history-filter="REJECTED" onclick="setHistoryStatusFilter('REJECTED')">반려 <span class="badge text-bg-light ms-1" id="historyCountRejected">0</span></button>
      <button type="button" class="btn btn-sm btn-outline-secondary history-filter-btn" data-history-filter="CANCELED" onclick="setHistoryStatusFilter('CANCELED')">취소 <span class="badge text-bg-light ms-1" id="historyCountCanceled">0</span></button>
    </div>
    <div class="row g-2 mb-3" id="historyAdvancedFilters">
      <div class="col-sm-4">
        <label class="small text-muted mb-1">문서유형</label>
        <select id="historyDocTypeFilter" class="form-select form-select-sm history-filter-select" onchange="onHistoryAdvancedFilterChange()">
          <option value="ALL">전체</option>
