function extractLeavePeriodLabelFromDoc(doc) {
    const title = String(doc?.title || '').trim();
    const titleMatch = title.match(/\(([^()]+)\)\s*$/);
    if (titleMatch) return String(titleMatch[1] || '').trim();

    const content = String(doc?.content || '');
    const markerMatch = content.match(/(?:^|\n)\s*휴가일\s*[:：]\s*([^\n]+)/);
