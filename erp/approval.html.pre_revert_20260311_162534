async function loadPermissions(user) {
    const result = new Set();
    if (!user) return result;
    const roleKey = user.role || '';
    const posKey = user.position || '';
    if (!roleKey && !posKey) return result;

    const roleKeys = [roleKey, posKey].filter(Boolean);
    if (roleKey === 'admin_all') roleKeys.push('admin');
    if (roleKey === 'admin') roleKeys.push('admin_all');

    const { data } = await _supabase
        .from('erp_role_permissions')
        .select('permission_key')
        .in('scope', ['role', 'position'])
        .in('role_key', roleKeys)
        .eq('is_enabled', true);

    if (Array.isArray(data)) {
        data.forEach(row => {
            if (row.permission_key) result.add(row.permission_key);
        });
    }
    return result;
}

function canPerform(permissionKey) {
    if (!permissionKey) return true;
    if (permissionSet && permissionSet.size > 0) return permissionSet.has(permissionKey);
    return hasApprovalRoleFallback(permissionKey);
}

function canUseSalaryExpense() {
