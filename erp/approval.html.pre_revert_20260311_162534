async function saveDelegationSettings() {
    const enabledEl = document.getElementById('delegationEnabled');
    const targetEl = document.getElementById('delegationTarget');
    const startEl = document.getElementById('delegationStart');
    const endEl = document.getElementById('delegationEnd');
    const reasonEl = document.getElementById('delegationReason');
    const btn = document.getElementById('btnSaveDelegation');

    if (!enabledEl || !targetEl || !startEl || !endEl) return;
    const isEnabled = !!enabledEl.checked;

    if (!isEnabled) {
        await disableDelegationSettings();
        return;
    }

    const startValue = startEl.value ? new Date(startEl.value) : null;
    const endValue = endEl.value ? new Date(endEl.value) : null;
    if (!targetEl.value) return showAlert('위임 대상을 선택하세요.');
    if (!startValue || Number.isNaN(startValue.getTime())) return showAlert('시작 시각을 입력하세요.');
    if (!endValue || Number.isNaN(endValue.getTime())) return showAlert('종료 시각을 입력하세요.');
    if (endValue <= startValue) return showAlert('종료 시각은 시작 시각보다 뒤여야 합니다.');

    if (btn) btn.disabled = true;
    try {
        const { data, error } = await _supabase.rpc('erp_upsert_my_approval_delegation', {
            p_delegate_emp_id: targetEl.value,
            p_start_at: startValue.toISOString(),
            p_end_at: endValue.toISOString(),
            p_reason: reasonEl?.value || null,
            p_is_enabled: true
        });
        if (error) throw error;
        if (!data?.ok) throw new Error(data?.reason || 'SAVE_FAILED');
        showAlert('결재 위임이 저장되었습니다.');
        delegationModalInstance.hide();
        await loadDelegationContext({ refreshTodo: true });
    } catch (e) {
        showAlert('저장 실패: ' + (e?.message || 'unknown error'));
    } finally {
        if (btn) btn.disabled = false;
    }
}

async function disableDelegationSettings() {
    const btn = document.getElementById('btnSaveDelegation');
    if (btn) btn.disabled = true;
    try {
        const { data, error } = await _supabase.rpc('erp_upsert_my_approval_delegation', {
            p_delegate_emp_id: null,
            p_start_at: null,
            p_end_at: null,
            p_reason: null,
            p_is_enabled: false
        });
        if (error) throw error;
        if (!data?.ok) throw new Error(data?.reason || 'DISABLE_FAILED');
        showAlert('결재 위임이 해제되었습니다.');
        if (delegationModalInstance) delegationModalInstance.hide();
        await loadDelegationContext({ refreshTodo: true });
    } catch (e) {
        showAlert('해제 실패: ' + (e?.message || 'unknown error'));
    } finally {
        if (btn) btn.disabled = false;
    }
}

const ATTACHMENT_RULES = {
    maxSizeMB: 10,
    allowedExt: ['pdf', 'png', 'jpg', 'jpeg']
};

function validateAttachments(fileList) {
    if (!fileList || fileList.length === 0) return { ok: true };
    const maxBytes = ATTACHMENT_RULES.maxSizeMB * 1024 * 1024;
    for (const file of fileList) {
        const name = file.name || '';
        const ext = name.includes('.') ? name.split('.').pop().toLowerCase() : '';
        if (ATTACHMENT_RULES.allowedExt.length && !ATTACHMENT_RULES.allowedExt.includes(ext)) {
            return { ok: false, message: `허용되지 않는 파일 형식입니다: ${name}` };
        }
        if (file.size > maxBytes) {
            return { ok: false, message: `파일 용량이 너무 큽니다 (최대 ${ATTACHMENT_RULES.maxSizeMB}MB): ${name}` };
        }
    }
    return { ok: true };
}

