function renderUserList() {
    const listEl = document.getElementById("userSelectList");
    const selCountEl = document.getElementById("selCount");
    listEl.innerHTML = "";
    if (selCountEl) selCountEl.innerText = String(tempSelection.length);
    
    // 나보다 직급 낮은 사람 제외, 본인 제외
    const myLevelRaw = Number(myInfo?.auth_level);
    const myLevel = Number.isFinite(myLevelRaw) ? myLevelRaw : 99;
    let targets = allUsers.filter(u => String(u?.emp_id) !== String(myInfo?.emp_id));
    
    if (modalType === 'approver') {
        // [수정] 상향식 필터링: 나보다 높은 사람(숫자가 작은 사람)만 표시
        // 이미 선택된 사람이 있다면, 그 사람보다 더 높은 사람만 표시
        const selectedLevels = tempSelection
            .map(u => Number(u?.auth_level))
            .filter(v => Number.isFinite(v));
        const currentHighestLevel = (selectedLevels.length > 0)
            ? Math.min(...selectedLevels)
            : myLevel;
            
        targets = targets.filter(u => {
            const level = Number(u?.auth_level);
            return Number.isFinite(level) && level < currentHighestLevel;
        });
    } else {
        targets = targets.filter(u => !finalApprovers.some(a => String(a?.emp_id) === String(u?.emp_id)));
    }

    if (targets.length === 0) {
        if (tempSelection.length > 0 && modalType === 'approver') {
            listEl.innerHTML = '<div class="p-3 text-center text-muted">추가로 선택 가능한 상위 결재자가 없습니다.<br>하단 `선택 완료`를 눌러 확정하세요.</div>';
        } else {
            listEl.innerHTML = '<div class="p-3 text-center text-muted">선택 가능한 대상이 없습니다.</div>';
        }
        return;
    }

    targets.forEach(u => {
        const isSelected = tempSelection.some(s => String(s?.emp_id) === String(u?.emp_id));
        const a = document.createElement("a");
        a.className = `list-group-item list-group-item-action user-select-item d-flex justify-content-between ${isSelected ? 'active' : ''}`;
        const left = document.createElement("div");
        const badge = document.createElement("span");
        badge.className = "badge bg-secondary me-2";
        badge.textContent = u.position || '';
        left.appendChild(badge);
        left.appendChild(document.createTextNode(u.emp_name || ''));
        const small = document.createElement("small");
        small.className = "text-muted";
        small.textContent = `(${u.department || '-'})`;
        left.appendChild(document.createTextNode(" "));
        left.appendChild(small);
        a.appendChild(left);
        if (isSelected) {
            const mark = document.createElement("span");
            mark.textContent = "✅";
            a.appendChild(mark);
        }
        a.onclick = () => toggleSelect(u);
        listEl.appendChild(a);
    });
}

function toggleSelect(user) {
    const idx = tempSelection.findIndex(s => String(s?.emp_id) === String(user?.emp_id));
    if (idx > -1) tempSelection.splice(idx, 1); else tempSelection.push(user);
    renderUserList();
}

function confirmSelection() {
    if (modalType === 'approver') {
        finalApprovers = [...tempSelection];
    } else {
        finalRefs = [...tempSelection];
    }
    modalType==='approver' ? renderLinePreview() : renderRefPreview();
    modalInstance.hide();
}

function renderLinePreview() {
    const el = document.getElementById("linePreview");
    if(finalApprovers.length === 0) { el.innerText = "결재자를 추가해주세요."; return; }
    const lineHtml = finalApprovers.map((u, i) => `<span class="line-step">${escapeHtml(u.emp_name)} ${escapeHtml(u.position)}</span>` + (i < finalApprovers.length-1 ? '<span class="line-arrow">➡</span>' : '')).join("");
    const fixedLabel = escapeHtml(jeongyeolLockReasonLabel || '결재자');
    const lockHint = jeongyeolLineLocked ? `<div class="small text-primary mt-2">전결 적용으로 결재선이 ${fixedLabel}로 고정되었습니다.</div>` : '';
    el.innerHTML = `${lineHtml}${lockHint}`;
}

function renderRefPreview() {
    const el = document.getElementById("refPreview");
    if(finalRefs.length === 0) { el.innerText = "참조자가 없습니다."; return; }
    el.innerHTML = finalRefs.map(u => `<span class="ref-step">📢 ${escapeHtml(u.emp_name)}</span>`).join("");
}
function resetLine(type) {
    if (type === 'approver') {
