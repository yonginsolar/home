    const mode = select?.value || '일반';
    const divMonth = document.getElementById("divPayrollMonth");
    const divLoad = document.getElementById("divPayrollLoad");
    const summary = document.getElementById("payrollSummary");
    const amountLabel = document.getElementById("amountLabel");
    const amountInput = document.getElementById("appAmount");
    const monthInput = document.getElementById("payrollMonth");

    if (mode !== '급여') {
        salaryExpenseState = null;
        if (divMonth) divMonth.classList.add("hidden");
        if (divLoad) divLoad.classList.add("hidden");
        if (summary) {
            summary.className = "small text-muted";
            summary.textContent = "급여 연동을 선택하면 선택한 월의 실지급 합계가 자동 반영됩니다.";
        }
        if (amountLabel) amountLabel.innerText = "금액 (원)";
        if (amountInput) amountInput.placeholder = "0";
        updateJeongyeolUi();
        return;
    }

    if (!canUseSalaryExpense()) {
        if (select) select.value = '일반';
        if (divMonth) divMonth.classList.add("hidden");
        if (divLoad) divLoad.classList.add("hidden");
        updateJeongyeolUi();
        return showAlert("급여 연동은 관리자/회계 권한에서만 사용할 수 있습니다.");
    }

    if (monthInput && !monthInput.value) monthInput.value = formatApprovalKstMonth();
    if (divMonth) divMonth.classList.remove("hidden");
    if (divLoad) divLoad.classList.remove("hidden");
    if (summary) {
        summary.className = "small text-muted";
        summary.textContent = "급여대장을 불러오면 실지급 합계가 금액에 자동 반영됩니다.";
    }
    if (amountLabel) amountLabel.innerText = "실지급 합계 (원)";
    if (amountInput) amountInput.placeholder = "급여대장 불러오기 시 자동 입력";
    const currentDesc = getApprovalEditorContent();
    if (
        !currentDesc.trim()
        || currentDesc.includes("지출하고자 하오니 승인하여")
        || currentDesc.includes("지출결의를 상신하오니 승인하여")
    ) {
        const ymLabel = formatYearMonthLabel(monthInput?.value || '');
        setApprovalEditorContent(`${ymLabel} 급여 지급을 위해 지출결의를 상신합니다.`);
    }
    updateJeongyeolUi();
}

async function loadSalaryLedgerForExpense() {
    if (!canUseSalaryExpense()) return showAlert("급여 연동 권한이 없습니다.");
    const monthInput = document.getElementById("payrollMonth");
    const ym = monthInput?.value || '';
    if (!ym) return showAlert("귀속월을 선택하세요.");

    const btn = document.getElementById("btnLoadPayroll");
    if (btn) {
        btn.disabled = true;
        btn.textContent = "불러오는 중...";
    }

    const { rows: normalizedRows, error: ledgerError } = await fetchSalaryLedgerRowsByMonth(ym);
    if (btn) {
        btn.disabled = false;
        btn.textContent = "📊 급여대장 불러오기";
    }
    if (ledgerError) return showAlert("급여대장 조회 실패: " + ledgerError.message);
    if (normalizedRows.length === 0) return showAlert("해당 월의 급여대장 데이터가 없습니다.");
    const sumBy = (key) => normalizedRows.reduce((acc, row) => acc + Number(row?.[key] || 0), 0);
    const payTotal = Math.round(sumBy('pay_total'));
    const dedTotal = Math.round(sumBy('ded_total'));
    const netTotal = Math.round(sumBy('net_pay'));
    const empCount = normalizedRows.length;

    salaryExpenseState = { loaded: true, yearMonth: ym, empCount, payTotal, dedTotal, netTotal, rows: normalizedRows };
    document.getElementById("appAmount").value = netTotal;
    updateJeongyeolUi();

    const ymLabel = formatYearMonthLabel(ym);
    const summary = document.getElementById("payrollSummary");
    if (summary) {
        summary.className = "small text-success";
        summary.innerHTML = `연동 완료: ${ymLabel} · ${empCount}명 · 실지급 합계 <strong>${formatMoney(netTotal)}원</strong>`;
    }

    const autoBlock = [
        `[급여대장 연동] ${ymLabel}`,
        `- 대상 인원: ${empCount}명`,
        `- 지급총액: ${formatMoney(payTotal)}원`,
        `- 공제총액: ${formatMoney(dedTotal)}원`,
        `- 실지급총액: ${formatMoney(netTotal)}원`
    ].join('\n');
    const currentDesc = getApprovalEditorContent();
    if (!currentDesc.trim() || currentDesc.includes('[급여대장 연동]')) {
        setApprovalEditorContent(`${ymLabel} 급여 지급을 위해 지출결의를 상신합니다.\n\n${autoBlock}`);
    }
}

// [추가] 대리 상신 모드 토글
function toggleProxyMode() {
    const isProxy = document.getElementById("chkProxy").checked;
    const targetDiv = document.getElementById("divProxyTarget");
    const targetSel = document.getElementById("proxyTargetSelect");
    
    if (isProxy) {
        const myLevel = myInfo.auth_level || 99;
        // 하급자 필터링: 나보다 숫자 큰 사람
        const subordinates = allUsers.filter(u => {
            if ((myInfo.role === 'admin' || myInfo.role === 'admin_all') || myLevel === 1) return u.auth_level > myLevel; 
            return u.department === myInfo.department && u.auth_level > myLevel;
        });

        targetSel.innerHTML = "";
    if (subordinates.length === 0) {
        showAlert("대리 상신 가능한 하급자가 없습니다.");
        document.getElementById("chkProxy").checked = false;
        updateJeongyeolUi();
        return;
    }
        subordinates.forEach(u => {
            const opt = document.createElement("option");
            opt.value = u.emp_id;
            opt.textContent = `${u.emp_name} (${u.position})`;
            targetSel.appendChild(opt);
        });
        targetDiv.classList.remove("hidden");
    } else {
        targetDiv.classList.add("hidden");
    }
    calculateLeave(); // 대상자가 바뀌었으니 연차 다시 조회
    updateJeongyeolUi();
}

function applyLeaveRemainToUi(snapshot) {
    const effective = Number(snapshot?.effectiveRemainDays || 0);
    const reserved = Number(snapshot?.reservedDays || 0);

    document.getElementById("remainDaysBadge").innerText = effective;
    const halfBadge = document.getElementById("remainDaysBadgeHalf");
    if (halfBadge) halfBadge.innerText = effective;

    const reservedEl = document.getElementById("reservedLeaveDaysBadge");
    if (reservedEl) reservedEl.innerText = reserved;
}

// [수정] 연차 계산 (대리 상신 대상자 지원 + 결재완료 예정 차감 반영)
async function calculateLeave() {
    let targetId = myInfo.emp_id;
    // 대리상신 모드면 선택된 대상자의 연차 조회
    if (document.getElementById("chkProxy") && document.getElementById("chkProxy").checked) {
        targetId = document.getElementById("proxyTargetSelect").value;
    }

    if (!targetId) {
        applyLeaveRemainToUi({ effectiveRemainDays: 0, reservedDays: 0 });
        leaveSnapshotState = null;
        return;
    }

    try {
        if (window.LeaveLedger && typeof window.LeaveLedger.getLeaveSnapshot === 'function') {
            leaveSnapshotState = await window.LeaveLedger.getLeaveSnapshot(_supabase, targetId, {
                reservedStatuses: ['완료', '가승인', '증빙확인중', '실물결재대기', '실물결재완료'],
                includeToday: true,
                unknownAsReserved: false
            });
            applyLeaveRemainToUi(leaveSnapshotState);
            return;
        }
    } catch (err) {
        console.error('Leave snapshot load failed:', err);
    }

    // 공통 모듈 로드 실패 시 기존 RPC 값으로 폴백
    const { data: remain } = await _supabase.rpc('calculate_leave_days', { p_emp_id: targetId });
    applyLeaveRemainToUi({ effectiveRemainDays: (remain !== null ? remain : 0), reservedDays: 0 });
    leaveSnapshotState = null;
}

function showAlert(msg, onClose = null) {
    document.getElementById("alertBody").textContent = msg || "";
    if (typeof onClose === 'function') {
        const alertEl = document.getElementById('alertModal');
        alertEl.addEventListener('hidden.bs.modal', () => {
            try { onClose(); } catch (_) { /* noop */ }
        }, { once: true });
    }
    alertModalInstance.show();
}

function showConfirm(msg, options = {}) {
    const modalEl = document.getElementById('confirmModal');
    const titleEl = document.getElementById('confirmTitle');
    const bodyEl = document.getElementById('confirmBody');
    const okBtn = document.getElementById('confirmOkBtn');
    if (!confirmModalInstance || !modalEl || !titleEl || !bodyEl || !okBtn) {
        showAlert(String(msg || '확인이 필요합니다.'));
        return Promise.resolve(false);
    }

    const title = String(options?.title || '확인').trim() || '확인';
    const okText = String(options?.okText || '확인').trim() || '확인';
    const okClass = String(options?.okClass || 'btn-danger').trim() || 'btn-danger';

    titleEl.textContent = title;
    bodyEl.textContent = String(msg || '');
    okBtn.textContent = okText;
    okBtn.className = `btn ${okClass} btn-sm`;

    return new Promise((resolve) => {
        let settled = false;
        const finish = (result) => {
            if (settled) return;
            settled = true;
            okBtn.removeEventListener('click', onConfirm);
            modalEl.removeEventListener('hidden.bs.modal', onHidden);
            resolve(!!result);
        };
        const onConfirm = () => {
            finish(true);
            confirmModalInstance.hide();
        };
        const onHidden = () => {
            finish(false);
        };
        okBtn.addEventListener('click', onConfirm);
        modalEl.addEventListener('hidden.bs.modal', onHidden, { once: true });
        confirmModalInstance.show();
    });
}

function canDrafterCancelPendingDoc(doc) {
    if (!doc || doc.drafter_id !== myInfo?.emp_id) return false;
    const status = String(doc.status || '');
    if (!['진행중', '증빙확인중', '가승인', '실물결재대기'].includes(status)) return false;
    const line = Array.isArray(doc.approval_line) ? doc.approval_line : [];
    if (line.length === 0) return true;
    const hasProcessed = line.some(step => ['승인', '반려'].includes(String(step?.status || '')));
    return !hasProcessed;
}

function canDeleteCanceledDoc(doc) {
    if (!doc) return false;
    if (String(doc.status || '') !== '결재취소') return false;
    const isDrafter = doc.drafter_id === myInfo?.emp_id;
    const canManageAll = canPerform('approval.process');
    return isDrafter || canManageAll;
}

