    }
    const monthInput = document.getElementById('jeongyeolReportMonth');
    const reportYm = String(monthInput?.value || '').trim();
    if (!/^\d{4}-\d{2}$/.test(reportYm)) return showAlert('보고월을 선택하세요.');

    const range = getKstMonthRangeIso(reportYm);
    if (!range) return showAlert('보고월 형식이 올바르지 않습니다.');

    const reportTitle = `${JEONGYEOL_MONTHLY_TITLE_PREFIX} (${reportYm})`;
    const { data: existingRows, error: existingError } = await _supabase
        .from('ref_approval')
        .select('id, doc_no, status')
        .eq('drafter_id', myInfo.emp_id)
        .eq('doc_type', JEONGYEOL_MONTHLY_DOC_TYPE)
        .eq('title', reportTitle)
        .limit(1);
    if (existingError) return showAlert('기존 보고서 확인 실패: ' + existingError.message);
    if (Array.isArray(existingRows) && existingRows.length > 0) {
        const row = existingRows[0];
        return showAlert(`이미 ${reportYm} 월간보고가 있습니다.\n문서번호: ${row.doc_no || '-'}\n상태: ${row.status || '-'}`);
    }

    const { data, error } = await _supabase
        .from('ref_approval')
        .select('id, doc_no, doc_type, title, amount, status, created_at, drafter_name, approval_line, content')
        .gte('created_at', range.startIso)
        .lt('created_at', range.endIso)
        .order('created_at', { ascending: true });
    if (error) return showAlert('전결 내역 조회 실패: ' + error.message);

    const docs = (Array.isArray(data) ? data : []).filter((doc) => {
        if (String(doc?.doc_type || '').trim() === JEONGYEOL_MONTHLY_DOC_TYPE) return false;
        return isJeongyeolDoc(doc);
    });
    if (docs.length === 0) {
        return showAlert(`${reportYm} 기간에 전결 적용 문서가 없습니다.`);
    }

    const autoCount = docs.filter((doc) => String(getJeongyeolMetaFromDoc(doc)?.mode || '').toUpperCase() === 'AUTO').length;
    const manualCount = docs.filter((doc) => String(getJeongyeolMetaFromDoc(doc)?.mode || '').toUpperCase() === 'MANUAL').length;
    const expenseTotal = docs
        .filter((doc) => String(doc?.doc_type || '').startsWith('지출결의'))
        .reduce((acc, doc) => acc + Number(doc?.amount || 0), 0);
    const lines = docs.map((doc, idx) => {
        const meta = getJeongyeolMetaFromDoc(doc) || {};
        const modeLabel = formatJeongyeolModeLabel(meta.mode);
        const docNo = String(doc?.doc_no || '-');
        const createdAt = formatApprovalKstDateISO(doc?.created_at, '-');
        const docType = String(doc?.doc_type || '-');
        const title = String(doc?.title || '-');
        const amount = formatJeongyeolAmountLabel(doc);
        const status = String(doc?.status || '-');
        return `${idx + 1}. ${createdAt} | ${docNo} | ${docType} | ${title} | ${amount} | ${modeLabel}전결 | ${status}`;
    });

    const content = [
        '[전결 월간보고]',
        `보고월: ${reportYm}`,
        `작성일: ${formatApprovalKstDateISO(new Date(), '-')}`,
        '',
        '1) 요약',
        `- 전결 총 건수: ${docs.length}건`,
        `- 자동 전결: ${autoCount}건`,
        `- 수동 전결: ${manualCount}건`,
        `- 지출결의 합계: ${formatMoney(expenseTotal)}원`,
        '',
        '2) 상세 내역',
        ...lines
    ].join('\n');

    const categoryEl = document.getElementById('appCategory');
    if (categoryEl) categoryEl.value = '일반품의';
    handleCategoryChange();

    const proposalSubjectEl = document.getElementById('proposalSubject');
    if (proposalSubjectEl) proposalSubjectEl.value = reportTitle;
    const amountEl = document.getElementById('appAmount');
    if (amountEl) amountEl.value = String(Math.round(expenseTotal));
    setApprovalEditorContent(content);

    const jeongyeolToggleEl = document.getElementById('chkSecretaryJeongyeol');
    manualJeongyeolSelected = false;
    manualJeongyeolToggleTouched = false;
    if (jeongyeolToggleEl) jeongyeolToggleEl.checked = false;
    updateJeongyeolUi();

    const preferredApprover = getChairmanApprover() || getSecretaryApprover();
    if (!preferredApprover || !preferredApprover.emp_id) {
        return showAlert('보고서 결재선을 자동 설정할 수 없습니다. 결재자를 직접 지정해주세요.');
    }
    finalApprovers = [preferredApprover];
    savedApproversBeforeJeongyeol = [];
    jeongyeolLineLocked = false;
    setApproverSelectionLock(false);
    renderLinePreview();

    finalRefs = [];
    renderRefPreview();
    switchTab('draft');
    showAlert(`전결 월간보고 초안을 만들었습니다.\n제목/내용/결재선을 확인한 뒤 상신하세요.`);
}


// [신규] 문서번호 자동 생성 (제YYYY-NNN호)
async function generateDocNo() {
    const year = new Date().getFullYear();
    const prefix = `제${year}-`;

    const { data } = await _supabase
        .from('ref_approval')
        .select('doc_no')
        .like('doc_no', `${prefix}%`)
        .not('doc_no', 'is', null)
        .order('doc_no', { ascending: false })
        .limit(1);

    let nextSeq = 1;
    if (data && data.length > 0 && data[0].doc_no) {
        const m = String(data[0].doc_no).match(/제\d{4}-(\d{3})호/);
        if (m) nextSeq = parseInt(m[1], 10) + 1;
    } else if (year === 2026) {
        // 2026년은 001 이미 사용됨 (요청 반영: 002부터 시작)
        nextSeq = 2;
    }

    const seq = String(nextSeq).padStart(3, '0');
    return `${prefix}${seq}호`;
}



function isDocNoConflictError(error) {
    const code = String(error?.code || '');
    const message = String(error?.message || '').toLowerCase();
    const details = String(error?.details || '').toLowerCase();
    return code === '23505' && (message.includes('doc_no') || details.includes('doc_no'));
}

async function insertApprovalWithDocNoRetry(basePayload, maxAttempts = 5) {
    let lastConflictError = null;
    for (let attempt = 1; attempt <= maxAttempts; attempt += 1) {
        const docNo = await generateDocNo();
        const payload = { ...basePayload, doc_no: docNo, created_at: new Date() };
        const { data, error } = await _supabase
            .from('ref_approval')
            .insert(payload)
            .select('id, doc_no')
            .single();

        if (!error && data?.id) {
            return { insertedDoc: data, docNo };
        }
        if (isDocNoConflictError(error)) {
            lastConflictError = error;
            continue;
        }
        throw error;
    }

    if (lastConflictError) {
        throw new Error('문서번호 충돌이 반복되어 저장에 실패했습니다. 잠시 후 다시 시도해주세요.');
    }
    throw new Error('문서 저장에 실패했습니다.');
}

function buildNoticeContentFromApproval(doc) {
    const parsed = splitNoticeApprovalContent(doc?.content || '');
    const lines = [];
    if (doc?.doc_no) lines.push(`문서번호: ${doc.doc_no}`);
    if (doc?.receiver) lines.push(`수신: ${doc.receiver}`);
    if (doc?.via) lines.push(`경유: ${doc.via}`);
    if (doc?.title) lines.push(`제목: ${doc.title}`);
    lines.push('');
    if (parsed.publicBody) lines.push(parsed.publicBody);
    return lines.join('\n');
}

async function createNoticeDraftFromApproval(doc) {
