// [추가] 사용자 액션 (증빙제출/상신취소)
async function procUserAction(docId, action, explicitReason = null) {
    const { data: doc, error: docErr } = await _supabase
        .from('ref_approval')
        .select('id, title, current_approver, drafter_id, status, approval_line')
        .eq('id', docId)
        .single();
    if (docErr || !doc) {
        showAlert("문서를 찾을 수 없습니다.");
        return false;
    }

    if (action === '취소') {
        if (doc.drafter_id !== myInfo.emp_id) {
            showAlert("기안자만 취소할 수 있습니다.");
            return false;
        }
        if (!canDrafterCancelPendingDoc(doc)) {
            showAlert("이미 결재가 진행되어 취소할 수 없습니다.");
            return false;
        }

        let reasonText = String(explicitReason || '').trim();
        if (!reasonText) {
            const reason = prompt("취소 사유를 입력하세요:");
            if (reason === null) return false;
            reasonText = String(reason || '').trim();
            if (!reasonText) {
                showAlert("취소 사유를 입력하세요.");
                return false;
            }
        }

        const { error: cancelErr } = await _supabase
            .from('ref_approval')
            .update({ status: '결재취소', current_approver: null })
            .eq('id', docId);
        if (cancelErr) {
            showAlert("취소 처리 실패: " + cancelErr.message);
            return false;
        }
        await logAudit('approval.cancel', docId, '사용자 취소', { reason: reasonText });
        if (doc?.current_approver) {
            await createNotification(doc.current_approver, '결재 취소', `${doc.title || '문서'}가 취소되었습니다.`, `approval.html?doc=${docId}`, { doc_id: docId });
        }
        showAlert("취소되었습니다.");
        loadHistoryList();
        return true;
    } else if (action === '증빙제출') {
        // (간소화) 실제 구현 시 파일 모달 필요. 여기선 안내만.
        showAlert("증빙 서류가 제출되었습니다. (관리자 확인 대기)");
        const { error: evidenceErr } = await _supabase.from('ref_approval').update({ status: '증빙확인중' }).eq('id', docId);
        if (evidenceErr) {
            showAlert("증빙 제출 처리 실패: " + evidenceErr.message);
            return false;
        }
        await logAudit('approval.evidence', docId, '증빙 제출', null);
        if (doc?.current_approver) {
            await createNotification(doc.current_approver, '증빙 제출', `${doc.title || '문서'}에 증빙이 제출되었습니다.`, `approval.html?doc=${docId}`, { doc_id: docId });
        }
        loadHistoryList();
        return true;
    }
    return false;
}

async function loadTodoList() {
    const el = document.getElementById("todoList");
    el.innerHTML = 'loading...';
    if (!canPerform('approval.process')) {
        await loadDelegationContext({ refreshTodo: false });
    }
    const approverIds = Array.from(new Set(
        [String(myInfo?.emp_id || ''), ...delegatedApproverEmpIds]
            .map((v) => String(v || '').trim())
            .filter(Boolean)
    ));
    if (approverIds.length === 0) {
        renderDocs(el, [], true);
        return;
    }
    // 승인 대상: 진행중 or 증빙확인중(관리자가 최종승인 해야함)
    const { data } = await _supabase.from('ref_approval').select('*')
        .in('status', ['진행중', '증빙확인중'])
        .in('current_approver', approverIds)
        .order('created_at', {ascending: false});
    const list = (Array.isArray(data) ? data : []).map((doc) => {
        const curApprover = String(doc?.current_approver || '').trim();
        if (curApprover && curApprover !== String(myInfo?.emp_id || '').trim() && delegationIncomingMap.has(curApprover)) {
            return {
                ...doc,
                _delegated_from: delegationIncomingMap.get(curApprover)
            };
        }
        return doc;
    });
    renderDocs(el, list, true);
}

function extractAuditReason(detail) {
    if (!detail) return '';
    if (typeof detail === 'object') return String(detail.reason || '').trim();
    try {
        const parsed = JSON.parse(detail);
        return String(parsed?.reason || '').trim();
    } catch (_) {
        return '';
    }
}

async function loadCancelReasonMap(docIds) {
    const ids = Array.isArray(docIds) ? docIds.map(v => String(v || '').trim()).filter(Boolean) : [];
    if (ids.length === 0) return {};

    const { data, error } = await _supabase
        .from('erp_audit_logs')
        .select('entity_id, detail, created_at')
        .eq('entity_type', 'ref_approval')
        .eq('action', 'approval.cancel')
        .in('entity_id', ids)
        .order('created_at', { ascending: false });
    if (error || !Array.isArray(data)) return {};

    const out = {};
    data.forEach(row => {
        const key = String(row?.entity_id || '').trim();
        if (!key || out[key]) return;
        const reason = extractAuditReason(row?.detail);
        if (reason) out[key] = reason;
    });
    return out;
}

