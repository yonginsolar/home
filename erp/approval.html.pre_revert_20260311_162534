function exportHistoryCsv() {
    const list = applyHistoryFilters(historyCache);
    if (!list || list.length === 0) return showAlert("내보낼 데이터가 없습니다.");

    const headers = ['id','doc_type','title','status','drafter_name','created_at','amount','current_approver','signed_doc_url'];
    const rows = list.map(d => [
        d.id,
        d.doc_type || '',
        d.title || '',
        d.status || '',
        d.drafter_name || '',
        d.created_at || '',
        d.amount || 0,
        d.current_approver || '',
        d.signed_doc_url || ''
    ]);

    const csvEscape = (val) => {
        const str = String(val ?? '');
        if (/[",\n]/.test(str)) return `"${str.replace(/"/g, '""')}"`;
        return str;
    };

    const csv = [headers.join(',')]
        .concat(rows.map(r => r.map(csvEscape).join(',')))
        .join('\n');

    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    const dateTag = formatApprovalKstDateISO(new Date());
    a.download = `approval_history_${dateTag}.csv`;
    a.click();
    URL.revokeObjectURL(url);
}

