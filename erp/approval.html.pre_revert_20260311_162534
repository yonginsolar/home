	    }

    const relatedDocId = document.getElementById("relDocId").value || null;
    const allowHtmlContent = (mainType === '일반품의' || mainType === '공문');
    const rawBodyContent = getApprovalEditorContent();
    const isNoticeDraft = mainType === '공문';
    const mergedBodyContent = mergeSystemAppendContent(rawBodyContent, isNoticeDraft ? '' : appendDesc, allowHtmlContent);
    let savedBodyContent = allowHtmlContent
        ? renderApprovalContent(mergedBodyContent, true)
        : mergedBodyContent;
    if (isNoticeDraft) {
        const mergedNoticeMemo = mergeSystemAppendContent(noticeApprovalMemo, appendDesc, false);
        savedBodyContent = composeNoticeApprovalContent(mergedBodyContent, mergedNoticeMemo);
    }

    // 4. DB 저장
    const jeongyeolMeta = jeongyeolDecision.applied
        ? {
            jeongyeol_applied: true,
            jeongyeol_mode: jeongyeolDecision.mode,
            jeongyeol_rule_code: jeongyeolDecision.ruleCode || null,
            jeongyeol_rule_label: jeongyeolDecision.ruleLabel || null
        }
        : null;
    const approvalLineData = finalApprovers.map((u, idx) => ({
        emp_id: u.emp_id,
        name: u.emp_name,
        position: u.position,
        status: '대기',
        comment: '',
        processed_at: null,
        ...(idx === 0 && jeongyeolMeta ? jeongyeolMeta : {})
    }));
    const refData = finalRefs.map(u => ({ emp_id: u.emp_id, name: u.emp_name }));

    const approvalInsertPayload = {
        doc_type: subType,
        title: title,
        content: savedBodyContent,
        amount: Number(finalAmt),
        drafter_id: drafterId,
        drafter_name: drafterName,
        approval_line: approvalLineData,
        ref_line: refData,
        file_links: uploadedUrls,
        current_approver: finalApprovers[0].emp_id,
        status: initialStatus, // 가승인 or 진행중
        related_doc_id: relatedDocId, // [New]
        receiver: receiver || null,
        via: via || null
    };

    let insertedDoc = null;
    try {
        const insertResult = await insertApprovalWithDocNoRetry(approvalInsertPayload);
        insertedDoc = insertResult.insertedDoc;
    } catch (error) {
        showAlert("상신 실패: " + error.message);
        btn.disabled = false;
        btn.innerText = "상신하기";
        return;
    }

    const docId = insertedDoc?.id;
    if (docId) {
        await logAudit('approval.submit', docId, `${title} 상신`, {
            status: initialStatus,
            jeongyeol_mode: jeongyeolDecision.applied ? jeongyeolDecision.mode : null,
            jeongyeol_rule_code: jeongyeolDecision.applied ? jeongyeolDecision.ruleCode : null
        });
        await createNotification(finalApprovers[0]?.emp_id, '결재 요청', `${title} 문서가 상신되었습니다.`, `approval.html?doc=${docId}`, { doc_id: docId });
    }
    const firstApprover = finalApprovers[0];
    const firstApproverName = firstApprover ? `${firstApprover.emp_name} ${firstApprover.position || ''}`.trim() : '-';
    showAlert(`상신이 완료되었습니다.
첫 결재자: ${firstApproverName}
결재 요청 알림을 전송했습니다.`, () => {
        switchTab('history');
    });
}

// [핵심] 결재 처리
async function procDoc(docId, action) {
    const reason = prompt(`${action} 사유 (선택):`);
    if (reason === null) return;

    if (!canProcessApprovals()) return showAlert("처리 권한이 없습니다.");
    if (!canPerform('approval.process')) {
        await loadDelegationContext({ refreshTodo: false });
    }

    const { data: doc, error: docError } = await _supabase.from('ref_approval').select('*').eq('id', docId).single();
    if (docError || !doc) return showAlert("문서를 불러오지 못했습니다.");
    let line = Array.isArray(doc.approval_line) ? doc.approval_line : [];
    let nextUser = null;
    let newStatus = '진행중';
    let dependentsRollback = null;
    const currentApproverEmpId = String(doc.current_approver || '').trim();
    const actorEmpId = String(myInfo?.emp_id || '').trim();
    const delegatedFrom = (currentApproverEmpId && currentApproverEmpId !== actorEmpId)
        ? delegationIncomingMap.get(currentApproverEmpId)
        : null;

    if (!canPerform('approval.process') && !delegatedFrom) {
        return showAlert("처리 권한이 없습니다.");
    }
    if (!delegatedFrom && currentApproverEmpId && currentApproverEmpId !== actorEmpId) {
        return showAlert("현재 결재 차례가 아닙니다.");
    }

    const effectiveApproverEmpId = delegatedFrom ? currentApproverEmpId : actorEmpId;
    const idx = line.findIndex(p => String(p?.emp_id || '') === effectiveApproverEmpId);
    if (idx === -1) return showAlert("권한 없음");
    if (idx > 0 && String(line[idx - 1]?.status || '') !== '승인') return showAlert("이전 결재자가 처리 안 함");

    line[idx].status = action;
    line[idx].comment = reason;
    line[idx].processed_at = new Date().toISOString();
    if (delegatedFrom) {
        line[idx].delegate_emp_id = actorEmpId;
        line[idx].delegate_name = myInfo?.emp_name || actorEmpId;
        line[idx].delegate_processed_at = line[idx].processed_at;
    }

    if (action === '반려') {
        newStatus = '반려';
        nextUser = null;
    } else {
        if (idx + 1 < line.length) nextUser = line[idx + 1].emp_id;
        else newStatus = '완료'; 
    }

    const { error: approvalUpdateError } = await _supabase
        .from('ref_approval')
        .update({ approval_line: line, current_approver: nextUser, status: newStatus })
        .eq('id', docId);
    if (approvalUpdateError) {
        if (dependentsRollback) {
            await _supabase
                .from('ref_employees')
                .update({ dependents: dependentsRollback.prev })
                .eq('emp_id', dependentsRollback.empId);
        }
        return showAlert("결재 상태 저장 실패: " + approvalUpdateError.message);
    }
    await logAudit('approval.process', docId, `${action} 처리`, {
        status: newStatus,
        reason: reason || null,
        delegated_from_emp_id: delegatedFrom ? effectiveApproverEmpId : null,
        delegate_emp_id: delegatedFrom ? actorEmpId : null
    });

    if (action === '반려') {
        await createNotification(doc.drafter_id, '결재 반려', `${doc.title} 문서가 반려되었습니다.`, `approval.html?doc=${docId}`, { doc_id: docId });
    } else if (newStatus === '완료') {
        await createNotification(doc.drafter_id, '결재 완료', `${doc.title} 문서가 최종 승인되었습니다.`, `approval.html?doc=${docId}`, { doc_id: docId });
    } else if (nextUser) {
        await createNotification(nextUser, '결재 요청', `${doc.title} 문서 결재 차례입니다.`, `approval.html?doc=${docId}`, { doc_id: docId });
    }
    if (delegatedFrom) {
        await createNotification(
            delegatedFrom.delegator_emp_id,
            '대결재 처리 알림',
            `${doc.title} 문서가 ${myInfo?.emp_name || '대결재자'}에 의해 ${action} 처리되었습니다.`,
            `approval.html?doc=${docId}`,
            { doc_id: docId, delegated_from: delegatedFrom.delegator_emp_id, delegate_emp_id: actorEmpId }
        );
    }

    showAlert("처리되었습니다."); loadTodoList();
}

