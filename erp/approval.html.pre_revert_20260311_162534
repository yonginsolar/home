    const relatedDocAmountDisplay = relatedDoc ? getApprovalAmountDisplayPayload(relatedDoc) : null;
    const safeRelatedDocTitle = escapeHtml(String(relatedDoc?.title || '연동 품의서'));
    const relatedMetaItems = [];
