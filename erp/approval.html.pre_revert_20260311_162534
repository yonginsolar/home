        const jeongyeolMeta = getJeongyeolMetaFromDoc(doc);
        const jeongyeolBadge = jeongyeolMeta
            ? `<span class="badge bg-secondary me-1">전결-${escapeHtml(formatJeongyeolModeLabel(jeongyeolMeta.mode))}</span>`
            : '';
        const safeTitle = escapeHtml(doc.title);
        const titleDocId = (!isTodo && ['완료', '실물결재완료'].includes(String(doc.status || '')))
            ? toPositiveDocId(doc.id)
            : null;
        const titleHtml = titleDocId
            ? `<h6 class="fw-bold mb-1"><button type="button" class="btn btn-link p-0 fw-bold text-start align-baseline text-decoration-underline text-dark" title="결재 내용 보기" onclick="openRelView(${titleDocId})">${safeTitle}</button></h6>`
            : `<h6 class="fw-bold mb-1">${safeTitle}</h6>`;
        const safeDate = escapeHtml(formatApprovalKstDateISO(doc.created_at, '-'));
        const lineHtml = approvalLine.map(s => {
            const status = s.status || '';
            const name = escapeHtml(s.name);
            const statusClass = status==='승인'?'text-success':(status==='반려'?'text-danger':'text-muted');
            const statusIcon = status==='승인'?'✅':(status==='반려'?'⛔':'⬜');
            return `<span class="small me-2 ${statusClass}">${statusIcon} ${name}</span>`;
        }).join("");
        const rejectedStep = approvalLine.find(step => String(step?.status || '') === '반려' && String(step?.comment || '').trim());
        const rejectedReason = rejectedStep ? String(rejectedStep.comment || '').trim() : '';
        const canceledReason = String(doc?._cancel_reason || '').trim();
        let reasonLabel = '';
        let reasonText = '';
        if (!isTodo && String(doc.status || '') === '반려' && rejectedReason) {
            reasonLabel = '반려 사유';
            reasonText = rejectedReason;
        } else if (!isTodo && String(doc.status || '') === '결재취소' && canceledReason) {
            reasonLabel = '취소 사유';
            reasonText = canceledReason;
        }
        const reasonHtml = reasonText
            ? `<div class="small mt-2 p-2 border rounded bg-light"><span class="fw-bold text-danger me-1">${escapeHtml(reasonLabel)}:</span>${escapeHtml(reasonText).replace(/\n/g, '<br>')}</div>`
            : '';

        let ageBadge = "";
        const isPendingDoc = mapHistoryStatusGroup(doc.status) === 'PENDING';
        if (isPendingDoc && doc.created_at) {
            const createdAt = new Date(doc.created_at);
            if (!Number.isNaN(createdAt.getTime())) {
                const ageDays = Math.floor((Date.now() - createdAt.getTime()) / (1000 * 60 * 60 * 24));
                if (ageDays >= 0) {
                    const ageClass = ageDays >= 7 ? 'bg-danger' : (ageDays >= 3 ? 'bg-warning text-dark' : 'bg-light text-dark');
                    ageBadge = `<span class="badge ${ageClass} ms-2">${ageDays}일 경과</span>`;
                }
            }
        }
        
        let relBtn = "";
        const relId = toPositiveDocId(doc.related_doc_id);
        if (relId) {
            relBtn = `<button class="btn btn-sm btn-outline-info ms-2" style="font-size: 0.75rem;" onclick="openRelView(${relId})">🔗 근거문서 보기</button>`;
        }

        let btnHtml = "";
        if (isTodo) {
            const delegated = doc?._delegated_from || null;
            const delegatedName = delegated ? escapeHtml(delegated.delegator_name || delegated.delegator_emp_id || '') : '';
            const delegatedBadge = delegatedName
                ? `<span class="badge text-bg-info me-2">대결재: ${delegatedName}</span>`
                : '';
            btnHtml = `<div class="mt-2 text-end">${delegatedBadge}<button class="btn btn-sm btn-success me-1" onclick="procDoc(${doc.id},'승인')">승인</button><button class="btn btn-sm btn-danger" onclick="procDoc(${doc.id},'반려')">반려</button></div>`;
        } else {
            const actions = [];
            const isSecretary = (myInfo?.position === '사무국장' || (myInfo?.role === 'admin' || myInfo?.role === 'admin_all'));
            const hasChairman = approvalLine.some(l => (l.position || '').includes('이사장'));
            const canPhysical = isSecretary && hasChairman && canPerform('approval.physical') && doc.drafter_id === myInfo.emp_id;
            const canCancelPending = canDrafterCancelPendingDoc(doc);
            const canDeleteCanceled = canDeleteCanceledDoc(doc);
            const attachmentLinks = Array.isArray(doc.file_links)
                ? doc.file_links.filter(link => typeof link === 'string' && link.trim())
                : [];

            if (doc.status === '가승인' && doc.drafter_id === myInfo.emp_id) {
                actions.push(`<span class="badge bg-warning text-dark me-2">⚠️ 증빙제출 필요</span>`);
                actions.push(`<button class="btn btn-sm btn-primary me-1" onclick="procUserAction(${doc.id}, '증빙제출')">📁 증빙제출</button>`);
                if (canCancelPending) {
                    actions.push(`<button class="btn btn-sm btn-secondary" onclick="startDraftCancel(${doc.id})">🗑️ 상신취소</button>`);
                }
            } else if (canCancelPending) {
                actions.push(`<button class="btn btn-sm btn-outline-secondary me-1" onclick="startDraftCancel(${doc.id})">🗑️ 상신취소</button>`);
            }
            if (canDeleteCanceled) {
                actions.push(`<button class="btn btn-sm btn-outline-danger me-1" onclick="deleteCanceledDoc(${doc.id})">🧹 취소문서 삭제</button>`);
            }

            if (canPhysical && ['진행중','가승인','증빙확인중','실물결재대기','실물결재완료'].includes(doc.status)) {
                actions.push(`<button class="btn btn-sm btn-outline-primary me-1" onclick="printPhysicalDoc(${doc.id})">🖨️ 실물결재 출력</button>`);
            }
            if (canPhysical && doc.status === '실물결재대기') {
                actions.push(`<button class="btn btn-sm btn-success me-1" onclick="startPhysicalComplete(${doc.id})">✅ 서명첨부 완료</button>`);
                actions.push(`<button class="btn btn-sm btn-outline-danger me-1" onclick="startPhysicalReject(${doc.id})">⛔ 실물결재 반려</button>`);
            }
            if (doc.signed_doc_url) {
                const safeUrl = encodeURIComponent(doc.signed_doc_url);
                actions.push(`<button class="btn btn-sm btn-outline-secondary" onclick="openSignedDoc('${safeUrl}')">📎 서명문서</button>`);
            }
            if (attachmentLinks.length > 0) {
                attachmentLinks.slice(0, 3).forEach((link, idx) => {
                    const safeUrl = encodeURIComponent(link);
                    const fullName = extractDisplayFileName(link, `첨부파일 ${idx + 1}`);
                    const shortName = compactFileName(fullName, 18);
                    const safeFullName = escapeHtml(fullName);
                    const safeShortName = escapeHtml(shortName);
                    actions.push(`<button class="btn btn-sm btn-outline-dark me-1" title="${safeFullName}" onclick="openAttachment('${safeUrl}')">📎 ${safeShortName}</button>`);
                });
                if (attachmentLinks.length > 3) {
                    actions.push(`<span class="small text-muted">+${attachmentLinks.length - 3}건</span>`);
                }
            }

            const badgeClass = (doc.status === '완료' || doc.status === '실물결재완료')
                ? 'bg-success'
                : (doc.status === '반려' || doc.status === '결재취소')
                    ? 'bg-danger'
                    : 'bg-warning';
            const safeStatus = escapeHtml(doc.status);
            const badgeHtml = `<span class="badge ${badgeClass}">${safeStatus}</span>`;

            if (actions.length > 0) {
                btnHtml = `<div class="mt-2 text-end">${badgeHtml} ${actions.join(' ')}</div>`;
            } else {
                btnHtml = `<div class="mt-2 text-end">${badgeHtml}</div>`;
            }
        }
        
        target.innerHTML += `<div class="list-group-item shadow-sm mb-3 border-0 p-3"><div class="d-flex justify-content-between mb-2"><div><span class="badge bg-primary me-1">${safeDocType}</span>${jeongyeolBadge}${relBtn}</div><small class="text-muted">${safeDate}${ageBadge}</small></div>${titleHtml}<div class="small mb-2">${lineHtml}</div>${reasonHtml}${btnHtml}</div>`;
    });
}
function updateFileList() {
    const area = document.getElementById("fileListArea");
    area.innerHTML = "";
    Array.from(document.getElementById("attachFile").files).forEach(f => {
        const item = document.createElement("div");
        item.className = "file-item";
        item.textContent = `📎 ${f.name}`;
        area.appendChild(item);
    });
}

function openSignedDoc(encodedUrl) {
    if (!encodedUrl) return;
    const rawUrl = decodeURIComponent(encodedUrl);
    resolveStorageUrl(rawUrl, 60 * 60 * 6)
        .then(url => window.open(url || rawUrl, '_blank'))
        .catch(() => window.open(rawUrl, '_blank'));
}

function openAttachment(encodedUrl) {
    if (!encodedUrl) return;
    const rawUrl = decodeURIComponent(encodedUrl);
    resolveStorageUrl(rawUrl, 60 * 60 * 6)
        .then(url => window.open(url || rawUrl, '_blank'))
        .catch(() => window.open(rawUrl, '_blank'));
}


function buildPhysicalPrintHtml(doc) {
    const rawType = String(doc.doc_type || '');
    const rawDrafter = String(doc.drafter_name || '');
    const isExpenseDoc = rawType.startsWith('지출결의');
    const isProposalDoc = rawType.startsWith('일반품의');
    const isNoticeDoc = rawType.startsWith('공문');
    const docHeading = isExpenseDoc ? '지 출 결 의 서' : (isProposalDoc ? '품 의 서' : '결 재 문 서');
    const sectionHeading = isExpenseDoc ? '결재 사유 / 집행 근거' : (isProposalDoc ? '품의 사유 / 추진 근거' : '결재 사유 / 본문');
    const safeType = escapeHtml(rawType);
    const safeDrafter = escapeHtml(rawDrafter);
    const safeDocHeading = escapeHtml(docHeading);
    const safeSectionHeading = escapeHtml(sectionHeading);
    const safeDate = escapeHtml(formatApprovalKstDateISO(doc.created_at, ''));
    const relId = toPositiveDocId(doc.related_doc_id);
    const safeRelDocId = relId ? String(relId) : '';
    const relatedDoc = doc?._related_doc && typeof doc._related_doc === 'object'
        ? doc._related_doc
        : null;
    const amountDisplay = getApprovalAmountDisplayPayload(doc);
    const safeAmountMain = escapeHtml(amountDisplay.mainText || '');
    const safeAmountSub = amountDisplay.subText ? escapeHtml(amountDisplay.subText) : '';
    const safeAmountLabel = escapeHtml(amountDisplay.labelText || '금액');
    const noticeParts = isNoticeDoc
        ? splitNoticeApprovalContent(doc.content || '')
        : { approvalMemo: '', publicBody: String(doc.content || '') };
    const noticePublicBody = isNoticeDoc ? noticeParts.publicBody : String(doc.content || '');
    const noticeApprovalMemo = isNoticeDoc ? noticeParts.approvalMemo : '';
    const renderedBodySource = isNoticeDoc ? (noticePublicBody || '') : (doc.content || '');
    const renderedContent = (isProposalDoc || isNoticeDoc)
        ? renderApprovalContent(renderedBodySource, true)
        : escapeHtml(renderedBodySource || '').replace(/\n/g, '<br>');
    const renderedNoticeMemo = isNoticeDoc && noticeApprovalMemo
        ? escapeHtml(noticeApprovalMemo).replace(/\n/g, '<br>')
        : '';
    const noticeMemoSectionHtml = renderedNoticeMemo
        ? `<div class="section-title">결재 요청 메모 (내부)</div><div class="content-box" style="min-height: 0;">${renderedNoticeMemo}</div>`
        : '';
    const safeDocNo = escapeHtml(doc.doc_no || '');
    const safeReceiver = escapeHtml(doc.receiver || '');
    const safeVia = escapeHtml(doc.via || '');
    const auxInfoLabel = isNoticeDoc ? '수신/경유' : '지급정보';
    const safeAuxInfoLabel = escapeHtml(auxInfoLabel);
    const shouldShowAmount = isExpenseDoc || !!amountDisplay.showAmount;
    const sourceAttachmentLinks = Array.isArray(doc.file_links)
        ? doc.file_links.filter(link => typeof link === 'string' && link.trim())
        : [];
    const signedAttachmentLinks = Array.isArray(doc._signed_file_links) && doc._signed_file_links.length > 0
        ? doc._signed_file_links
        : [];
    const attachmentLinks = sourceAttachmentLinks.map((sourceUrl, idx) => ({
        sourceUrl,
        href: String(signedAttachmentLinks[idx] || sourceUrl || '')
    })).filter(item => item.href);
    const attachmentItemsHtml = attachmentLinks.map((item, idx) => {
        const safeUrl = escapeHtml(item.href);
        const safeName = escapeHtml(extractDisplayFileName(item.sourceUrl, `첨부파일 ${idx + 1}`));
        return `<li><a href="${safeUrl}" target="_blank" rel="noopener noreferrer">${safeName}</a></li>`;
    }).join('');

    const attachmentSectionHtml = attachmentItemsHtml
        ? `
            <div class="section-title">첨부파일</div>
            <div class="attach-box">
              <ul class="attach-list">${attachmentItemsHtml}</ul>
            </div>
          `
        : '';

    let rawTitle = String(doc.title || '');
    if (rawDrafter) {
        const suffix = `- ${rawDrafter}`;
        if (rawTitle.includes(suffix)) {
            rawTitle = rawTitle.replace(suffix, '').trim();
        }
    }
    const safeTitle = escapeHtml(rawTitle);

    const approvalLine = Array.isArray(doc.approval_line) ? doc.approval_line : [];
    const findByPos = (keyword) => approvalLine.find(l => (l.position || '').includes(keyword));
    let secretary = findByPos('사무국장');
    const chairman = findByPos('이사장');
    const isDrafterSecretary = !!doc._drafter_is_secretary;
    let secretaryAuto = false;
    if (!secretary && isDrafterSecretary) {
        secretary = { name: rawDrafter, status: '승인', processed_at: doc.created_at };
        secretaryAuto = true;
    }
    const safeSecretaryName = escapeHtml(secretary?.name || '');
    const safeChairmanName = escapeHtml(chairman?.name || '');

    const stampHtml = (entry, fallbackDate, autoLabel = false, options = {}) => {
        if (!entry) return `<div class="stamp-wrap"></div>`;
        if (entry.status === '승인') {
            const dt = entry.processed_at ? formatApprovalKstDateISO(entry.processed_at) : (fallbackDate || '');
            const label = autoLabel ? '자동승인' : '승인';
            return `<div class="stamp-wrap"><div class="stamp approved">${label}</div>${dt ? `<div class="stamp-date">${dt}</div>` : ''}</div>`;
        }
        if (entry.status === '반려') return `<div class="stamp-wrap"><div class="stamp rejected">반려</div></div>`;
        if (options.hidePending) return `<div class="stamp-wrap"></div>`;
        return `<div class="stamp-wrap"><div class="stamp pending">대기</div></div>`;
    };

    const drafterStamp = `<div class="stamp-wrap"><div class="stamp drafted">기안</div>${safeDate ? `<div class="stamp-date">${safeDate}</div>` : ''}</div>`;
    const emptyText = '<span class="text-muted-light">-</span>';
    const safePrintedAt = escapeHtml(formatApprovalKstDateISO(new Date().toISOString(), ''));
    const pageRule = 'A4 portrait';
    const relatedDocType = String(relatedDoc?.doc_type || '');
