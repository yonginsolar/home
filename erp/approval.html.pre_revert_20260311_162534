async function printPhysicalDoc(docId) {
    if (!canPerform('approval.physical')) return showAlert("처리 권한이 없습니다.");
    const { data: doc, error } = await _supabase.from('ref_approval').select('*').eq('id', docId).single();
    if (error || !doc) return showAlert("문서를 찾을 수 없습니다.");

    const fileLinks = Array.isArray(doc.file_links) ? doc.file_links : [];
    if (fileLinks.length > 0) {
        const signedLinks = [];
        for (const link of fileLinks) {
            const signed = await resolveStorageUrl(link, 60 * 60 * 3);
            signedLinks.push(signed || link);
        }
        doc._signed_file_links = signedLinks;
    }

    // 기안자 직급 확인 (사무국장 여부)
    if (doc.drafter_id) {
        const { data: drafterEmp } = await _supabase
            .from('ref_employees')
            .select('position')
            .eq('emp_id', doc.drafter_id)
            .maybeSingle();
        doc._drafter_is_secretary = !!(drafterEmp?.position || '').includes('사무국장');
    }

    const relatedDocId = toPositiveDocId(doc.related_doc_id);
    if (relatedDocId) {
        const { data: relatedDoc, error: relatedErr } = await _supabase
            .from('ref_approval')
            .select('*')
            .eq('id', relatedDocId)
            .maybeSingle();
        if (!relatedErr && relatedDoc) {
            doc._related_doc = relatedDoc;
        }
    }

    const win = window.open('', '_blank');
    win.document.write(buildPhysicalPrintHtml(doc));
    win.document.close();

    if (!['실물결재대기', '실물결재완료'].includes(doc.status)) {
        await _supabase.from('ref_approval')
            .update({ status: '실물결재대기', current_approver: null })
            .eq('id', docId);
        await logAudit('approval.physical_print', docId, '실물결재 출력', null);
        loadHistoryList();
    }
}

function startPhysicalComplete(docId) {
    if (!canPerform('approval.physical')) return showAlert("처리 권한이 없습니다.");
    pendingPhysicalDocId = docId;
    const input = document.getElementById('signedDocInput');
    input.value = "";
    input.click();
}

function startPhysicalReject(docId) {
    if (!canPerform('approval.physical')) return showAlert("처리 권한이 없습니다.");
    pendingPhysicalRejectDocId = docId;
    const reasonEl = document.getElementById('physicalRejectReason');
    if (reasonEl) reasonEl.value = '';
    if (physicalRejectModalInstance) {
        physicalRejectModalInstance.show();
        setTimeout(() => reasonEl?.focus(), 120);
    }
}

async function submitPhysicalReject() {
    if (!canPerform('approval.physical')) return showAlert("처리 권한이 없습니다.");
    if (!pendingPhysicalRejectDocId) return;

    const reasonEl = document.getElementById('physicalRejectReason');
    const reason = String(reasonEl?.value || '').trim();
    if (!reason) return showAlert("반려 사유를 입력하세요.");

    const submitBtn = document.getElementById('btnPhysicalRejectSubmit');
    if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "처리 중...";
    }

    const { data: doc, error: docErr } = await _supabase
        .from('ref_approval')
        .select('id, status, approval_line, title, drafter_id')
        .eq('id', pendingPhysicalRejectDocId)
        .single();

    if (docErr || !doc) {
        if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = "반려 처리";
        }
        return showAlert("문서를 찾을 수 없습니다.");
    }
    if (doc.status !== '실물결재대기') {
        if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = "반려 처리";
        }
        return showAlert("실물결재 대기 상태에서만 반려할 수 있습니다.");
    }

    const nowIso = new Date().toISOString();
    let line = Array.isArray(doc.approval_line) ? doc.approval_line : [];
    line = line.map(l => {
        if ((l.position || '').includes('이사장')) {
            return { ...l, status: '반려', processed_at: nowIso, comment: reason };
        }
        return l;
    });

    const { error: updateErr } = await _supabase.from('ref_approval').update({
        status: '반려',
        approval_line: line,
        current_approver: null,
        processed_at: nowIso
    }).eq('id', pendingPhysicalRejectDocId);

    if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "반려 처리";
    }
    if (updateErr) return showAlert("실물결재 반려 처리 실패: " + updateErr.message);

    await logAudit('approval.physical_reject', pendingPhysicalRejectDocId, '실물결재 반려', { reason });
    if (doc?.drafter_id && doc.drafter_id !== myInfo?.emp_id) {
        await createNotification(doc.drafter_id, '실물결재 반려', `${doc.title || '문서'} 실물결재가 반려되었습니다.`, `approval.html?doc=${pendingPhysicalRejectDocId}`, { doc_id: pendingPhysicalRejectDocId, reason });
    }

    if (physicalRejectModalInstance) physicalRejectModalInstance.hide();
    pendingPhysicalRejectDocId = null;
    if (reasonEl) reasonEl.value = '';
    showAlert("실물결재가 반려되었습니다.");
    loadHistoryList();
}

document.getElementById('signedDocInput').addEventListener('change', async (e) => {
    const fileInput = e.target;
    if (!pendingPhysicalDocId) return;
    if (!fileInput.files || fileInput.files.length === 0) return;

    const validation = validateAttachments(fileInput.files);
    if (!validation.ok) return showAlert(validation.message);

    const file = fileInput.files[0];
	    const safeName = `${crypto.randomUUID()}_${file.name.replace(/[^a-zA-Z0-9.]/g, '_')}`;
	    const { error: uploadErr } = await _supabase.storage.from('attachments').upload(safeName, file);
	    if (uploadErr) return showAlert("파일 오류: " + uploadErr.message);
	    const signedDocRef = `attachments/${safeName}?display_name=${encodeURIComponent(file.name || safeName)}`;

    const { data: doc } = await _supabase
        .from('ref_approval')
        .select('id, approval_line, title, drafter_id, doc_type, content, doc_no, receiver, via')
        .eq('id', pendingPhysicalDocId)
        .single();
    const nowIso = new Date().toISOString();
    let line = Array.isArray(doc?.approval_line) ? doc.approval_line : [];
    line = line.map(l => {
        if ((l.position || '').includes('이사장')) {
            return { ...l, status: '승인', processed_at: nowIso, comment: '실물결재 확인' };
        }
        return l;
    });

	    await _supabase.from('ref_approval').update({
	        status: '실물결재완료',
	        signed_doc_url: signedDocRef,
	        physical_approved_at: nowIso,
	        physical_approved_by: myInfo?.emp_id || null,
	        approval_line: line,
	        current_approver: null,
	        processed_at: nowIso
	    }).eq('id', pendingPhysicalDocId);

	    await logAudit('approval.physical_complete', pendingPhysicalDocId, '실물결재 완료', { signed_doc_url: signedDocRef });
    if (doc?.drafter_id && doc.drafter_id !== myInfo?.emp_id) {
        await createNotification(doc.drafter_id, '실물결재 완료', `${doc.title || '문서'} 실물결재가 완료되었습니다.`, `approval.html?doc=${pendingPhysicalDocId}`, { doc_id: pendingPhysicalDocId });
    }

    pendingPhysicalDocId = null;
    fileInput.value = "";
    showAlert("실물결재가 완료되었습니다.");
    loadHistoryList();
});

    // --- [신규 기능] 관련 문서 검색 및 보기 ---

let relSearchModal, relViewModal;
let currentViewingDocId = null;

// 모달 초기화 (onload 밖에서도 호출 가능하도록)
document.addEventListener('DOMContentLoaded', () => {
    relSearchModal = new bootstrap.Modal(document.getElementById('relSearchModal'));
    relViewModal = new bootstrap.Modal(document.getElementById('relViewModal'));
});

// 1. 검색 모달 열기
function openRelSearch() {
    document.getElementById("relKeyword").value = "";
    document.getElementById("relResultList").innerHTML = "";
    relSearchModal.show();
    setTimeout(()=> document.getElementById("relKeyword").focus(), 500);
}

// 2. 검색 실행 (완료/실물결재완료된 '일반품의' & 같은 부서)
async function runRelSearch() {
    const key = document.getElementById("relKeyword").value.trim();
    const listEl = document.getElementById("relResultList");
    listEl.innerHTML = '<div class="p-3 text-center">검색 중...</div>';

    // 내 부서 찾기 (ref_employees 이용 안 하고 allUsers에서 찾음)
    const myDept = myInfo.department;

    // 쿼리: status in (완료, 실물결재완료), doc_type=일반품의
    let query = _supabase.from('ref_approval')
        .select('*')
        .in('status', ['완료', '실물결재완료'])
        .eq('doc_type', '일반품의') // 품의서만 검색
        .order('created_at', {ascending: false})
        .limit(20);

    if (key) {
        const safeKey = sanitizeOrKeyword(key);
        if (safeKey) query = query.or(`title.ilike.%${safeKey}%,drafter_name.ilike.%${safeKey}%`);
    }

    const { data, error } = await query;
    if (error) {
        listEl.innerHTML = "";
        listEl.textContent = '오류: ' + error.message;
        return;
    }

    // 부서 필터링 (클라이언트 사이드)
    // allUsers 배열을 활용해 작성자의 부서를 확인
    const filtered = data.filter(doc => {
        const drafter = allUsers.find(u => u.emp_id === doc.drafter_id);
        // 작성자가 없거나(퇴사), 부서가 같거나, 내가 관리자면 통과
        return !drafter || drafter.department === myDept || (myInfo.role === 'admin' || myInfo.role === 'admin_all');
    });

    if (filtered.length === 0) {
        listEl.innerHTML = '<div class="p-3 text-center text-muted">검색 결과가 없습니다. (완료/실물결재완료 품의서만 조회됨)</div>';
        return;
    }

    listEl.innerHTML = "";
    filtered.forEach(doc => {
        const item = document.createElement("a");
        item.className = "list-group-item list-group-item-action";
        item.style.cursor = "pointer";
        const header = document.createElement("div");
        header.className = "d-flex justify-content-between";
        const title = document.createElement("span");
        title.className = "fw-bold";
        title.textContent = doc.title || "";
        const date = document.createElement("small");
        date.textContent = formatApprovalKstDateISO(doc.created_at, "");
        header.appendChild(title);
        header.appendChild(date);
        const meta = document.createElement("small");
        meta.className = "text-muted";
        meta.textContent = `${doc.drafter_name || ''} | ${formatApprovalAmountInline(doc)}`;
        item.appendChild(header);
        item.appendChild(meta);
        item.onclick = () => selectRelDoc(doc);
        listEl.appendChild(item);
    });
}

// 3. 문서 선택
function selectRelDoc(doc) {
    document.getElementById("relDocId").value = doc.id;
    const nameEl = document.getElementById("relDocName");
    nameEl.textContent = `연동됨 ${doc.title || ''} (${doc.drafter_name || ''})`;
    relSearchModal.hide();
}

// 4. 관련 문서 내용 보기 (모달)
async function openRelView(docId) {
    const safeDocId = toPositiveDocId(docId);
    if (!safeDocId) {
        showAlert("문서를 불러올 수 없습니다.");
        return;
    }
    currentViewingDocId = safeDocId;
    const contentEl = document.getElementById("relViewContent");
    const modalTitleEl = document.getElementById("relViewModalTitle");
    if (modalTitleEl) modalTitleEl.textContent = "📄 문서 내용";
    contentEl.textContent = "Loading...";
    relViewModal.show();

    const { data, error } = await _supabase.from('ref_approval').select('*').eq('id', safeDocId).maybeSingle();
    if (error || !data) { contentEl.textContent = "문서를 불러올 수 없습니다."; return; }

    // 보기 전용 템플릿 렌더링 (안전한 DOM 구성)
    const lines = (Array.isArray(data.approval_line) ? data.approval_line : [])
        .map(l => `${l.name || ''}(${l.status || ''})`).join(" → ");
    contentEl.innerHTML = "";

    const titleEl = document.createElement("h4");
    titleEl.className = "fw-bold mb-3";
    titleEl.textContent = data.title || "";

    const metaEl = document.createElement("div");
    metaEl.className = "mb-3 text-muted small";
    metaEl.textContent = `작성자: ${data.drafter_name || ''} | 기안일: ${formatApprovalKstDateISO(data.created_at, '')} | 결재선: ${lines}`;

    const hr = document.createElement("hr");

    const contentBox = document.createElement("div");
    contentBox.className = "p-3 bg-light rounded";
    contentBox.style.minHeight = "200px";
    const rawDocType = String(data.doc_type || '');
    const isNoticeDoc = rawDocType.startsWith('공문');
    const allowHtmlContent = rawDocType.startsWith('일반품의') || isNoticeDoc;
    const noticeParts = isNoticeDoc ? splitNoticeApprovalContent(data.content || '') : null;
    if (isNoticeDoc && String(noticeParts?.approvalMemo || '').trim()) {
        const memoBox = document.createElement("div");
        memoBox.className = "p-3 border rounded bg-white mb-3";
        memoBox.innerHTML = `<div class="small fw-bold text-muted mb-2">결재 요청 메모 (내부)</div>${escapeHtml(noticeParts.approvalMemo).replace(/\n/g, '<br>')}`;
        contentEl.appendChild(memoBox);
    }
    if (allowHtmlContent) {
        const contentSource = isNoticeDoc ? (noticeParts?.publicBody || '') : (data.content || '');
        contentBox.innerHTML = renderApprovalContent(contentSource, true);
    } else {
        contentBox.style.whiteSpace = "pre-wrap";
        contentBox.textContent = isNoticeDoc ? (noticeParts?.publicBody || "") : (data.content || "");
    }

    const amountEl = document.createElement("div");
    amountEl.className = "mt-3 text-end fw-bold";
    const relAmountDisplay = getApprovalAmountDisplayPayload(data);
    amountEl.textContent = `${relAmountDisplay.labelText || '금액'}: ${relAmountDisplay.mainText || '-'}`;

    contentEl.appendChild(titleEl);
    contentEl.appendChild(metaEl);
    contentEl.appendChild(hr);
    contentEl.appendChild(contentBox);
    contentEl.appendChild(amountEl);
}

// 5. 새 창으로 보기
function openRelNewTab() {
    if (!currentViewingDocId) return;
    // 실제로는 별도 뷰어 페이지가 필요하겠지만, 여기서는 모달 내용을 새 창에 씀
    const w = window.open("", "_blank");
