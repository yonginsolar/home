function buildLeaveAmountLabel(doc) {
    const rawType = String(doc?.doc_type || '').trim();
    if (!rawType.startsWith('휴가')) return '';

    const leaveSubType = getApprovalLeaveSubType(rawType);
    const isHalf = leaveSubType === '반차' || leaveSubType === '생일반차';
    const periodLabel = extractLeavePeriodLabelFromDoc(doc);
    const daysLabel = formatLeaveDayCount(doc?.amount);

    if (periodLabel) {
        if (isHalf) return periodLabel;

        const rangeMatch = periodLabel.match(/^(\d{4}\.\d{2}\.\d{2})\s*~\s*(\d{4}\.\d{2}\.\d{2})(?:\s+(.+))?$/);
        if (rangeMatch) {
            const dayText = String(rangeMatch[3] || '').trim() || (daysLabel ? `${daysLabel}일` : '');
            return `(${rangeMatch[1]}~${rangeMatch[2]})${dayText ? ` ${dayText}` : ''}`.trim();
        }
        return periodLabel;
    }

    if (daysLabel) return `${daysLabel}일`;
    return '';
}

