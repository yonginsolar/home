// [수정] 휴가일수 계산 (반차 0.5일 고정)
function calcLeaveDays() {
    const lType = document.getElementById("leaveTypeSelect").value;

    // 반차 로직
    if(lType === '반차' || lType === '생일반차') {
        const d = document.getElementById("halfDate").value;
        if(d) {
            document.getElementById("leaveDaysBadge").innerText = "0.5일";
            document.getElementById("leaveDaysCalc").value = 0.5;
            
            // 잔여 연차 비교 (연차 차감 대상인 '반차'만)
            if(lType === '반차') {
                const remain = Number(document.getElementById("remainDaysBadge").innerText);
                const msg = document.getElementById("leaveOverMsg");
                if(0.5 > remain) msg.classList.remove("hidden"); else msg.classList.add("hidden");
            }
        }
        return;
    }

    // 일반 기간 로직
    const s = document.getElementById("leaveStart").value;
    const e = document.getElementById("leaveEnd").value;
    if (!s || !e) return;

    let count = 0;
    let cur = new Date(s);
    const end = new Date(e);
    while (cur <= end) {
        const day = cur.getDay();
        if (day !== 0 && day !== 6) count++;
        cur.setDate(cur.getDate() + 1);
    }
    
    document.getElementById("leaveDaysBadge").innerText = count + "일";
    document.getElementById("leaveDaysCalc").value = count;
    
    // 잔여 연차 비교 (연차만)
    if(lType === '연차') {
        const remain = Number(document.getElementById("remainDaysBadge").innerText);
        const msg = document.getElementById("leaveOverMsg");
        if(count > remain) msg.classList.remove("hidden"); else msg.classList.add("hidden");
    }
}

