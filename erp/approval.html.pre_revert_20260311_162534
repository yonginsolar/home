function getJeongyeolAutoDecision(mainType, amountValue, options = {}) {
    if (!secretaryJeongyeolEnabled) return null;
    const type = String(mainType || '').trim();
    const amount = Number(amountValue || 0);
    const drafterEmpId = String(options?.drafterEmpId || '').trim() || String(myInfo?.emp_id || '').trim();
    const drafterIsSecretary = isSecretaryGeneralByEmpId(drafterEmpId);

    if (type === '휴가') {
        if (drafterIsSecretary) {
            return {
                mode: 'AUTO',
                applied: true,
                ruleCode: 'AUTO_SECRETARY_LEAVE_TO_CHAIRMAN',
                ruleLabel: '사무국장 휴가는 이사장 결재',
                targetApprover: 'CHAIRMAN'
            };
        }
        return {
            mode: 'AUTO',
            applied: true,
            ruleCode: 'AUTO_ATTENDANCE',
            ruleLabel: '근태(휴가) 자동 전결',
            targetApprover: 'SECRETARY'
        };
    }
    if (type === '지출결의' && amount > 0 && amount <= JEONGYEOL_AUTO_EXPENSE_LIMIT) {
        return {
            mode: 'AUTO',
            applied: true,
            ruleCode: 'AUTO_EXPENSE_UNDER_300K',
            ruleLabel: `30만원 이하 지출결의 자동 전결 (${formatMoney(amount)}원)`,
            targetApprover: 'SECRETARY'
        };
    }
    return null;
}

function getJeongyeolDecision(mainType, amountValue, options = {}) {
    if (!secretaryJeongyeolEnabled) {
        return { mode: 'NONE', applied: false, ruleCode: '', ruleLabel: '', targetApprover: '' };
    }
    const manualToggle = !!manualJeongyeolSelected;
    const autoDecision = getJeongyeolAutoDecision(mainType, amountValue, options);
    if (autoDecision) {
        if (isCurrentUserSecretaryGeneral()) {
            const useAuto = manualJeongyeolToggleTouched ? manualToggle : true;
            return useAuto
                ? autoDecision
                : { mode: 'NONE', applied: false, ruleCode: '', ruleLabel: '', targetApprover: '' };
        }
        return autoDecision;
    }
    if (manualToggle) {
        return {
            mode: 'MANUAL',
            applied: true,
            ruleCode: 'MANUAL_SECRETARY',
            ruleLabel: '사무국장 수동 전결',
            targetApprover: 'SECRETARY'
        };
    }
    return { mode: 'NONE', applied: false, ruleCode: '', ruleLabel: '', targetApprover: '' };
}

function setApproverSelectionLock(lock) {
    const selectBtn = document.getElementById('btnSelectApprover');
    const resetBtn = document.getElementById('btnResetApprover');
    if (selectBtn) selectBtn.disabled = !!lock;
    if (resetBtn) resetBtn.disabled = !!lock;
}

function applyJeongyeolLineDecision(decision, options = {}) {
    const safeDecision = decision && typeof decision === 'object'
        ? decision
        : { mode: 'NONE', applied: false, ruleCode: '', ruleLabel: '', targetApprover: '' };
    const shouldLock = safeDecision.mode === 'AUTO' || safeDecision.mode === 'MANUAL';
    if (shouldLock) {
        const targetCode = String(safeDecision.targetApprover || 'SECRETARY').trim().toUpperCase();
        const useChairman = targetCode === 'CHAIRMAN';
        const fixedApprover = useChairman ? getChairmanApprover() : getSecretaryApprover();
        const fixedLabel = useChairman ? '이사장' : '사무국장';
        if (!fixedApprover || !fixedApprover.emp_id) {
            if (options.showAlertOnMissing !== false) showAlert(`${fixedLabel} 사용자를 찾지 못해 전결을 적용할 수 없습니다.`);
            return { ok: false, reason: 'missing_secretary' };
        }
        if (!jeongyeolLineLocked) savedApproversBeforeJeongyeol = [...finalApprovers];
        finalApprovers = [fixedApprover];
        jeongyeolLineLocked = true;
        jeongyeolLockReasonLabel = fixedLabel;
        setApproverSelectionLock(true);
        renderLinePreview();
        return { ok: true };
    }

    if (jeongyeolLineLocked) {
        finalApprovers = savedApproversBeforeJeongyeol.length > 0
            ? [...savedApproversBeforeJeongyeol]
            : [];
        savedApproversBeforeJeongyeol = [];
    }
    jeongyeolLineLocked = false;
    jeongyeolLockReasonLabel = '';
    setApproverSelectionLock(false);
    renderLinePreview();
    return { ok: true };
}

function updateJeongyeolUi() {
    const hintEl = document.getElementById('jeongyeolHint');
    const toggleEl = document.getElementById('chkSecretaryJeongyeol');
    const panelEl = document.getElementById('jeongyeolSettingPanel');
    const mainType = getCurrentDraftMainType();
    const amount = getCurrentDraftAmount();
    const options = { drafterEmpId: getCurrentDraftDrafterEmpId() };
    if (panelEl) panelEl.classList.toggle('hidden', !secretaryJeongyeolEnabled);
    if (!secretaryJeongyeolEnabled) {
        if (toggleEl) {
            toggleEl.checked = false;
            toggleEl.disabled = true;
        }
        if (hintEl) {
            hintEl.textContent = '사무국장 전결 기능이 관리자 설정에서 비활성화되어 있습니다.';
        }
        applyJeongyeolLineDecision({ mode: 'NONE', applied: false, ruleCode: '', ruleLabel: '', targetApprover: '' }, { showAlertOnMissing: false });
        return;
    }
    const autoDecision = getJeongyeolAutoDecision(mainType, amount, options);
    const decision = getJeongyeolDecision(mainType, amount, options);
    const autoRuleMatched = !!autoDecision;
    const canSecretaryControlAuto = autoRuleMatched && isCurrentUserSecretaryGeneral();

    if (toggleEl) {
        if (autoRuleMatched && !canSecretaryControlAuto) {
            toggleEl.checked = true;
            toggleEl.disabled = true;
        } else {
            toggleEl.disabled = false;
            if (canSecretaryControlAuto && !manualJeongyeolToggleTouched) {
                toggleEl.checked = true;
            } else {
                toggleEl.checked = manualJeongyeolSelected;
            }
        }
    }
    if (hintEl) {
        if (decision.applied) {
            hintEl.textContent = `적용중: ${decision.ruleLabel}`;
        } else if (canSecretaryControlAuto && autoDecision?.ruleLabel) {
            hintEl.textContent = `자동 전결 가능: ${autoDecision.ruleLabel}`;
        } else {
            hintEl.textContent = '자동 전결 규정(30만원 이하 지출결의/근태)을 우선 적용합니다.';
        }
    }
    applyJeongyeolLineDecision(decision, { showAlertOnMissing: false });
}

function handleJeongyeolToggleChanged() {
    const toggleEl = document.getElementById('chkSecretaryJeongyeol');
    if (!secretaryJeongyeolEnabled) return;
    if (toggleEl && !toggleEl.disabled) {
        manualJeongyeolSelected = !!toggleEl.checked;
        manualJeongyeolToggleTouched = true;
    }
