function parseStorageObjectRef(value) {
    const raw = String(value || '').trim();
    if (!raw) return null;
    try {
        const u = new URL(raw);
        const m = u.pathname.match(/\/storage\/v1\/object\/(?:public|sign|authenticated)\/([^/]+)\/(.+)/);
        if (!m) return null;
        const downloadName = u.searchParams.get('display_name') || u.searchParams.get('download') || '';
        return { bucket: decodeURIComponent(m[1]), path: decodeURIComponent(m[2]), raw, downloadName };
    } catch (_) {
        const m = raw.match(/^([a-zA-Z0-9_-]+)\/(.+)$/);
        if (!m) return null;
        const pathPart = String(m[2] || '');
        const qm = pathPart.indexOf('?');
        const cleanPath = qm >= 0 ? pathPart.slice(0, qm) : pathPart;
        const query = qm >= 0 ? pathPart.slice(qm + 1) : '';
        const sp = new URLSearchParams(query);
        const downloadName = sp.get('display_name') || sp.get('download') || '';
        return { bucket: m[1], path: cleanPath, raw, downloadName };
    }
}

function compactFileName(name, maxLen = 18) {
    const text = String(name || '').trim();
    if (!text) return '';
    if (text.length <= maxLen) return text;
    const dotIdx = text.lastIndexOf('.');
    if (dotIdx > 0) {
        const ext = text.slice(dotIdx);
        if (ext.length <= 8 && maxLen > ext.length + 2) {
            const headLen = maxLen - ext.length - 1;
            if (headLen > 0) return `${text.slice(0, headLen)}…${ext}`;
        }
    }
    return `${text.slice(0, Math.max(1, maxLen - 1))}…`;
}

function extractDisplayFileName(rawRef, fallback = '첨부파일') {
    const ref = parseStorageObjectRef(rawRef);
    if (ref) {
        const display = String(ref.downloadName || '').trim();
        if (display) return display;
        const leaf = String(ref.path || '').split('/').pop() || '';
        const decodedLeaf = decodeURIComponent(leaf);
        const withoutUuidPrefix = decodedLeaf.replace(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}_/i, '');
        return String(withoutUuidPrefix || decodedLeaf || fallback);
    }
    try {
        const asUrl = new URL(String(rawRef || ''));
        const fromQuery = asUrl.searchParams.get('display_name') || asUrl.searchParams.get('download') || '';
        if (fromQuery) return fromQuery;
        const pathnameLeaf = decodeURIComponent((asUrl.pathname || '').split('/').pop() || '');
        return pathnameLeaf || fallback;
    } catch (_) {
        return String(fallback || '첨부파일');
    }
}

async function resolveStorageUrl(rawRef, expiresSec = 3600) {
    const ref = parseStorageObjectRef(rawRef);
    if (!ref) return String(rawRef || '');
    try {
        const opts = ref.downloadName ? { download: ref.downloadName } : undefined;
        const { data, error } = await _supabase.storage.from(ref.bucket).createSignedUrl(ref.path, expiresSec, opts);
        if (error || !data?.signedUrl) return String(rawRef || '');
        return data.signedUrl;
    } catch (_) {
        return String(rawRef || '');
    }
}

