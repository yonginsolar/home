function getJeongyeolMetaFromDoc(doc) {
    const line = Array.isArray(doc?.approval_line) ? doc.approval_line : [];
    const hit = line.find((step) => step?.jeongyeol_applied === true);
    if (!hit) return null;
    return {
        mode: String(hit.jeongyeol_mode || '').trim(),
        ruleCode: String(hit.jeongyeol_rule_code || '').trim(),
        ruleLabel: String(hit.jeongyeol_rule_label || '').trim()
    };
}

function formatJeongyeolModeLabel(mode) {
    const safe = String(mode || '').trim().toUpperCase();
    if (safe === 'AUTO') return '자동';
    if (safe === 'MANUAL') return '수동';
    return '-';
}

function formatJeongyeolAmountLabel(doc) {
    const docType = String(doc?.doc_type || '').trim();
    if (docType.startsWith('지출결의')) {
        return `${formatMoney(Number(doc?.amount || 0))}원`;
    }
    if (docType.startsWith('휴가')) {
        const leaveLabel = buildLeaveAmountLabel(doc);
        return leaveLabel || `${Number(doc?.amount || 0)}일`;
    }
    return '-';
}

async function buildJeongyeolMonthlyDraft() {
    if (!secretaryJeongyeolEnabled) {
        return showAlert('사무국장 전결 기능이 비활성화되어 있습니다.');
    }
    if (!isCurrentUserSecretaryGeneral()) {
