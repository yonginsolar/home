function moveFocusOutsideModal(modalEl, fallbackEl) {
    if (!modalEl) return;
    const active = document.activeElement;
    if (!active || !modalEl.contains(active)) return;
    if (typeof active.blur === 'function') active.blur();
    const fallback = fallbackEl || document.getElementById('tab1');
    if (fallback && typeof fallback.focus === 'function') {
        try { fallback.focus({ preventScroll: true }); }
        catch (_) { fallback.focus(); }
    }
}

function bindModalFocusGuard(modalEl, fallbackEl) {
    if (!modalEl || modalEl.dataset.focusGuardBound === '1') return;
    modalEl.dataset.focusGuardBound = '1';
    const guard = () => moveFocusOutsideModal(modalEl, fallbackEl);
    modalEl.addEventListener('hide.bs.modal', guard, true);
    modalEl.addEventListener('hidden.bs.modal', guard, true);
}

async function loadDelegationContext(options = {}) {
    const refreshTodo = !!options.refreshTodo;
    if (delegationRpcUnavailable) {
        delegationOutgoing = null;
        delegationIncoming = [];
        delegationIncomingMap = new Map();
        delegatedApproverEmpIds = [];
        renderDelegationBanner();
        populateDelegationTargets();
        syncDelegationAvailabilityUi();
        return;
    }
    try {
        const { data, error } = await _supabase.rpc('erp_get_approval_delegation_context');
        if (error) throw error;
        delegationRpcUnavailable = false;
        const payload = data || {};
        delegationOutgoing = payload?.outgoing || null;
        delegationIncoming = Array.isArray(payload?.incoming) ? payload.incoming : [];
        delegationIncomingMap = new Map(
            delegationIncoming
                .map((row) => [String(row?.delegator_emp_id || ''), row])
                .filter(([key]) => key)
        );
        delegatedApproverEmpIds = Array.from(new Set(
            delegationIncoming
                .map((row) => String(row?.delegator_emp_id || ''))
                .filter(Boolean)
        ));
    } catch (e) {
        delegationOutgoing = null;
        delegationIncoming = [];
        delegationIncomingMap = new Map();
        delegatedApproverEmpIds = [];
        if (isDelegationRpcMissingError(e)) {
            delegationRpcUnavailable = true;
            if (!delegationRpcWarned) {
                console.info('[approval] Delegation RPC unavailable. Delegation features are disabled in this environment.');
                delegationRpcWarned = true;
            }
        }
    }

    renderDelegationBanner();
    populateDelegationTargets();
    syncDelegationAvailabilityUi();

    if (refreshTodo && document.getElementById('tab2')?.classList.contains('active')) {
        await loadTodoList();
    }
}

