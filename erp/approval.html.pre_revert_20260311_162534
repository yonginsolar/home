        const ampm = String(document.querySelector('input[name="ampm"]:checked')?.value || '').trim();
        return halfDate ? `${halfDate}${ampm ? ` ${ampm}` : ''}` : '';
    }
    const start = formatApprovalDotDate(document.getElementById('leaveStart')?.value || '');
    const end = formatApprovalDotDate(document.getElementById('leaveEnd')?.value || '');
    if (!start || !end) return '';
    const daysLabel = formatLeaveDayCount(daysValue);
