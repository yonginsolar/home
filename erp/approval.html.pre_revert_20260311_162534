function renderDelegationBanner() {
    const banner = document.getElementById('delegateBanner');
    const info = document.getElementById('delegationInfoText');
    if (!banner) return;
    const lines = [];

    if (delegationOutgoing && delegationOutgoing.is_enabled) {
        const from = formatApprovalKstDateISO(delegationOutgoing.start_at, '-');
        const to = formatApprovalKstDateISO(delegationOutgoing.end_at, '-');
        const activeMark = delegationOutgoing.is_active_now ? '진행중' : '예약됨';
        lines.push(`내 위임: ${delegationOutgoing.delegate_name || delegationOutgoing.delegate_emp_id} (${from} ~ ${to}, ${activeMark})`);
    }
    if (delegationIncoming.length > 0) {
        const incomingNames = delegationIncoming.map((d) => d.delegator_name || d.delegator_emp_id).filter(Boolean);
        lines.push(`수임 중: ${incomingNames.join(', ')}`);
    }

    if (lines.length === 0) {
        banner.classList.add('hidden');
    } else {
        banner.classList.remove('hidden');
        banner.innerHTML = lines.map((line) => `<div class="small">• ${escapeHtml(line)}</div>`).join('');
    }

    if (info) {
        if (delegationOutgoing && delegationOutgoing.is_enabled) {
            const from = formatApprovalKstDateISO(delegationOutgoing.start_at, '-');
            const to = formatApprovalKstDateISO(delegationOutgoing.end_at, '-');
            info.textContent = `현재 설정: ${from} ~ ${to}`;
        } else {
            info.textContent = '현재 활성화된 위임이 없습니다.';
        }
    }
}

function isDelegationRpcMissingError(error) {
    const status = Number(error?.status || 0);
    const code = String(error?.code || '').trim();
    const message = String(error?.message || '').toLowerCase();
    if (status === 404) return true;
    if (code === 'PGRST202') return true;
    return message.includes('erp_get_approval_delegation_context')
        && (message.includes('not found') || message.includes('could not find'));
}

