function mapHistoryStatusGroup(status) {
    const safeStatus = String(status || '').trim();
    if (!safeStatus) return 'PENDING';
    if (HISTORY_STATUS_GROUPS.PENDING.includes(safeStatus)) return 'PENDING';
    if (HISTORY_STATUS_GROUPS.DONE.includes(safeStatus)) return 'DONE';
    if (HISTORY_STATUS_GROUPS.REJECTED.includes(safeStatus)) return 'REJECTED';
    if (HISTORY_STATUS_GROUPS.CANCELED.includes(safeStatus)) return 'CANCELED';
    return 'PENDING';
}

function mapHistoryDocTypeGroup(docType) {
    const raw = String(docType || '').trim();
    if (!raw) return 'OTHER';
    if (raw.startsWith(JEONGYEOL_MONTHLY_DOC_TYPE)) return 'GENERAL_PROPOSAL';
    if (raw.startsWith('일반품의')) return 'GENERAL_PROPOSAL';
    if (raw.startsWith('지출결의')) return 'EXPENSE';
    if (raw.startsWith('휴가')) return 'LEAVE';
    if (raw.startsWith('공문')) return 'NOTICE';
    return 'OTHER';
}

function mapHistoryProcessGroup(doc) {
    const status = String(doc?.status || '').trim();
    const hasSignedDoc = !!String(doc?.signed_doc_url || '').trim();
    if (status.startsWith('실물결재') || hasSignedDoc) return 'PHYSICAL';
    return 'ELECTRONIC';
}

function isHistoryWithinPeriod(doc, periodFilter) {
    if (periodFilter === 'ALL') return true;
    const createdAt = new Date(doc?.created_at || '');
    if (Number.isNaN(createdAt.getTime())) return false;
    const now = new Date();
    const diffMs = now.getTime() - createdAt.getTime();
    const dayMs = 24 * 60 * 60 * 1000;
    if (periodFilter === 'D7') return diffMs <= 7 * dayMs;
    if (periodFilter === 'D30') return diffMs <= 30 * dayMs;
    if (periodFilter === 'THIS_MONTH') {
        return formatApprovalKstMonth(createdAt) === formatApprovalKstMonth(now);
    }
    if (periodFilter === 'THIS_YEAR') {
        const c = formatApprovalKstDateISO(createdAt, '');
        const n = formatApprovalKstDateISO(now, '');
        return c.slice(0, 4) === n.slice(0, 4);
    }
    return true;
}

function applyHistoryFilters(list) {
    const safeList = Array.isArray(list) ? list : [];
    const key = String(document.getElementById("searchKeyword")?.value || '').toLowerCase();
    const byStatus = safeList.filter(doc => {
        if (historyStatusFilter === 'ALL') return true;
        return mapHistoryStatusGroup(doc?.status) === historyStatusFilter;
    });
    const byDocType = byStatus.filter(doc => {
        if (historyDocTypeFilter === 'ALL') return true;
        return mapHistoryDocTypeGroup(doc?.doc_type) === historyDocTypeFilter;
    });
    const byPeriod = byDocType.filter(doc => isHistoryWithinPeriod(doc, historyPeriodFilter));
    const byProcess = byPeriod.filter(doc => {
        if (historyProcessFilter === 'ALL') return true;
        return mapHistoryProcessGroup(doc) === historyProcessFilter;
    });
    if (!key) return byProcess;
    return byProcess.filter(d => (d.title || '').toLowerCase().includes(key));
}

function renderHistoryFilterMeta() {
    const safeList = Array.isArray(historyCache) ? historyCache : [];
    const counters = {
        ALL: safeList.length,
        PENDING: safeList.filter(d => mapHistoryStatusGroup(d?.status) === 'PENDING').length,
        DONE: safeList.filter(d => mapHistoryStatusGroup(d?.status) === 'DONE').length,
        REJECTED: safeList.filter(d => mapHistoryStatusGroup(d?.status) === 'REJECTED').length,
        CANCELED: safeList.filter(d => mapHistoryStatusGroup(d?.status) === 'CANCELED').length
    };
    const setText = (id, value) => {
        const el = document.getElementById(id);
        if (el) el.innerText = String(value);
    };
    setText('historyCountAll', counters.ALL);
    setText('historyCountPending', counters.PENDING);
    setText('historyCountDone', counters.DONE);
    setText('historyCountRejected', counters.REJECTED);
    setText('historyCountCanceled', counters.CANCELED);

    document.querySelectorAll('#historyStatusFilterBar [data-history-filter]').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.historyFilter === historyStatusFilter);
    });
}

function renderFilteredHistoryList() {
