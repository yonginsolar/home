    } catch (error) {
        console.warn('loadSecretaryJeongyeolSetting failed:', error?.message || error);
        secretaryJeongyeolEnabled = true;
    }

    const panel = document.getElementById('jeongyeolSettingPanel');
    const toggleEl = document.getElementById('chkSecretaryJeongyeol');
