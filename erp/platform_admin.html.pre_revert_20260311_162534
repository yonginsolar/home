    const HANGUL_INITIALS = ['g', 'kk', 'n', 'd', 'tt', 'r', 'm', 'b', 'pp', 's', 'ss', '', 'j', 'jj', 'ch', 'k', 't', 'p', 'h'];
    const HANGUL_MEDIALS = ['a', 'ae', 'ya', 'yae', 'eo', 'e', 'yeo', 'ye', 'o', 'wa', 'wae', 'oe', 'yo', 'u', 'wo', 'we', 'wi', 'yu', 'eu', 'ui', 'i'];
    const HANGUL_FINALS = ['', 'k', 'k', 'ks', 'n', 'nj', 'nh', 't', 'l', 'lk', 'lm', 'lb', 'ls', 'lt', 'lp', 'lh', 'm', 'p', 'ps', 't', 't', 'ng', 't', 't', 'k', 't', 'p', 'h'];

    function escapeHtml(value) {
      return String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function setStatus(message, type) {
      const area = document.getElementById('statusArea');
      if (!area) return;
      area.className = 'alert';
      area.classList.add(type || 'alert-secondary');
      area.textContent = message || '';
      if (!message) {
        area.classList.add('hidden');
        return;
      }
      area.classList.remove('hidden');
    }

    function setManageStatus(message, type) {
      const area = document.getElementById('manageStatusBox');
      if (!area) return;
      area.className = 'alert';
      area.classList.add(type || 'alert-secondary');
      area.textContent = message || '';
      if (!message) {
        area.classList.add('hidden');
        return;
      }
      area.classList.remove('hidden');
    }

    function setLoadingState(buttonId, isLoading, label) {
        const button = document.getElementById(buttonId);
        if (!button) return;
        if (!button.dataset.originalLabel) button.dataset.originalLabel = button.textContent;
        button.disabled = isLoading;
        button.textContent = isLoading ? (label || '처리 중...') : button.dataset.originalLabel;
    }

    function romanizeHangulChar(char) {
      const code = char.charCodeAt(0);
      if (code < 0xac00 || code > 0xd7a3) return char.toLowerCase();
      const offset = code - 0xac00;
      const initialIndex = Math.floor(offset / 588);
      const medialIndex = Math.floor((offset % 588) / 28);
      const finalIndex = offset % 28;
      return `${HANGUL_INITIALS[initialIndex]}${HANGUL_MEDIALS[medialIndex]}${HANGUL_FINALS[finalIndex]}`;
    }

    function generateCoopCodeFromName(name) {
      const source = String(name || '').trim();
      if (!source) return '';

      let buffer = '';
      for (const char of source) {
        const code = char.charCodeAt(0);
        if (code >= 0xac00 && code <= 0xd7a3) {
          buffer += romanizeHangulChar(char);
          continue;
        }
        if (/[A-Za-z0-9]/.test(char)) {
          buffer += char.toLowerCase();
          continue;
        }
        buffer += '-';
      }

      const slug = buffer
        .toLowerCase()
        .replace(/[^a-z0-9-]+/g, '-')
        .replace(/-+/g, '-')
        .replace(/^-+|-+$/g, '');

      return slug || 'coop';
    }

    function syncCoopCodeFromName() {
      if (coopCodeManuallyEdited) return;
      const coopName = document.getElementById('coopNameInput')?.value || '';
      const generated = generateCoopCodeFromName(coopName);
      const codeInput = document.getElementById('coopCodeInput');
      if (codeInput) codeInput.value = generated;
    }

    function handleCoopNameInput() {
      syncCoopCodeFromName();
    }

    function handleCoopCodeInput() {
      const codeInput = document.getElementById('coopCodeInput');
      if (!codeInput) return;
      coopCodeManuallyEdited = String(codeInput.value || '').trim() !== '';
    }

    function fillCurrentUser() {
      const stored = localStorage.getItem('erp_user');
      let parsed = null;
      try {
        parsed = stored ? JSON.parse(stored) : null;
      } catch (_) {
        parsed = null;
      }
      const name = parsed?.emp_name || currentUser?.email || '-';
      const dept = parsed?.department || '-';
      const pos = parsed?.position || '-';
      document.getElementById('currentUserName').textContent = name;
      document.getElementById('currentUserMeta').textContent = `${dept} / ${pos}`;
    }

    function renderPlatformContext() {
      const chipPlatform = document.getElementById('chipPlatform');
      const chipBootstrap = document.getElementById('chipBootstrap');
      const bootstrapPanel = document.getElementById('bootstrapPanel');
      const createPanel = document.getElementById('createPanel');
      const listPanel = document.getElementById('listPanel');
      const isPlatformAdmin = platformContext?.is_platform_admin === true;
      const isBootstrapMode = platformContext?.bootstrap_mode === true;
      const isClaimedByMe = platformContext?.claimed_by_me === true;

      if (isPlatformAdmin) {
        chipPlatform.textContent = '통합 관리자 접근 가능';
        chipPlatform.className = 'status-chip';
      } else {
        chipPlatform.textContent = '통합 관리자 아님';
        chipPlatform.className = 'status-chip warn';
      }

      if (isBootstrapMode && !isClaimedByMe) {
        chipBootstrap.classList.remove('hidden');
        bootstrapPanel.classList.remove('hidden');
        createPanel.classList.add('hidden');
        listPanel.classList.add('hidden');
        return;
      }

      chipBootstrap.classList.add('hidden');
      bootstrapPanel.classList.add('hidden');
      if (isPlatformAdmin) {
        createPanel.classList.remove('hidden');
        listPanel.classList.remove('hidden');
      } else {
        createPanel.classList.add('hidden');
        listPanel.classList.add('hidden');
      }
    }

    async function loadPlatformContext() {
      const { data, error } = await _supabase.rpc('platform_get_context');
      if (error) throw error;
      platformContext = data || null;
      renderPlatformContext();
      return platformContext;
    }

    function renderCoopTable(rows) {
      coopRows = Array.isArray(rows) ? rows.slice() : [];
      const wrap = document.getElementById('coopTableWrap');
      document.getElementById('coopCountLabel').textContent = `${coopRows.length}건`;
      if (coopRows.length === 0) {
        wrap.innerHTML = '<div class="empty-box">등록된 조합이 없습니다.</div>';
        return;
      }

      wrap.innerHTML = `
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead>
              <tr>
                <th>조합명</th>
                <th>코드</th>
                <th>상태</th>
                <th>직원 수</th>
                <th>관리자 수</th>
                <th>대표 관리자</th>
                <th>관리자 이메일</th>
                <th class="text-end">작업</th>
              </tr>
            </thead>
            <tbody>
              ${coopRows.map((row) => `
                <tr>
                  <td class="fw-bold">${escapeHtml(row.coop_name || '-')}</td>
                  <td><code>${escapeHtml(row.coop_code || '-')}</code></td>
                  <td><span class="badge-soft ${row.is_active ? '' : 'off'}">${row.is_active ? '활성' : '중지'}</span></td>
                  <td>${escapeHtml(row.employee_count ?? 0)}</td>
                  <td>${escapeHtml(row.admin_count ?? 0)}</td>
                  <td>${escapeHtml(row.primary_admin_name || '-')}</td>
                  <td>${escapeHtml(row.primary_admin_email || '-')}</td>
                  <td class="text-end">
                    <button class="btn btn-outline-primary btn-sm" type="button" onclick="openManageModal('${escapeHtml(row.coop_id)}')">설정</button>
                  </td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      `;
    }

    async function loadCoopList() {
      const wrap = document.getElementById('coopTableWrap');
      wrap.innerHTML = '<div class="empty-box">조합 목록을 불러오는 중입니다.</div>';
      const { data, error } = await _supabase.rpc('platform_list_coops');
      if (error) throw error;
      renderCoopTable(Array.isArray(data) ? data : []);
    }

    async function claimPlatformAdmin() {
      setStatus('', '');
      setLoadingState('btnClaimAdmin', true, '등록 중...');
      try {
        const { data, error } = await _supabase.rpc('platform_claim_admin');
        if (error) throw error;
        if (!data || data.ok !== true) throw new Error('통합 관리자 등록 결과를 확인하지 못했습니다.');
        setStatus('현재 계정을 첫 통합 관리자로 등록했습니다.', 'alert-success');
        await loadPlatformContext();
        await loadCoopList();
      } catch (err) {
        console.error('claimPlatformAdmin failed:', err);
        setStatus(`통합 관리자 등록 실패: ${err.message}`, 'alert-danger');
      } finally {
        setLoadingState('btnClaimAdmin', false, '등록 중...');
      }
    }

    function resetCreateForm(clearResult) {
      const shouldClearResult = clearResult !== false;
      document.getElementById('createForm').reset();
      document.getElementById('adminPositionInput').value = '이사장';
      document.getElementById('adminDepartmentInput').value = '사무국';
      coopCodeManuallyEdited = false;
      syncCoopCodeFromName();
      if (shouldClearResult) {
        document.getElementById('createResultBox').classList.add('hidden');
        document.getElementById('createResultBox').textContent = '';
      }
    }

    async function submitCreateForm(event) {
      event.preventDefault();
      setStatus('', '');
      const resultBox = document.getElementById('createResultBox');
      resultBox.classList.add('hidden');
      resultBox.textContent = '';

      const payload = {
        p_coop_code: document.getElementById('coopCodeInput').value.trim().toLowerCase() || generateCoopCodeFromName(document.getElementById('coopNameInput').value),
        p_coop_name: document.getElementById('coopNameInput').value.trim(),
        p_biz_num: document.getElementById('bizNumInput').value.trim(),
        p_admin_name: document.getElementById('adminNameInput').value.trim(),
        p_admin_email: document.getElementById('adminEmailInput').value.trim().toLowerCase(),
        p_admin_position: document.getElementById('adminPositionInput').value.trim(),
        p_admin_department: document.getElementById('adminDepartmentInput').value.trim()
      };

      if (!payload.p_coop_code || !payload.p_coop_name || !payload.p_admin_name || !payload.p_admin_email) {
        setStatus('조합 코드, 조합명, 첫 관리자 이름, 이메일은 필수입니다.', 'alert-danger');
        return;
      }

      setLoadingState('btnCreateCoop', true, '생성 중...');
      try {
        const { data, error } = await _supabase.rpc('platform_create_coop_with_admin', payload);
        if (error) throw error;
        if (!data || data.ok !== true) throw new Error('조합 생성 결과를 확인하지 못했습니다.');

        resultBox.textContent =
          `조합 생성 완료\n` +
          `- 조합명: ${data.coop_name}\n` +
          `- 조합 코드: ${data.coop_code}\n` +
          `- 첫 관리자 사번: ${data.admin_emp_id}\n` +
          `- 첫 관리자 이메일: ${data.admin_email}\n` +
          `- 기본 모듈: 전자결재/마이페이지/직원관리는 활성, 회계관리/홈페이지 관리는 기본 비활성\n\n` +
          `다음 단계: 등록한 이메일로 ERP 메인에서 로그인 링크를 요청하면 Auth 계정이 연결됩니다.`;
        resultBox.classList.remove('hidden');
        setStatus('새 조합과 첫 ERP 관리자 등록이 완료되었습니다.', 'alert-success');
        resetCreateForm(false);
        resultBox.classList.remove('hidden');
        await loadCoopList();
      } catch (err) {
        console.error('submitCreateForm failed:', err);
        setStatus(`조합 생성 실패: ${err.message}`, 'alert-danger');
      } finally {
        setLoadingState('btnCreateCoop', false, '생성 중...');
      }
    }

    function openManageModal(coopId) {
      const row = coopRows.find((item) => String(item.coop_id) === String(coopId));
      selectedCoop = {
        coop_id: coopId,
        coop_name: row?.coop_name || '-',
        is_active: row?.is_active === true
      };
      document.getElementById('manageCoopTitle').textContent = selectedCoop.coop_name;
      document.getElementById('manageCoopMeta').textContent = `조합 ID: ${selectedCoop.coop_id}`;
      document.getElementById('manageCoopActiveToggle').checked = selectedCoop.is_active;
      document.getElementById('manageActiveLabel').textContent = selectedCoop.is_active ? '활성' : '중지';
      document.getElementById('manageModuleGrid').innerHTML = '<div class="empty-box">모듈 정보를 불러오는 중입니다.</div>';
      document.getElementById('manageAdminSelect').innerHTML = '<option>불러오는 중...</option>';
      setManageStatus('', '');
      if (!coopManageModal) coopManageModal = new bootstrap.Modal(document.getElementById('coopManageModal'));
      coopManageModal.show();
      loadManageModalData(false);
    }

    async function loadManageModalData(showNotice) {
      if (!selectedCoop || !selectedCoop.coop_id) return;
      if (showNotice) setManageStatus('설정 정보를 새로 불러왔습니다.', 'alert-secondary');
      try {
        const [moduleRes, adminRes] = await Promise.all([
          _supabase.rpc('platform_list_coop_modules', { p_coop_id: selectedCoop.coop_id }),
          _supabase.rpc('platform_list_coop_admin_candidates', { p_coop_id: selectedCoop.coop_id })
        ]);

        if (moduleRes.error) throw moduleRes.error;
        if (adminRes.error) throw adminRes.error;

        renderModuleGrid(Array.isArray(moduleRes.data) ? moduleRes.data : []);
        renderAdminCandidates(Array.isArray(adminRes.data) ? adminRes.data : []);
      } catch (err) {
        console.error('loadManageModalData failed:', err);
        setManageStatus(`조합 설정 조회 실패: ${err.message}`, 'alert-danger');
      }
    }

    function renderModuleGrid(list) {
      const grid = document.getElementById('manageModuleGrid');
      if (!Array.isArray(list) || list.length === 0) {
        grid.innerHTML = '<div class="empty-box">설정된 모듈이 없습니다.</div>';
        return;
      }
      grid.innerHTML = list.map((row) => `
        <label class="module-tile">
          <div class="d-flex justify-content-between align-items-start gap-2">
            <div>
              <div class="fw-bold">${escapeHtml(row.module_name || row.module_key)}</div>
              <div class="form-hint"><code>${escapeHtml(row.module_key)}</code></div>
            </div>
            <div class="form-check form-switch fs-5 mb-0">
              <input class="form-check-input module-toggle" type="checkbox" data-module-key="${escapeHtml(row.module_key)}" ${row.is_enabled ? 'checked' : ''}>
            </div>
          </div>
        </label>
      `).join('');
    }

    function renderAdminCandidates(list) {
      const select = document.getElementById('manageAdminSelect');
      if (!Array.isArray(list) || list.length === 0) {
        select.innerHTML = '<option value="">직원 없음</option>';
        return;
      }
      let preferredEmpId = '';
      list.forEach((row) => {
        if (!preferredEmpId && row.role === 'admin_all') preferredEmpId = row.emp_id;
      });
      if (!preferredEmpId) preferredEmpId = list[0].emp_id;
      select.innerHTML = list.map((row) => {
        const roleLabel = row.role || '-';
        const activeLabel = row.is_active ? '활성' : '비활성';
        const selected = row.emp_id === preferredEmpId ? 'selected' : '';
        return `<option value="${escapeHtml(row.emp_id)}" ${selected}>${escapeHtml(row.emp_name || row.email || row.emp_id)} / ${escapeHtml(roleLabel)} / ${escapeHtml(activeLabel)}</option>`;
      }).join('');
    }

    function applyStandardPreset() {
      document.querySelectorAll('.module-toggle').forEach((el) => {
        const key = String(el.dataset.moduleKey || '').trim();
        el.checked = key !== 'accounting' && key !== 'member';
      });
      setManageStatus('표준 모듈 프리셋을 적용했습니다. 저장 버튼을 눌러 확정하세요.', 'alert-secondary');
    }

    async function saveCoopActive() {
      if (!selectedCoop || !selectedCoop.coop_id) return;
      setManageStatus('', '');
      setLoadingState('btnSaveCoopActive', true, '저장 중...');
      try {
        const isActive = document.getElementById('manageCoopActiveToggle').checked;
        const { data, error } = await _supabase.rpc('platform_set_coop_active', {
          p_coop_id: selectedCoop.coop_id,
          p_is_active: isActive
        });
        if (error) throw error;
        selectedCoop.is_active = data.is_active === true;
        document.getElementById('manageActiveLabel').textContent = selectedCoop.is_active ? '활성' : '중지';
        setManageStatus(`조합 상태를 ${selectedCoop.is_active ? '활성' : '중지'}으로 저장했습니다.`, 'alert-success');
        await loadCoopList();
      } catch (err) {
        console.error('saveCoopActive failed:', err);
        setManageStatus(`조합 상태 저장 실패: ${err.message}`, 'alert-danger');
      } finally {
        setLoadingState('btnSaveCoopActive', false, '저장 중...');
      }
    }

    async function saveCoopModules() {
      if (!selectedCoop || !selectedCoop.coop_id) return;
      setManageStatus('', '');
      setLoadingState('btnSaveModules', true, '저장 중...');
      try {
        const payload = {};
        document.querySelectorAll('.module-toggle').forEach((el) => {
          payload[el.dataset.moduleKey] = el.checked;
        });
        const { data, error } = await _supabase.rpc('platform_save_coop_modules', {
          p_coop_id: selectedCoop.coop_id,
          p_modules: payload
        });
        if (error) throw error;
        setManageStatus(`모듈 설정을 저장했습니다. (${data.updated_count || 0}건)`, 'alert-success');
      } catch (err) {
        console.error('saveCoopModules failed:', err);
        setManageStatus(`모듈 저장 실패: ${err.message}`, 'alert-danger');
      } finally {
        setLoadingState('btnSaveModules', false, '저장 중...');
      }
    }

    async function savePrimaryAdmin() {
      if (!selectedCoop || !selectedCoop.coop_id) return;
      const targetEmpId = document.getElementById('manageAdminSelect').value;
      if (!targetEmpId) {
        setManageStatus('대표 관리자로 지정할 직원을 선택해주세요.', 'alert-danger');
        return;
      }
      setManageStatus('', '');
      setLoadingState('btnSavePrimaryAdmin', true, '저장 중...');
      try {
        const { data, error } = await _supabase.rpc('platform_assign_primary_admin', {
          p_coop_id: selectedCoop.coop_id,
          p_emp_id: targetEmpId
        });
        if (error) throw error;
        setManageStatus(`대표 관리자를 ${data.emp_name || data.email}로 변경했습니다.`, 'alert-success');
        await loadManageModalData(false);
        await loadCoopList();
      } catch (err) {
        console.error('savePrimaryAdmin failed:', err);
        setManageStatus(`대표 관리자 저장 실패: ${err.message}`, 'alert-danger');
      } finally {
        setLoadingState('btnSavePrimaryAdmin', false, '저장 중...');
      }
    }

    async function ensureSession() {
      const { data, error } = await _supabase.auth.getUser();
      if (error) throw error;
      if (!data?.user) {
        window.location.href = 'index.html';
        return false;
      }
      currentUser = data.user;
      fillCurrentUser();
      return true;
    }

    async function initPage() {
      setStatus('', '');
      try {
        const hasSession = await ensureSession();
        if (!hasSession) return;
        await loadPlatformContext();
        if (!platformContext || platformContext.is_platform_admin !== true) {
          setStatus('통합 관리자 권한이 없습니다. ERP 홈으로 이동합니다.', 'alert-danger');
          setTimeout(function() {
            window.location.href = 'index.html';
          }, 1200);
          return;
        }
        if (platformContext.bootstrap_mode === true && platformContext.claimed_by_me !== true) return;
        await loadCoopList();
      } catch (err) {
        console.error('initPage failed:', err);
        setStatus(`통합 관리자 화면 초기화 실패: ${err.message}`, 'alert-danger');
      }
    }

    document.addEventListener('DOMContentLoaded', function() {
      const modalEl = document.getElementById('coopManageModal');
      if (modalEl) coopManageModal = new bootstrap.Modal(modalEl);
      const coopNameInput = document.getElementById('coopNameInput');
      const coopCodeInput = document.getElementById('coopCodeInput');
      if (coopNameInput) coopNameInput.addEventListener('input', handleCoopNameInput);
      if (coopCodeInput) {
        coopCodeInput.addEventListener('input', handleCoopCodeInput);
        coopCodeInput.addEventListener('blur', function() {
          if (!String(coopCodeInput.value || '').trim()) {
            coopCodeManuallyEdited = false;
            syncCoopCodeFromName();
          }
        });
      }
      syncCoopCodeFromName();
      const activeToggle = document.getElementById('manageCoopActiveToggle');
      if (activeToggle) {
        activeToggle.addEventListener('change', function() {
          document.getElementById('manageActiveLabel').textContent = activeToggle.checked ? '활성' : '중지';
        });
      }
      initPage();
    });
  </script>
</body>
</html>
