{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "home",
  "main": "worker.js",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/signup", "/signup.html"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 0.01
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
