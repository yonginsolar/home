{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hwaseong-public-monitor",
  "main": "hcrec_monitor_worker.js",
  "compatibility_date": "2026-09-11",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "routes": [{ "pattern": "monitor.hcrec.kr", "custom_domain": true }],
  "observability": { "enabled": true, "logs": { "head_sampling_rate": 0.01 } }
}
