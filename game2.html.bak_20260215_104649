<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>일렉트릭 러시 (The Bill)</title>
    <link href="https://fonts.googleapis.com/css2?family=Black+Han+Sans&family=Courier+Prime:wght@700&display=swap" rel="stylesheet">
    <style>
        body {
            margin: 0; padding: 0;
            background-color: #2c3e50;
            overflow: hidden;
            font-family: 'Black Han Sans', sans-serif;
            touch-action: none; 
            display: flex; justify-content: center; align-items: center;
            height: 100vh;
        }
        canvas {
            display: block;
            box-shadow: 0 0 50px rgba(0,0,0,0.5);
            max-width: 500px; width: 100%; height: 100%;
        }
        
        /* 터치 영역 */
        .touch-zone {
            position: absolute; top: 0; bottom: 0; width: 50%;
            z-index: 10; cursor: pointer;
            -webkit-tap-highlight-color: transparent;
        }
        #leftZone { left: 0; }
        #rightZone { right: 0; }

        /* UI 레이어 */
        #ui-layer {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            z-index: 20; 
        }

        /* 인게임 점수판 (디지털 시계 느낌) */
        .score-board {
            position: absolute; top: 24px; right: 20px;
            font-size: clamp(22px, 4.5vw, 32px);
            color: #0f0; /* 해커 느낌 형광 녹색 */
            text-shadow: 0 0 10px #0f0;
            font-family: 'Courier Prime', monospace;
            background: rgba(0,0,0,0.7);
            padding: 8px 16px; border: 2px solid #0f0;
            border-radius: 5px;
        }

        /* 시작 화면 */
        #startScreen {
            background: linear-gradient(135deg, #f1c40f, #e67e22);
            padding: 40px; border-radius: 20px;
            text-align: center; pointer-events: auto;
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
            width: 80%; max-width: 320px;
            border: 5px solid #fff;
        }

        /* 영수증 스타일 엔딩 화면 (핵심) */
        #receiptModal {
            display: none;
            background: #fff;
            padding: 30px 20px; 
            width: 80%; max-width: 320px;
            pointer-events: auto;
            font-family: 'Courier Prime', monospace; /* 영수증 폰트 */
            color: #333;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            position: relative;
            transform: rotate(-1deg); /* 살짝 비틀어서 종이 느낌 */
            animation: printReceipt 0.5s ease-out;
        }

        /* 프린터 출력(찌지직) 스캔라인 오버레이 */
        .print-scan {
            display: none;
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: repeating-linear-gradient(
                to bottom,
                rgba(0,0,0,0.06) 0px,
                rgba(0,0,0,0.06) 1px,
                transparent 1px,
                transparent 4px
            );
            mix-blend-mode: multiply;
            opacity: 0;
        }

        #receiptModal.printing .print-scan {
            display: block;
            opacity: 0.26;
            animation: scanlines 0.7s linear infinite;
        }

        @keyframes scanlines {
            from { transform: translateY(-18px); }
            to { transform: translateY(18px); }
        }

        /* 영수증 톱니 모양 (위/아래) */
        #receiptModal::before {
            content: ""; position: absolute; top: -10px; left: 0; width: 100%; height: 10px;
            background: linear-gradient(45deg, transparent 33.333%, #fff 33.333%, #fff 66.667%, transparent 66.667%), 
                        linear-gradient(-45deg, transparent 33.333%, #fff 33.333%, #fff 66.667%, transparent 66.667%);
            background-size: 20px 40px;
        }
        #receiptModal::after {
            content: ""; position: absolute; bottom: -10px; left: 0; width: 100%; height: 10px;
            background: linear-gradient(45deg, transparent 33.333%, #fff 33.333%, #fff 66.667%, transparent 66.667%), 
                        linear-gradient(-45deg, transparent 33.333%, #fff 33.333%, #fff 66.667%, transparent 66.667%);
            background-size: 20px 40px; transform: rotate(180deg);
        }

        @keyframes printReceipt {
            from { transform: translateY(-50px) rotate(0deg); opacity: 0; }
            to { transform: translateY(0) rotate(-1deg); opacity: 1; }
        }

        /* 영수증 내용 */
        .receipt-header { text-align: center; border-bottom: 2px dashed #000; padding-bottom: 15px; margin-bottom: 15px; }
        .receipt-row { display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 14px; }
        .receipt-total { border-top: 2px dashed #000; margin-top: 15px; padding-top: 15px; font-weight: bold; font-size: 18px; display: flex; justify-content: space-between; }
        .receipt-footer { text-align: center; margin-top: 20px; font-size: 12px; color: #555; }
        .stamp { 
            position: absolute; bottom: 80px; right: 20px; 
            border: 3px solid #c0392b; color: #c0392b; 
            padding: 5px 10px; font-size: 20px; font-weight: bold; 
            transform: rotate(-15deg); opacity: 0;
            animation: stamp 0.3s 1s forwards; /* 1초 뒤에 찍힘 */
        }

        @keyframes stamp {
            from { transform: scale(2) rotate(-15deg); opacity: 0; }
            to { transform: scale(1) rotate(-15deg); opacity: 0.8; }
        }

        button {
            background: #333; color: #fff; border: none;
            padding: 15px 0; width: 100%; font-size: 18px;
            margin-top: 20px; cursor: pointer;
            font-family: 'Black Han Sans', sans-serif;
        }

        .guide-text { position: absolute; bottom: 30px; color: rgba(255,255,255,0.3); font-size: 14px; }
        
        /* 플로팅 텍스트 (+500W 효과) */
        .floating-text {
            position: absolute; color: #fff; font-weight: bold;
            font-size: 26px; pointer-events: none;
            transform: translate(-50%, -50%);
            text-shadow: 0 2px 0 rgba(0,0,0,0.6), 0 0 10px rgba(241,196,15,0.9);
            background: rgba(0,0,0,0.35);
            border: 1px solid rgba(255,255,255,0.18);
            padding: 4px 10px;
            border-radius: 999px;
            will-change: transform, opacity;
            animation: floatUp 1s forwards;
        }
        @keyframes floatUp {
            from { transform: translate(-50%, -50%); opacity: 1; }
            to { transform: translate(-50%, -110px); opacity: 0; }
        }

    </style>
</head>
<body>

    <div id="leftZone" class="touch-zone" onpointerdown="movePlayer(-1)"></div>
    <div id="rightZone" class="touch-zone" onpointerdown="movePlayer(1)"></div>

    <canvas id="gameCanvas"></canvas>

    <div id="ui-layer">
        <div class="score-board">⚡ <span id="scoreVal">0</span> W</div>
        
        <div id="startScreen">
            <h1 style="margin:0; font-size: 36px; color:#fff; text-shadow: 2px 2px 0 #333;">ELECTRIC<br>RUSH</h1>
            <p style="color:#fff; font-size: 18px; margin: 20px 0;">
                📱💻🎮🌀 전자제품을 모아<br>
                에너지를 충전하세요!
            </p>
            <button style="background:#fff; color:#e67e22; border-radius:50px; font-size:24px;" onclick="startGame()">START</button>
        </div>

        <div id="receiptModal">
            <div class="receipt-header">
                <h2 style="margin:0;">전기요금 청구서</h2>
                <div style="font-size:12px; margin-top:5px;">2026년 2월분</div>
            </div>

            <div class="receipt-row" style="font-weight:bold;">
                <span>사용 전력량</span>
                <span id="powerUsed">0 W</span>
            </div>
            <div class="receipt-row">
                <span>배출한 탄소</span>
                <span id="carbonKg">0 kg</span>
            </div>
            <div class="receipt-row" style="color:#c0392b;">
                <span>사라진 나무</span>
                <span id="treeCountRow">0 그루</span>
            </div>
            <div style="border-top:2px dashed #000; margin: 12px 0;"></div>
            
            <div class="receipt-row">
                <span>기본 요금</span>
                <span>1,000 원</span>
            </div>
            <div class="receipt-row">
                <span>전력량 요금</span>
                <span id="powerCost">0 원</span>
            </div>
            <div class="receipt-row" style="color:#c0392b;">
                <span>기후환경 요금</span>
                <span id="climateCost">0 원</span>
            </div>

            <div class="receipt-total">
                <span>청구 금액</span>
                <span id="totalCost">0 원</span>
            </div>

            <div class="stamp">납부 요망</div>

            <div class="receipt-footer">
                <p style="margin:0; font-weight:bold;">당신이 모은 '점수(W)'는 사실 사용 전력량입니다.</p>
                <hr style="border:0; border-top:1px solid #ddd; margin:15px 0;">
                <p style="color:#27ae60; font-weight:bold;">💡 태양광을 설치했다면<br>이 요금은 0원이 됩니다.</p>
            </div>

            <button onclick="startGame()">다시 시도하기</button>

            <div class="print-scan" aria-hidden="true"></div>
        </div>

        <div class="guide-text">LEFT &nbsp;&nbsp;|&nbsp;&nbsp; RIGHT</div>
    </div>

<script>
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const uiLayer = document.getElementById('ui-layer');
    const startScreen = document.getElementById('startScreen');
    const receiptModal = document.getElementById('receiptModal');

    const MAX_CANVAS_WIDTH = 500;
    const MAX_DPR = 2; // Cap DPR for perf (mobile can be 3+)
    const HAS_CTX = !!ctx;
    let viewW = 0; // CSS pixels (game coord system)
    let viewH = 0; // CSS pixels (game coord system)
    let dpr = 1;

    if (!HAS_CTX) {
        // Graceful fallback: keep UI responsive, but disable gameplay.
        document.getElementById('leftZone').style.display = 'none';
        document.getElementById('rightZone').style.display = 'none';
        canvas.style.display = 'none';

        startScreen.innerHTML = `
            <h1 style="margin:0; font-size: 28px; color:#fff; text-shadow: 2px 2px 0 #333;">지원되지 않는 환경</h1>
            <p style="color:#fff; font-size: 16px; margin: 20px 0;">
                이 브라우저는 Canvas 2D를 지원하지 않아 게임을 실행할 수 없습니다.
            </p>
        `;
    }
    
	    let animationId;
	    let isPlaying = false;
	    let score = 0; // Watt (와트)
	    const BASE_SPEED = 7; // px per 60fps frame (game units)
	    const MAX_SPEED = 20;
	    const SPEED_STEP_SCORE = 10000; // every 10,000W...
	    const SPEED_STEP_MULT = 0.5; // ...becomes +50% faster
	    const BACKGROUND_SCORE_FULL = 40000; // fully concrete by this score (tweakable)

	    let speed = BASE_SPEED;
	    let frame = 0;
	    let laneWidth = 0;
	    let lanes = [0, 0, 0]; 
	    let lastTs = 0;
	    let spawnMs = 0;
	    let runMs = 0;
	    let travelPx = 0;
	    let flash = 0; // 0..1 overlay intensity
	    let flashColor = '#f1c40f';
	    let receiptTimers = [];
	    let receiptPrintId = 0;
	    let lastBodyBg = '';
	    let naturePattern = null;
	    let concretePattern = null;

    // 아이템 정의 (가전제품)
    // type: good (점수+), bad (게임오버)
    const ITEMS = [
        { name: '휴대폰', icon: '📱', watts: 500, type: 'good' },
        { name: '노트북', icon: '💻', watts: 1200, type: 'good' },
        { name: '게임기', icon: '🎮', watts: 1500, type: 'good' },
        { name: '에어컨', icon: '🌀', watts: 2000, type: 'good' },
        { name: '과부하', icon: '⚡', watts: 0, type: 'bad' }
    ];
    const GOOD_ITEMS = ITEMS.filter(i => i.type === 'good');
    const BAD_ITEMS = ITEMS.filter(i => i.type === 'bad');
    const EMIT_KG_CO2_PER_W = 0.00048; // 50,000W -> 24.0kg (story-driven)
    const KG_CO2_PER_TREE = 8; // 24.0kg -> 3.0 trees (story-driven)

    function roundRectPath(c, x, y, w, h, r) {
        const radius = Math.max(0, Math.min(r, w / 2, h / 2));
        c.moveTo(x + radius, y);
        c.arcTo(x + w, y, x + w, y + h, radius);
        c.arcTo(x + w, y + h, x, y + h, radius);
        c.arcTo(x, y + h, x, y, radius);
        c.arcTo(x, y, x + w, y, radius);
        c.closePath();
    }

    function canvasToClient(x, y) {
        const rect = canvas.getBoundingClientRect();
        const sx = viewW ? rect.width / viewW : 1;
        const sy = viewH ? rect.height / viewH : 1;
        return { x: rect.left + x * sx, y: rect.top + y * sy };
    }

    function clamp01(v) {
        return Math.max(0, Math.min(1, v));
    }

    function lerp(a, b, t) {
        return a + (b - a) * t;
    }

	    function lerpRgb(a, b, t) {
	        return [
	            Math.round(lerp(a[0], b[0], t)),
	            Math.round(lerp(a[1], b[1], t)),
	            Math.round(lerp(a[2], b[2], t))
	        ];
	    }

	    function ensureBackgroundPatterns() {
	        if (!HAS_CTX) return;
	        if (naturePattern && concretePattern) return;

	        const size = 384;

	        // Nature texture tile (grass + trees silhouette)
	        const nature = document.createElement('canvas');
	        nature.width = size;
	        nature.height = size;
	        const ng = nature.getContext('2d');

	        const nbg = ng.createLinearGradient(0, 0, 0, size);
	        nbg.addColorStop(0, '#0b7a3a');
	        nbg.addColorStop(1, '#063b1c');
	        ng.fillStyle = nbg;
	        ng.fillRect(0, 0, size, size);

	        // Grass noise
	        for (let i = 0; i < 4200; i++) {
	            const x = Math.random() * size;
	            const y = Math.random() * size;
	            const a = 0.05 + Math.random() * 0.08;
	            const g = 110 + Math.floor(Math.random() * 80);
	            ng.fillStyle = `rgba(0, ${g}, 0, ${a})`;
	            ng.fillRect(x, y, 2, 2);
	        }

	        // A few tree silhouettes
	        ng.fillStyle = 'rgba(0,0,0,0.16)';
	        for (let i = 0; i < 14; i++) {
	            const x = Math.random() * size;
	            const baseY = size * (0.55 + Math.random() * 0.35);
	            const trunkW = 6 + Math.random() * 10;
	            const trunkH = 60 + Math.random() * 110;
	            ng.fillRect(x - trunkW / 2, baseY - trunkH, trunkW, trunkH);
	            ng.beginPath();
	            ng.arc(x, baseY - trunkH, 26 + Math.random() * 24, 0, Math.PI * 2);
	            ng.fill();
	        }

	        naturePattern = ctx.createPattern(nature, 'repeat');

	        // Concrete texture tile (noise + cracks)
	        const conc = document.createElement('canvas');
	        conc.width = size;
	        conc.height = size;
	        const cg = conc.getContext('2d');

	        cg.fillStyle = '#7a7a7a';
	        cg.fillRect(0, 0, size, size);

	        for (let i = 0; i < 9000; i++) {
	            const x = Math.random() * size;
	            const y = Math.random() * size;
	            const v = 90 + Math.floor(Math.random() * 90);
	            const a = 0.03 + Math.random() * 0.08;
	            cg.fillStyle = `rgba(${v}, ${v}, ${v}, ${a})`;
	            cg.fillRect(x, y, 2, 2);
	        }

	        // cracks
	        cg.strokeStyle = 'rgba(0,0,0,0.18)';
	        cg.lineWidth = 1;
	        for (let i = 0; i < 18; i++) {
	            cg.beginPath();
	            let x = Math.random() * size;
	            let y = Math.random() * size;
	            cg.moveTo(x, y);
	            const segs = 6 + Math.floor(Math.random() * 10);
	            for (let s = 0; s < segs; s++) {
	                x += (Math.random() - 0.5) * 90;
	                y += (Math.random() - 0.5) * 90;
	                cg.lineTo(x, y);
	            }
	            cg.stroke();
	        }

	        // stains
	        for (let i = 0; i < 40; i++) {
	            const x = Math.random() * size;
	            const y = Math.random() * size;
	            const r = 10 + Math.random() * 28;
	            cg.fillStyle = 'rgba(0,0,0,0.06)';
	            cg.beginPath();
	            cg.arc(x, y, r, 0, Math.PI * 2);
	            cg.fill();
	        }

	        concretePattern = ctx.createPattern(conc, 'repeat');
	    }

    function cancelReceiptPrinting() {
        receiptPrintId++;
        for (const t of receiptTimers) {
            clearTimeout(t.id);
            // Resolve any pending sleeps so the async chain can unwind.
            try { t.resolve(); } catch (_) {}
        }
        receiptTimers = [];
        receiptModal.classList.remove('printing');
    }

    function scrambleDigits(finalText) {
        let out = '';
        for (let i = 0; i < finalText.length; i++) {
            const ch = finalText[i];
            if (ch >= '0' && ch <= '9') out += String(Math.floor(Math.random() * 10));
            else out += ch;
        }
        return out;
    }

    function glitchPrint(el, finalText, myPrintId, durationMs = 260) {
        return new Promise((resolve) => {
            if (!el) return resolve();
            const start = performance.now();
            const tick = (now) => {
                if (myPrintId !== receiptPrintId) return resolve();
                const t = (now - start) / durationMs;
                if (t >= 1) {
                    el.textContent = finalText;
                    return resolve();
                }
                el.textContent = scrambleDigits(finalText);
                requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
        });
    }

    async function printReceipt(data) {
        const myPrintId = ++receiptPrintId;
        receiptModal.classList.add('printing');

        const powerUsedEl = document.getElementById('powerUsed');
        const carbonKgEl = document.getElementById('carbonKg');
        const treeCountRowEl = document.getElementById('treeCountRow');
        const powerCostEl = document.getElementById('powerCost');
        const climateCostEl = document.getElementById('climateCost');
        const totalCostEl = document.getElementById('totalCost');

        // Clear first (so it feels like printing)
        powerUsedEl.textContent = '';
        carbonKgEl.textContent = '';
        treeCountRowEl.textContent = '';
        powerCostEl.textContent = '';
        climateCostEl.textContent = '';
        totalCostEl.textContent = '';

        const sleep = (ms) => new Promise((resolve) => {
            const id = setTimeout(resolve, ms);
            receiptTimers.push({ id, resolve });
        });

        await sleep(120);
        await glitchPrint(powerUsedEl, data.powerUsedText, myPrintId);
        await sleep(140);
        await glitchPrint(carbonKgEl, data.carbonKgText, myPrintId);
        await sleep(140);
        await glitchPrint(treeCountRowEl, data.treeCountText, myPrintId);
        await sleep(160);
        await glitchPrint(powerCostEl, data.powerCostText, myPrintId);
        await sleep(120);
        await glitchPrint(climateCostEl, data.climateCostText, myPrintId);
        await sleep(120);
        await glitchPrint(totalCostEl, data.totalCostText, myPrintId);

        await sleep(350);
        if (myPrintId === receiptPrintId) receiptModal.classList.remove('printing');
    }

    // 플레이어 (플러그 모양)
    const player = {
        lane: 1, 
        y: 0, radius: 25,
        x: 0, 
        
        update() {
            let targetX = lanes[this.lane];
            this.x += (targetX - this.x) * 0.2; 
            
            // 플러그 몸통
            ctx.save();
            ctx.translate(this.x, this.y);
            
            // 그림자
            ctx.fillStyle = 'rgba(0,0,0,0.3)';
            ctx.beginPath(); ctx.ellipse(0, 30, 20, 10, 0, 0, Math.PI*2); ctx.fill();

            // 몸체
            ctx.fillStyle = '#fff';
            ctx.beginPath();
            if (typeof ctx.roundRect === 'function') {
                ctx.roundRect(-20, -20, 40, 40, 10);
            } else {
                roundRectPath(ctx, -20, -20, 40, 40, 10);
            }
            ctx.fill();
            
            // 돼지코 (핀)
            ctx.fillStyle = '#bdc3c7';
            ctx.fillRect(-12, -35, 8, 15);
            ctx.fillRect(4, -35, 8, 15);

            // 얼굴 (탐욕스러운 표정)
            ctx.fillStyle = '#333';
            ctx.beginPath(); ctx.arc(-10, -5, 3, 0, Math.PI*2); ctx.fill(); // 눈
            ctx.beginPath(); ctx.arc(10, -5, 3, 0, Math.PI*2); ctx.fill(); // 눈
            ctx.beginPath(); // 입 (웃음)
            ctx.arc(0, 5, 10, 0, Math.PI);
            ctx.stroke();

            // 전기 스파크 효과
            if(frame % 10 < 5) {
                ctx.strokeStyle = '#f1c40f';
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.moveTo(25, -10); ctx.lineTo(35, 0); ctx.lineTo(25, 10);
                ctx.stroke();
                ctx.beginPath();
                ctx.moveTo(-25, -10); ctx.lineTo(-35, 0); ctx.lineTo(-25, 10);
                ctx.stroke();
            }

            ctx.restore();
        }
    };

    let obstacles = [];
    class Obstacle {
        constructor() {
            this.lane = Math.floor(Math.random() * 3);
            this.x = lanes[this.lane];
            this.y = -100;
            this.width = laneWidth * 0.5;

            // 과부하(게임오버)는 가끔 나오게
            if (Math.random() > 0.86 && BAD_ITEMS.length) {
                this.item = BAD_ITEMS[Math.floor(Math.random() * BAD_ITEMS.length)];
            } else {
                this.item = GOOD_ITEMS[Math.floor(Math.random() * GOOD_ITEMS.length)];
            }
        }

        update(dt60) {
            this.y += speed * dt60;
        }

        draw() {
            ctx.font = '40px Arial';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            
            // 아이템 배경 (후광)
            if(this.item.type === 'good') {
                ctx.shadowBlur = 15;
                ctx.shadowColor = '#f1c40f';
            } else {
                ctx.shadowBlur = 15;
                ctx.shadowColor = '#e74c3c';
            }
            
            ctx.fillText(this.item.icon, this.x, this.y);
            ctx.shadowBlur = 0; // 초기화

            // 와트 표시 (유혹)
            if(this.item.type === 'good') {
                ctx.fillStyle = '#fff';
                ctx.font = "18px 'Courier Prime', monospace";
                ctx.lineWidth = 4;
                ctx.strokeStyle = 'rgba(0,0,0,0.8)';
                ctx.strokeText(`+${this.item.watts}W`, this.x, this.y + 34);
                ctx.fillText(`+${this.item.watts}W`, this.x, this.y + 34);
            }
        }
    }

    // --- Core Logic ---

    function resize() {
        viewW = Math.min(window.innerWidth, MAX_CANVAS_WIDTH);
        viewH = window.innerHeight;

        canvas.style.width = viewW + 'px';
        canvas.style.height = viewH + 'px';

        if (!HAS_CTX) return;

        dpr = Math.min(window.devicePixelRatio || 1, MAX_DPR);
        canvas.width = Math.floor(viewW * dpr);
        canvas.height = Math.floor(viewH * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0); // draw in CSS pixels

        laneWidth = viewW / 3;
        lanes[0] = laneWidth * 0.5;
        lanes[1] = laneWidth * 1.5;
        lanes[2] = laneWidth * 2.5;
        player.y = viewH - 150; 
        if(!isPlaying) player.x = lanes[1];
    }

    function movePlayer(dir) {
        if (!isPlaying) return;
        let nextLane = player.lane + dir;
        if (nextLane >= 0 && nextLane <= 2) player.lane = nextLane;
    }

    function spawnObstacle(dtMs) {
        const gapFrames = Math.max(30, 80 - Math.floor(score/10000));
        const gapMs = gapFrames * (1000 / 60);
        spawnMs += dtMs;
        while (spawnMs >= gapMs) {
            spawnMs -= gapMs;
            obstacles.push(new Obstacle());
        }
    }

    function checkCollision(p, o) {
        let dx = p.x - o.x;
        let dy = p.y - o.y;
        let dist = Math.sqrt(dx*dx + dy*dy);
        return dist < 40; // 충돌 범위
    }

    // +500W 같은 텍스트 띄우기
    function showFloatingText(text, x, y) {
        const el = document.createElement('div');
        el.className = 'floating-text';
        el.innerText = text;
        el.style.left = x + 'px';
        el.style.top = y + 'px';
        uiLayer.appendChild(el);
        setTimeout(() => el.remove(), 1000);
    }

	    function drawBackground() {
	        // Background morph: nature -> concrete (based on score progress)
	        const t = clamp01(score / BACKGROUND_SCORE_FULL);
	        const top = lerpRgb([12, 122, 66], [60, 60, 60], t);
	        const bot = lerpRgb([4, 60, 28], [10, 10, 10], t);

	        const bg = ctx.createLinearGradient(0, 0, 0, viewH);
	        bg.addColorStop(0, `rgb(${top[0]}, ${top[1]}, ${top[2]})`);
	        bg.addColorStop(1, `rgb(${bot[0]}, ${bot[1]}, ${bot[2]})`);
	        ctx.fillStyle = bg;
	        ctx.fillRect(0, 0, viewW, viewH);

	        ensureBackgroundPatterns();
	        if (naturePattern) {
	            ctx.save();
	            ctx.globalAlpha = 0.85 * (1 - t);
	            ctx.fillStyle = naturePattern;
	            ctx.fillRect(0, 0, viewW, viewH);
	            ctx.restore();
	        }
	        if (concretePattern) {
	            ctx.save();
	            ctx.globalAlpha = 0.9 * t;
	            ctx.fillStyle = concretePattern;
	            ctx.fillRect(0, 0, viewW, viewH);
	            ctx.restore();
	        }

	        // Match page background (visible on desktop side margins) to the darkening tone.
	        const bodyBg = `rgb(${bot[0]}, ${bot[1]}, ${bot[2]})`;
	        if (bodyBg !== lastBodyBg) {
	            document.body.style.backgroundColor = bodyBg;
	            lastBodyBg = bodyBg;
	        }
	        
	        // 그리드 라인 이동 효과
	        let gridOffset = travelPx % 50;
	        const gridAlpha = lerp(0.22, 0.06, t);
	        ctx.strokeStyle = `rgba(46, 204, 113, ${gridAlpha})`; // 회로판 녹색
	        ctx.lineWidth = 1;
        
        // 가로선
        for(let i=0; i<viewH/50 + 1; i++) {
            let y = i * 50 + gridOffset - 50;
            ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(viewW, y); ctx.stroke();
        }
        
        // 세로선 (원근감)
        ctx.beginPath(); ctx.moveTo(laneWidth, 0); ctx.lineTo(laneWidth, viewH); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(laneWidth*2, 0); ctx.lineTo(laneWidth*2, viewH); ctx.stroke();
    }

    function animate(ts) {
        if (!isPlaying) return;

        if (!lastTs) lastTs = ts;
        const dtMsRaw = ts - lastTs;
        lastTs = ts;
	        const dtMs = Math.max(0, Math.min(40, dtMsRaw)); // cap for tab-switch
	        const dt60 = dtMs * 60 / 1000;

	        runMs += dtMs;
	        const steps = Math.floor(score / SPEED_STEP_SCORE);
	        const mult = 1 + steps * SPEED_STEP_MULT;
	        const targetSpeed = Math.min(MAX_SPEED, BASE_SPEED * mult);
	        speed = lerp(speed, targetSpeed, clamp01(dtMs / 250));

        ctx.clearRect(0, 0, viewW, viewH);
        drawBackground();
        player.update();
        spawnObstacle(dtMs);

        for (let i = obstacles.length - 1; i >= 0; i--) {
            let obs = obstacles[i];
            obs.update(dt60);
            obs.draw();

            if (checkCollision(player, obs)) {
                // 아이템 획득 로직
                if (obs.item.type === 'good') {
                    score += obs.item.watts;
                    document.getElementById('scoreVal').innerText = score.toLocaleString();

                    // Satisfying flash feedback
                    flash = Math.min(0.5, flash + 0.35);
                    flashColor = '#f1c40f';
                    
                    // 캔버스 좌표를 화면 좌표로 변환하여 텍스트 띄우기
                    const pos = canvasToClient(obs.x, obs.y);
                    showFloatingText(`+${obs.item.watts}W`, pos.x, pos.y);
                    
                    obstacles.splice(i, 1);
                } else {
                    // 나쁜 아이템(과부하) 충돌 -> 게임 오버
                    flash = 0.55;
                    flashColor = '#e74c3c';
                    gameOver();
                    return;
                }
            } else if (obs.y > viewH + 50) {
                obstacles.splice(i, 1);
            }
        }
        
        // Visual timers
        travelPx += speed * dt60;
        frame += dt60;
        if (flash > 0) flash = Math.max(0, flash - dtMs / 160);
        if (flash > 0) {
            ctx.save();
            ctx.globalAlpha = flash;
            ctx.fillStyle = flashColor;
            ctx.fillRect(0, 0, viewW, viewH);
            ctx.restore();
        }

        animationId = requestAnimationFrame(animate);
    }

    window.startGame = function() {
        if (!HAS_CTX) return;
        if (isPlaying) return;
        if (animationId) cancelAnimationFrame(animationId);

        cancelReceiptPrinting();
        startScreen.style.display = 'none';
        receiptModal.style.display = 'none';
        
        isPlaying = true;
        score = 0;
        speed = BASE_SPEED;
        frame = 0;
        obstacles = [];
        player.lane = 1;
        lastTs = 0;
        spawnMs = 0;
        runMs = 0;
        travelPx = 0;
        flash = 0;
        
        document.getElementById('scoreVal').innerText = '0';
        resize();
        player.x = lanes[1];
        // Spawn one item immediately so it doesn't feel "stuck" at the start.
        obstacles.push(new Obstacle());
        animationId = requestAnimationFrame(animate);
    };

    function gameOver() {
        isPlaying = false;
        cancelAnimationFrame(animationId);
        
        // 영수증 계산 로직
        const usedW = score;
        const carbonKg = Math.max(0, usedW * EMIT_KG_CO2_PER_W);
        const trees = Math.max(0, carbonKg / KG_CO2_PER_TREE);

        // 1. 전력량 요금 (가상의 계산: 1W당 0.2원)
        let powerPrice = Math.floor(score * 0.2);
        // 2. 기후환경 요금 (누진세 적용 느낌: 점수의 10%)
        let climatePrice = Math.floor(score * 0.1);
        // 3. 총액
        let total = 1000 + powerPrice + climatePrice;

        receiptModal.style.display = 'block';
        printReceipt({
            powerUsedText: usedW.toLocaleString() + " W",
            carbonKgText: carbonKg.toFixed(1) + " kg",
            treeCountText: trees.toFixed(1) + " 그루",
            powerCostText: powerPrice.toLocaleString() + " 원",
            climateCostText: climatePrice.toLocaleString() + " 원",
            totalCostText: total.toLocaleString() + " 원"
        });
    }

    window.addEventListener('resize', resize);
    resize();

</script>
